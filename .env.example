# Local dev: user-secrets and HTTPS dev certs mounts for docker-compose.
# Copy this file to .env (git-ignored) and uncomment the pair that matches
# your operating system.

# --- Windows ---
# KNOCKBOX_USER_SECRETS_DIR=${APPDATA}/Microsoft/UserSecrets
# KNOCKBOX_HTTPS_DIR=${APPDATA}/ASP.NET/Https

# --- Linux / macOS ---
# KNOCKBOX_USER_SECRETS_DIR=${HOME}/.microsoft/usersecrets
# KNOCKBOX_HTTPS_DIR=${HOME}/.aspnet/https
