@namespace KnockBox.Core.Client.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@*
    WASM-safe countdown clock. Mirrors the server's KnockBox.Core CountdownClock, but
    lives in KnockBox.Core.Client so runtime-loaded game UIs (which may not reference
    KnockBox.Core — KB1005) can render a phase countdown. The server projects a deadline
    timestamp into the view DTO; this component counts it down in the browser.

    Reuses the existing ES module served from the Core plugin's mounted wwwroot
    (_content/KnockBox.Core/js/countdownClock.js) — no new JS needed.
*@

@ChildContent(new CountdownState(Fraction, RemainingSeconds, DurationSeconds))

@code {
    /// <summary>Render fragment receiving the current <see cref="CountdownState"/>.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<CountdownState> ChildContent { get; set; } = default!;

    /// <summary>UTC time when the countdown expires.</summary>
    [Parameter, EditorRequired]
    public DateTimeOffset EndTimeUtc { get; set; }

    /// <summary>Total countdown duration (for the fraction used by styling).</summary>
    [Parameter, EditorRequired]
    public TimeSpan Duration { get; set; }

    private readonly string _clockId = $"cc-{Guid.NewGuid():N}";
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<CountdownClock>? _dotNetRef;
    private DateTimeOffset _lastEndTimeUtc;
    private bool _needsRestart;
    private bool _disposed;

    private float Fraction { get; set; } = 1f;
    private float RemainingSeconds { get; set; }
    private float DurationSeconds { get; set; }

    protected override void OnInitialized()
    {
        DurationSeconds = (float)Duration.TotalSeconds;
        RemainingSeconds = DurationSeconds;
        _lastEndTimeUtc = EndTimeUtc;
    }

    protected override void OnParametersSet()
    {
        // Restart only when the deadline shifts meaningfully (>100ms) — e.g. a phase
        // change — so a steady stream of projections doesn't reset the visual every frame.
        var timeChanged = Math.Abs((EndTimeUtc - _lastEndTimeUtc).TotalMilliseconds) > 100;

        if (timeChanged)
        {
            _lastEndTimeUtc = EndTimeUtc;
            _needsRestart = true;
            DurationSeconds = (float)Duration.TotalSeconds;
            RemainingSeconds = (float)Math.Max(0, (EndTimeUtc - DateTimeOffset.UtcNow).TotalSeconds);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _needsRestart)
        {
            _needsRestart = false;

            if (firstRender)
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/KnockBox.Core/js/countdownClock.js");
            }

            if (_jsModule is not null)
            {
                await _jsModule.InvokeVoidAsync("start",
                    _clockId,
                    _dotNetRef,
                    Math.Max(0, (EndTimeUtc - DateTimeOffset.UtcNow).TotalMilliseconds),
                    Duration.TotalMilliseconds);
            }
        }
    }

    [JSInvokable]
    public void OnCountdownTick(float fraction, float remainingSeconds, float durationSeconds)
    {
        if (_disposed) return;

        Fraction = fraction;
        RemainingSeconds = remainingSeconds;
        DurationSeconds = durationSeconds;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("stop", _clockId);
                await _jsModule.DisposeAsync();
            }
            catch (Exception) { }
        }
        _dotNetRef?.Dispose();
    }

    /// <summary>Snapshot of the countdown state passed to the child render fragment.</summary>
    public readonly record struct CountdownState(float Fraction, float RemainingSeconds, float DurationSeconds);
}
