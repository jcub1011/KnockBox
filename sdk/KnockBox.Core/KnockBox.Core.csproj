<!--
  KnockBox.Core — contract package for KnockBox game plugins.

  This is the only KnockBox package a plugin project should reference. It
  contains the IGameModule / AbstractGameEngine / AbstractGameState contracts,
  Razor component bases, result types, and other primitives shared across
  every plugin and the host.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>KnockBox.Core</PackageId>
    <Authors>jcub1011</Authors>
    <Description>Core abstractions and plugin system for KnockBox party game host.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jcub1011/KnockBox</RepositoryUrl>
    <PackageTags>knockbox partygame plugin-system core</PackageTags>
    <!-- Ships README.md on NuGet.org. The file is packed below via <None Include>. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Reproducible-build + SourceLink. CI-only flag (honored when the GitHub
         Actions runner sets CI=true) makes the PDB mappings use relative paths
         so they resolve against the committed source rather than the runner's
         workspace. Emits a companion .snupkg under IncludeSymbols=true. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
    <!-- AssemblyVersion is pinned to the major for the whole v1.x line so
         consumers pinned at [1.0.0, 2.0.0) never need binding redirects when
         we ship a minor/patch. FileVersion and AssemblyInformationalVersion
         both track the full SemVer (driven by `-p:Version=…` in CI), and the
         PluginLoader compatibility gate reads InformationalVersion so it sees
         the real ship version even though AssemblyVersion is frozen. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core shared framework — needed so the IGameEngineHttpHandler
         contract can use HttpContext / IResult, and so Razor components and
         logging/DI abstractions are available for plugins. Plugins already run
         inside the ASP.NET host process, so this is a non-additive runtime
         dependency for them; M02 makes the HTTP types visible at compile time. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- SourceLink embeds commit + repo URL into the PDB so NuGet consumers
         can step-into KnockBox.Core sources directly from GitHub. PrivateAssets
         keeps the package out of transitive dependency lists. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packs README.md into the root of the NuGet so NuGet.org renders it. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Grants the in-repo test project access to internal APIs (the
         PluginLoader forbidden-dependency helper, etc.) and the Platform
         package access to the AddGameEngine helper used by
         DefaultPluginRegistration. External consumers remain bound by the
         public surface. -->
    <InternalsVisibleTo Include="KnockBox.CoreTests" />
    <InternalsVisibleTo Include="KnockBox.Platform" />
  </ItemGroup>

</Project>
