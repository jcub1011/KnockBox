@page "/"
@page "/home"

@inherits DisposableComponent

<PageTitle>@PlatformOptions.Value.Branding.HomePageTitle</PageTitle>

<div class="home-container @(_isTransitioning ? "transitioning" : "") @(_isReturning ? "returning" : "")">

    <svg class="home-decor home-decor-star home-decor-star-1" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <path d="M32 4 L38 24 L60 26 L42 40 L48 60 L32 48 L16 60 L22 40 L4 26 L26 24 Z"
              fill="#FFD166" stroke="#000" stroke-width="4" stroke-linejoin="round" />
    </svg>
    <svg class="home-decor home-decor-star home-decor-star-2" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <path d="M32 4 L38 24 L60 26 L42 40 L48 60 L32 48 L16 60 L22 40 L4 26 L26 24 Z"
              fill="#1EFFBC" stroke="#000" stroke-width="4" stroke-linejoin="round" />
    </svg>
    <svg class="home-decor home-decor-squiggle" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
        <path d="M4 20 Q 20 4, 36 20 T 68 20 T 100 20 T 132 20"
              fill="none" stroke="#FF0055" stroke-width="6" stroke-linecap="round" />
    </svg>
    <svg class="home-decor home-decor-dots" viewBox="0 0 80 80" aria-hidden="true" focusable="false">
        <circle cx="14" cy="14" r="8" fill="#1EFFBC" stroke="#000" stroke-width="3" />
        <circle cx="50" cy="22" r="6" fill="#FF0055" stroke="#000" stroke-width="3" />
        <circle cx="28" cy="50" r="7" fill="#FFD166" stroke="#000" stroke-width="3" />
        <circle cx="62" cy="60" r="5" fill="#fff" stroke="#000" stroke-width="3" />
    </svg>

    <section class="hero-banner">
        <div class="hero-ribbon" aria-hidden="true"></div>
        <svg class="hero-sparkle hero-sparkle-left" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z"
                  fill="#fff" stroke="#000" stroke-width="3" stroke-linejoin="round" />
        </svg>
        <svg class="hero-sparkle hero-sparkle-right" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path d="M24 2 L28 20 L46 24 L28 28 L24 46 L20 28 L2 24 L20 20 Z"
                  fill="#FF0055" stroke="#000" stroke-width="3" stroke-linejoin="round" />
        </svg>
        <div class="hero">
            <h1 class="title">
                @foreach (var letter in PlatformOptions.Value.Branding.HomeHeroTitle)
                {
                    <span class="title-letter" aria-hidden="true">@letter</span>
                }
                <span class="sr-only">@PlatformOptions.Value.Branding.HomeHeroTitle</span>
            </h1>
            <p class="hero-tagline">Grab a friend &mdash; pick a game &mdash; cause chaos.</p>
        </div>
    </section>

    <form @onsubmit="() => JoinLobby(LobbyCode ?? string.Empty)" @onsubmit:preventDefault="true">
        <div class="join-section">
            <div class="join-card join-card-name">
                <label class="join-label" for="player-name-input">Player Name</label>
                <input id="player-name-input"
                       placeholder="Enter name"
                       type="text" maxlength="12" name="player-name"
                       @bind="PlayerName" @bind:event="oninput" style="text-transform: none;"/>
            </div>

            <div class="join-card join-card-code">
                <label class="join-label" for="room-code-input">Room Code</label>
                <div class="join-code-row">
                    <input id="room-code-input"
                           placeholder="KN0CK3OX"
                           type="text" maxlength="@LobbyCodeService.LobbyCodeLength" name="room-code"
                           @bind="LobbyCode"/>
                    <button type="submit" class="join-btn" disabled="@(!CanJoinOrCreate)">Join</button>
                </div>
            </div>
        </div>
    </form>

    <div class="games-section">
        <h2 class="games-heading">
            <span class="games-heading-icon" aria-hidden="true">&#127922;</span>
            Pick a Game
        </h2>
        <div class="game-grid">
            @foreach (var module in VisibleGameModules)
            {
                <button class="game-tile @(module.Manifest.WorkInProgress ? "is-wip" : null)"
                        aria-label="@module.Manifest.Name"
                        disabled="@(!CanJoinOrCreate)"
                        @onclick="() => CreateLobby(module.Manifest.RouteIdentifier)">
                    @if (module.Manifest.TileAsset is { } tileAsset)
                    {
                        <img class="game-tile-img game-tile-surface"
                             src="_content/@(module.Manifest.EntryAssembly)/@tileAsset"
                             alt=""
                             draggable="false"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="game-tile-surface game-tile-fallback">
                            @module.Manifest.Name
                        </div>
                    }
                    @if (module.Manifest.WorkInProgress)
                    {
                        <img class="game-tile-wip-overlay"
                             src="_content/KnockBox.Platform/wip-overlay.svg"
                             alt=""
                             aria-hidden="true"
                             draggable="false" />
                    }
                </button>
            }
        </div>
    </div>

    @if (_errorMessage is not null)
    {
        <div @key="_errorKey" class="home-error-toast">
            <span class="home-error-icon" aria-hidden="true">&#9888;&#65039;</span>
            <span>@_errorMessage</span>
        </div>
    }
</div>
