@using KnockBox.Core.Services.State.Users
@using KnockBox.DrawnToDress.Services.State.Games
@using KnockBox.DrawnToDress.Services.State.Games.Data

<div class="dtd-lobby">
    @{
        bool isHost = UserService.CurrentUser?.Id == GameState.Host.Id;
        int playerCount = GameState.Players.Length;
        bool belowMinimum = playerCount < DrawnToDressSettings.RecommendedMinimumPlayers;
    }

    <div class="dtd-lobby-main">
        <h2 class="dtd-lobby-title">👗 Drawn To Dress</h2>
        <p class="dtd-lobby-subtitle">Waiting for players...</p>

        <h4 class="dtd-section-title">Players (@playerCount)</h4>
        <div class="dtd-player-list" role="list" aria-label="Players in lobby">
            @* Host is always first *@
            <div class="dtd-player dtd-player-host @(GameState.Host.Id == UserService.CurrentUser?.Id ? "dtd-player-me" : "")" role="listitem">
                <span class="dtd-player-avatar" aria-hidden="true">👑</span>
                <span class="dtd-player-name">@GameState.Host.Name</span>
                <span class="dtd-host-badge">HOST</span>
            </div>

            @foreach (var entry in GameState.Players)
            {
                bool isMe = entry.User.Id == UserService.CurrentUser?.Id;
                if (isHost)
                {
                    <div role="listitem">
                        <button class="dtd-player dtd-player-kick @(isMe ? "dtd-player-me" : "")"
                                @onclick="() => KickPlayer(entry.User.Id)"
                                aria-label="Kick @entry.DisplayName"
                                title="Click to kick @entry.DisplayName">
                            <span class="dtd-player-avatar" aria-hidden="true">🎨</span>
                            <span class="dtd-player-name">@entry.DisplayName</span>
                            <span class="dtd-kick-hint" aria-hidden="true">✕ Kick</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="dtd-player @(isMe ? "dtd-player-me" : "")" role="listitem">
                        <span class="dtd-player-avatar" aria-hidden="true">🎨</span>
                        <span class="dtd-player-name">@entry.DisplayName</span>
                    </div>
                }
            }
        </div>

        @if (isHost)
        {
            @if (belowMinimum)
            {
                <p class="dtd-warning">
                    ⚠️ Recommended minimum is @DrawnToDressSettings.RecommendedMinimumPlayers players.
                    You can still start, but gameplay may feel limited.
                </p>
            }
            <button class="dtd-btn dtd-btn-primary dtd-btn-lg" @onclick="StartGame" aria-label="Start Game">
                🎨 Start Game
            </button>
        }
        else
        {
            <p class="dtd-waiting-text">Waiting for the host to start...</p>
        }
    </div>

    @if (isHost)
    {
        <button class="dtd-settings-toggle-btn" @onclick="ToggleSettings" aria-label="Game Settings" title="Game Settings">
            <span aria-hidden="true">⚙️</span>
        </button>

        @if (SettingsOpen)
        {
            <div class="dtd-settings-backdrop" @onclick="ToggleSettings" aria-hidden="true"></div>
        }
        <div class="dtd-settings-drawer @(SettingsOpen ? "dtd-settings-drawer-open" : "")"
             role="dialog" aria-label="Game Settings">
            <div class="dtd-settings-header">
                <h3 class="dtd-settings-title">⚙️ Game Settings</h3>
                <button class="dtd-settings-close-btn" @onclick="ToggleSettings" aria-label="Close settings" title="Close">✕</button>
            </div>
            <div class="dtd-settings-body">

                <!-- ── Presets ─────────────────────────────────────────── -->
                <h4 class="dtd-settings-section">⚡ Quick Presets</h4>
                <div class="dtd-preset-row">
                    @for (int i = 0; i < LobbyPhase.Presets.Length; i++)
                    {
                        var idx = i;
                        var preset = LobbyPhase.Presets[idx];
                        <button class="dtd-btn dtd-btn-preset" @onclick="() => ApplyPreset(idx)"
                                title="@preset.Description">
                            @preset.Name
                        </button>
                    }
                    <button class="dtd-btn @(_resetArmed ? "dtd-btn-accent" : "dtd-btn-secondary")"
                            @onclick="ResetToDefaults"
                            title="Restore all settings to their defaults">
                        @(_resetArmed ? "⚠ Click again to confirm" : "↺ Reset to Defaults")
                    </button>
                </div>

                <!-- ── Drawing ────────────────────────────────────────────── -->
                <h4 class="dtd-settings-section">🎨 Drawing</h4>
                <div class="dtd-settings-grid">
                    <label class="dtd-setting-label">
                        Drawing Time (sec):
                        <input type="number" min="30" max="600" step="10" class="dtd-setting-input"
                               @bind:get="GameState.Settings.DrawingTimeSec" @bind:set="SetDrawingTimeSec" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Automatically advance phases when the timer expires">
                        <span>Enable Game Timers:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.EnableTimer" @bind:set="SetEnableTimer" />
                    </label>
                    <label class="dtd-setting-label">
                        Theme Announcement Time (seconds):
                        <input type="number" min="5" class="dtd-setting-input"
                               @bind:get="GameState.Settings.ThemeAnnouncementTimeSec" @bind:set="SetThemeAnnouncementTimeSec" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Players can keep sketching while outfit building is active">
                        <span>Allow Sketching During Outfit Building:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.AllowSketchingDuringOutfitBuilding" @bind:set="SetAllowSketchingDuringOutfitBuilding" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Show a live gallery of drawings on the host screen during the drawing phase">
                        <span>Show Drawings on Host Screen:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.ShowDrawingsOnHostScreen" @bind:set="SetShowDrawingsOnHostScreen" />
                    </label>
                </div>

                <!-- ── Clothing Types ─────────────────────────────────────── -->
                <h4 class="dtd-settings-section">👕 Clothing Categories</h4>
                <div class="dtd-settings-grid">
                    @foreach (var ct in DrawnToDressSettings.DefaultClothingTypes)
                    {
                        var typeId = ct.Id;
                        <label class="dtd-setting-label dtd-setting-label-row" title="Include @ct.DisplayName drawings in the game">
                            <span>@ct.DisplayName:</span>
                            <input type="checkbox" class="dtd-setting-checkbox"
                                   checked="@IsClothingTypeEnabled(typeId)"
                                   @onchange="() => ToggleClothingType(typeId)" />
                        </label>
                    }
                </div>

                <!-- ── Theme ────────────────────────────────────────────── -->
                <h4 class="dtd-settings-section">🎭 Theme</h4>
                <div class="dtd-settings-grid">
                    <label class="dtd-setting-label">
                        Theme Source:
                        <select class="dtd-setting-select" @bind:get="GameState.Settings.ThemeSource" @bind:set="SetThemeSource">
                            @foreach (var source in Enum.GetValues<ThemeSource>())
                            {
                                <option value="@source">@source</option>
                            }
                        </select>
                    </label>
                    <label class="dtd-setting-label">
                        Theme Reveal:
                        <select class="dtd-setting-select" @bind:get="GameState.Settings.ThemeAnnouncement" @bind:set="SetThemeAnnouncement">
                            @foreach (var announcement in Enum.GetValues<ThemeAnnouncement>())
                            {
                                <option value="@announcement">@announcement</option>
                            }
                        </select>
                    </label>
                </div>

                <!-- ── Outfit Building ──────────────────────────────────── -->
                <h4 class="dtd-settings-section">👗 Outfit Building</h4>
                <div class="dtd-settings-grid">
                    <label class="dtd-setting-label">
                        Outfit Building Time (seconds):
                        <input type="number" min="30" class="dtd-setting-input"
                               @bind:get="GameState.Settings.OutfitBuildingTimeSec" @bind:set="SetOutfitBuildingTimeSec" />
                    </label>
                    <label class="dtd-setting-label">
                        Outfit Customization Time (seconds):
                        <input type="number" min="15" class="dtd-setting-input"
                               @bind:get="GameState.Settings.OutfitCustomizationTimeSec" @bind:set="SetOutfitCustomizationTimeSec" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Players may reuse their own drawn items in their outfit">
                        <span>Allow Reuse of Own Items:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.AllowReuseOwnItems" @bind:set="SetAllowReuseOwnItems" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Players may actively select their own drawings from the pool">
                        <span>Allow Selecting Own Drawings:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.AllowSelectOwnDrawings" @bind:set="SetAllowSelectOwnDrawings" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Each outfit slot must contain a unique item">
                        <span>Require Distinct Items Per Slot:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.RequireDistinctItemsPerSlot" @bind:set="SetRequireDistinctItemsPerSlot" />
                    </label>
                </div>

                <!-- ── Voting ────────────────────────────────────────────── -->
                <h4 class="dtd-settings-section">🗳 Voting</h4>
                <div class="dtd-settings-grid">
                    <label class="dtd-setting-label">
                        Voting Time (seconds):
                        <input type="number" min="15" class="dtd-setting-input"
                               @bind:get="GameState.Settings.VotingTimeSec" @bind:set="SetVotingTimeSec" />
                    </label>
                    <label class="dtd-setting-label dtd-setting-label-row" title="Reveal who created each outfit to voters">
                        <span>Show Creator During Voting:</span>
                        <input type="checkbox" class="dtd-setting-checkbox"
                               @bind:get="GameState.Settings.ShowCreatorDuringVoting" @bind:set="SetShowCreatorDuringVoting" />
                    </label>
                </div>

                <!-- ── Tournament ────────────────────────────────────────── -->
                <h4 class="dtd-settings-section">🏆 Tournament</h4>
                <div class="dtd-settings-grid">
                    <label class="dtd-setting-label">
                        Voting Rounds:
                        <input type="number" min="0" class="dtd-setting-input"
                               @bind:get="GameState.Settings.VotingRounds" @bind:set="SetVotingRounds" />
                        @if (GameState.Settings.VotingRounds == 0)
                        {
                            <span class="dtd-setting-hint">(Auto)</span>
                        }
                    </label>
                    <label class="dtd-setting-label">
                        Bonus Points for Complete Outfit:
                        <input type="number" min="0" class="dtd-setting-input"
                               @bind:get="GameState.Settings.BonusPointsForCompleteOutfit" @bind:set="SetBonusPointsForCompleteOutfit" />
                    </label>
                </div>

                <!-- ── Host / Connectivity ───────────────────────────────── -->
                <h4 class="dtd-settings-section">🔌 Connectivity</h4>
                <div class="dtd-settings-grid">
                    <label class="dtd-setting-label">
                        Host Disconnect Timeout (seconds):
                        <input type="number" min="30" class="dtd-setting-input"
                               @bind:get="GameState.Settings.HostDisconnectTimeoutSec" @bind:set="SetHostDisconnectTimeoutSec" />
                    </label>
                </div>

            </div>
        </div>
    }
</div>

