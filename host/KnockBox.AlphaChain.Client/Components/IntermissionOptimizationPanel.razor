@* Optimization sub-phase: the local player privately resequences their Engine Bay and,
   when it overflows the (newly expanded) slot count, discards the excess. Reorder is HTML5
   drag-and-drop with a keyboard fallback (focus a card, then ←/→ to move it). Freshly-dealt
   cards are flagged NEW and pop in. Opponents' bays are hidden — only a submitted/total tally
   is shown (fog-of-war). Cards are pre-flattened CardViews. *@

<div class="ac-im-opt">
    <div class="ac-im-opt-head">
        <h3 class="ac-im-opt-title">Optimize your Engine Bay</h3>
        <span class="ac-im-opt-count">@SubmittedCount / @TotalCount ready</span>
    </div>

    <div class="ac-im-opt-banner">
        <span class="ac-im-opt-slotbadge">+1 SLOT</span>
        <span>Engine Bay expanded to <strong>@Slots</strong> slots. New cards are marked <span class="ac-im-opt-newtag">NEW</span>.</span>
    </div>

    <p class="ac-im-opt-hint">Drag cards to reorder — or focus a card and use ← / →. Cards apply left-to-right; place additives before multipliers to score more.</p>

    @if (HasSubmitted)
    {
        <p class="ac-im-opt-locked">Locked in — waiting for the other players…</p>
    }

    @if (Overflow > 0)
    {
        <p class="ac-im-opt-warn">Your bay holds @Kept.Count cards but only @Slots slots — discard @Overflow to continue.</p>
    }

    <ol class="ac-im-opt-slots">
        @for (int i = 0; i < Kept.Count; i++)
        {
            int index = i;
            var card = Kept[index];
            bool overCapacity = index >= Slots;
            bool isNew = NewCardIds.Contains(card.Id);

            <li class="ac-im-opt-slot @(overCapacity ? "ac-im-opt-overflow" : "")"
                @ondragover:preventDefault="!HasSubmitted"
                @ondrop="() => OnDrop(index)">
                <span class="ac-im-opt-pos">@(index + 1)</span>
                @if (isNew)
                {
                    <span class="ac-im-opt-newmark">NEW</span>
                }
                <button type="button"
                        class="ac-cardbtn"
                        draggable="@(HasSubmitted ? "false" : "true")"
                        aria-grabbed="@(_dragIndex == index ? "true" : "false")"
                        title="Click to flip · drag or ← / → to reorder"
                        @ondragstart="() => _dragIndex = index"
                        @ondragend="() => _dragIndex = null"
                        @onclick="() => ToggleFlip(card.Id)"
                        @onkeydown="e => OnKeyDown(e, index)">
                    <GameCard Name="@card.Name" Description="@card.Description" Card="@card.Id"
                              Accent="card.Accent"
                              Size="CardSize.Large" Chips="@card.Chips"
                              Flipped="@_flipped.Contains(card.Id)"
                              Dragging="@(_dragIndex == index)" New="@isNew" />
                </button>
                <button type="button" class="ac-im-opt-discard"
                        disabled="@HasSubmitted"
                        title="Discard this card"
                        @onclick="() => Discard(index)">✕</button>
            </li>
        }
    </ol>

    @if (Discarded.Count > 0)
    {
        <div class="ac-im-opt-bin">
            <span class="ac-im-opt-bin-label">Discarded</span>
            @foreach (var card in Discarded)
            {
                <button type="button" class="ac-cardbtn"
                        disabled="@HasSubmitted"
                        title="Put back"
                        @onclick="() => Restore(card.Id)">
                    <GameCard Name="@card.Name" Description="@card.Description" Card="@card.Id"
                              Accent="card.Accent"
                              Size="CardSize.Small" Chips="@card.Chips"
                              Dim="true" />
                </button>
            }
        </div>
    }

    <button type="button" class="ac-im-opt-confirm"
            disabled="@(HasSubmitted || Overflow > 0)"
            @onclick="ConfirmAsync">
        @(HasSubmitted ? "Locked in" : "Lock in order")
    </button>
</div>

@code {
    /// <summary>The local player's candidate cards (current bay + just-dealt), in current order.</summary>
    [Parameter] public IReadOnlyList<CardView> Cards { get; set; } = [];

    /// <summary>The local player's (post-expansion) slot capacity.</summary>
    [Parameter] public int Slots { get; set; }

    /// <summary>Ids of modifier cards freshly dealt this Intermission — flagged NEW + popped in.</summary>
    [Parameter] public IReadOnlyList<ModifierId> NewCardIds { get; set; } = [];

    /// <summary>How many players have locked in.</summary>
    [Parameter] public int SubmittedCount { get; set; }

    /// <summary>How many players are optimizing in total.</summary>
    [Parameter] public int TotalCount { get; set; }

    /// <summary>Whether the local player has already locked in.</summary>
    [Parameter] public bool HasSubmitted { get; set; }

    /// <summary>Raised with the kept ordering (≤ Slots) when the player locks in.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> OnSubmit { get; set; }

    private List<CardView> Kept = new();
    private List<CardView> Discarded = new();
    private readonly HashSet<ModifierId> _flipped = new();
    private int? _dragIndex;
    private string? _seededFor;

    /// <summary>Toggles a Large card between its identity (front) and description (back).</summary>
    private void ToggleFlip(ModifierId id)
    {
        if (!_flipped.Remove(id))
            _flipped.Add(id);
    }

    /// <summary>Cards held beyond the slot capacity (must be discarded before locking in).</summary>
    private int Overflow => Math.Max(0, Kept.Count - Slots);

    protected override void OnParametersSet()
    {
        // Seed the working lists once from the incoming card order. Re-seed only if the
        // candidate set changes identity (e.g., a fresh optimization), never on every render,
        // so the player's in-progress reorder isn't clobbered by state-change re-renders.
        var signature = string.Join(",", Cards.Select(c => c.Id));
        if (_seededFor != signature)
        {
            Kept = Cards.ToList();
            Discarded = new();
            _flipped.Clear();
            _dragIndex = null;
            _seededFor = signature;
        }
    }

    private void OnDrop(int targetIndex)
    {
        if (HasSubmitted || _dragIndex is not { } from) return;
        _dragIndex = null;
        Move(from, targetIndex);
    }

    /// <summary>Keyboard fallback: ←/→ move the focused card one slot in that direction.</summary>
    private void OnKeyDown(KeyboardEventArgs e, int index)
    {
        if (HasSubmitted) return;
        int target = e.Key switch
        {
            "ArrowLeft" => index - 1,
            "ArrowRight" => index + 1,
            _ => index
        };
        if (target != index) Move(index, target);
    }

    // Moves the card at `from` to `to` (clamped to the kept range). A move-and-insert keeps
    // the player's intent intact across multi-step reorders better than a pairwise swap.
    private void Move(int from, int to)
    {
        if (from < 0 || from >= Kept.Count) return;
        to = Math.Clamp(to, 0, Kept.Count - 1);
        if (from == to) return;

        var card = Kept[from];
        Kept.RemoveAt(from);
        Kept.Insert(to, card);
    }

    private void Discard(int index)
    {
        if (HasSubmitted || index >= Kept.Count) return;
        _dragIndex = null;
        var card = Kept[index];
        Kept.RemoveAt(index);
        Discarded.Add(card);
    }

    private void Restore(ModifierId id)
    {
        if (HasSubmitted) return;
        var card = Discarded.FirstOrDefault(c => c.Id == id);
        if (card is null) return;
        Discarded.Remove(card);
        Kept.Add(card);
    }

    private async Task ConfirmAsync()
    {
        if (HasSubmitted || Overflow > 0) return;
        await OnSubmit.InvokeAsync(Kept.Select(c => c.Id.ToString()).ToList());
    }
}
