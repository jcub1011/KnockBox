@* The uniform card renderer, in two fixed-dimension sizes so cards always line up:

   • Small — accent + icon + a compact type/magnitude chip, with the card's rules text on hover.
     Used wherever a card just needs to be recognised (Engine Bay during a round, opponent
     summaries, discard bin); the visible label is the name, the hover tooltip is the description.
   • Large — a flip card. Front teaches the card (icon + title + chips); the full description lives
     on the back, revealed by flipping. The back scrolls if the text overflows.

   This component owns visuals only — interaction (drag, discard, and toggling Flipped on click) lives
   in the wrapping consumer. Chips are pre-flattened server-side into ChipView (label + CSS color). *@

@if (Size == CardSize.Large)
{
    <div class="@RootClass" style="@CardColorStyle">
        <div class="gc-flip-inner">
            <div class="gc-face gc-front">
                <span class="gc-watermark" aria-hidden="true"><CardIcon Card="@Card" /></span>
                <div class="gc-head">
                    <span class="gc-icon"><CardIcon Card="@Card" /></span>
                    <div class="gc-chips">
                        @foreach (var chip in Chips)
                        {
                            <span class="gc-chip" style="--chip:@chip.Color">@chip.Label</span>
                        }
                    </div>
                </div>
                <span class="gc-name">@Name</span>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="gc-front-desc">@Description</p>
                }
                <span class="gc-flip-hint">tap to flip</span>
            </div>
            <div class="gc-face gc-back">
                <span class="gc-back-name">@Name</span>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="gc-desc">@Description</p>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="@RootClass" style="@CardColorStyle" title="@SmallTooltip">
        <span class="gc-watermark" aria-hidden="true"><CardIcon Card="@Card" /></span>
        <div class="gc-small-top">
            <span class="gc-icon"><CardIcon Card="@Card" /></span>
            <div class="gc-chips">
                @foreach (var chip in Chips)
                {
                    <span class="gc-chip" style="--chip:@chip.Color">@chip.Label</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Name))
        {
            @* Title in an SVG whose viewBox is sized (roughly) to the text, scaled uniformly to the
               card width via preserveAspectRatio — so long names shrink to fit instead of truncating. *@
            <svg class="gc-name-fit" viewBox="0 0 @NameViewWidth 130" preserveAspectRatio="xMidYMid meet" role="img" aria-label="@Name">
                <text x="@(NameViewWidth / 2)" y="96" text-anchor="middle" font-size="100">@Name</text>
            </svg>
        }
    </div>
}

@code {
    /// <summary>Card display name.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Rules text — shown on the back of a Large card, and as the hover tooltip on a Small card.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>The card whose glyph to show, resolved by <see cref="CardIcon"/>.</summary>
    [Parameter] public ModifierId Card { get; set; }

    /// <summary>The card's standardized family accent, driving the border + accent tint.</summary>
    [Parameter] public CardAccent Accent { get; set; } = CardAccent.Neutral;

    /// <summary>The card's glanceable chips (type, magnitude, any live status), pre-flattened server-side.</summary>
    [Parameter] public IReadOnlyList<ChipView> Chips { get; set; } = [];

    /// <summary>Which fixed footprint to render.</summary>
    [Parameter] public CardSize Size { get; set; } = CardSize.Small;

    /// <summary>For a Large card: whether the description side is showing. The parent owns this state.</summary>
    [Parameter] public bool Flipped { get; set; }

    /// <summary>Selected outline (e.g. a chosen action target).</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Drag-in-progress styling.</summary>
    [Parameter] public bool Dragging { get; set; }

    /// <summary>Dimmed/disabled look (a card that can't be played right now).</summary>
    [Parameter] public bool Dim { get; set; }

    /// <summary>Plays the entrance pop + glow (a freshly-dealt card).</summary>
    [Parameter] public bool New { get; set; }

    /// <summary>Full root class string (base + size + state modifiers).</summary>
    private string RootClass =>
        $"gc-card gc-{SizeClass}{StateClasses}";

    private string SizeClass => Size == CardSize.Large ? "large" : "small";

    /// <summary>Approximate width (in the title SVG's 100-unit em) of the small-card name, used as the
    /// SVG viewBox width so <c>preserveAspectRatio</c> scales the text uniformly to fit the card.</summary>
    private int NameViewWidth
    {
        get
        {
            double units = 0;
            foreach (char c in Name)
            {
                char l = char.ToLowerInvariant(c);
                units += c switch
                {
                    'm' or 'w' => 92,
                    'M' or 'W' => 104,
                    _ when "iljtf.,'!| ".IndexOf(l) >= 0 => 32,
                    _ when char.IsUpper(c) => 72,
                    _ when char.IsDigit(c) => 60,
                    _ => 56,
                };
            }
            return (int)Math.Ceiling(units) + 16;
        }
    }

    /// <summary>The card's identity color (<c>--gc-card-color</c>) plus its standardized family accent
    /// (<c>--gc-accent</c>: the border + accent tint). Both ported into <see cref="CardStyles"/>.</summary>
    private string CardColorStyle => $"--gc-card-color:{CardStyles.CardColor(Card)};--gc-accent:{CardStyles.AccentColor(Accent)}";

    /// <summary>Hover tooltip for the Small card: the rules text, so a glanceable card reveals what it
    /// does on hover. Falls back to the name only when no description is supplied (and to no tooltip
    /// when neither is set).</summary>
    private string? SmallTooltip =>
        !string.IsNullOrEmpty(Description) ? Description
        : string.IsNullOrEmpty(Name) ? null : Name;

    private string StateClasses =>
        (Flipped ? " gc-flipped" : "")
        + (Selected ? " gc-selected" : "")
        + (Dragging ? " gc-dragging" : "")
        + (Dim ? " gc-dim" : "")
        + (New ? " gc-new" : "");
}
