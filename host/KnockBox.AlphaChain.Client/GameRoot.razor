@inherits HubLobbyPageBase<AlphaChainView>
@*
    GameRoot — the runtime-loaded WASM UI entry point for Alpha Chain. Inheriting
    HubLobbyPageBase<AlphaChainView> opens the hub, joins the lobby, deserializes each
    per-player projection into `View`, and disposes on teardown. It dispatches to the phase
    components exactly as the old server AlphaChainLobby/AlphaChainGame pages did.
*@

@* The game ships its own stylesheets from the server plugin's mounted wwwroot; a runtime-
   loaded WASM component can't use HeadContent and the streamed .Client DLL has no scoped
   bundle, so we link the plain (de-scoped) stylesheets here. *@
<link rel="stylesheet" href="_content/KnockBox.AlphaChain/css/alpha-chain-theme.css" />
<link rel="stylesheet" href="_content/KnockBox.AlphaChain/css/cards.css" />
<link rel="stylesheet" href="_content/KnockBox.AlphaChain/css/alpha-chain.css" />

<AlphaChainHeader Code="@LobbyCode" OnLeave="LeaveAsync" />

<div class="ac-root">
@if (View is null)
{
    <div class="content"><div>Loading…</div></div>
}
else if (View.IsBench)
{
    @* Host-only Testing Bay — checked before IsJoinable (the bench's inner state is not joinable). *@
    <BenchView View="View" Submit="Submit" SubmitWithResult="SubmitR" />
}
else if (View.IsJoinable)
{
    <LobbyView View="View" Submit="Submit" />
}
else
{
    <GamePhase View="View" Submit="Submit" SubmitWithResult="SubmitR" />
}
</div>

@code {
    /// <summary>The lobby code from the room URL, supplied by the WASM host page.</summary>
    [Parameter] public string Code { get; set; } = "";

    /// <summary>The player's chosen display name, propagated from the home page.</summary>
    [Parameter] public string? PlayerName { get; set; }

    protected override string RouteIdentifier => "alpha-chain";
    protected override string LobbyUri => $"room/alpha-chain/{Code}";
    protected override string DisplayName => string.IsNullOrWhiteSpace(PlayerName) ? "Player" : PlayerName!;

    public GameRoot()
        : base(new SourceGenProjectionDeserializer<AlphaChainView>(
            AlphaChainContractsJsonContext.Default.AlphaChainView))
    {
    }

    private Task Submit(string command, string? payload) => SubmitCommandAsync(command, payload);

    // Word submission needs the hub's reply (null on success, an error message on rejection) so
    // RoundPhase can surface a rejected word inline. SubmitCommandAsync already returns Task<string?>.
    private Task<string?> SubmitR(string command, string? payload) => SubmitCommandAsync(command, payload);
}
