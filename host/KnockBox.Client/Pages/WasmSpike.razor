@page "/spike/wasm"
@page "/spike/wasm/{Code}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject GameHubConnectionFactory HubFactory
@inject IClientPluginLoader PluginLoader
@inject NavigationManager Nav

<PageTitle>WASM Migration Spike</PageTitle>

<h1>KnockBox WASM Migration — Phase 0 Spike</h1>
<p style="color:#555;">
    This page renders via <code>InteractiveWebAssembly</code>. Its game UI is an
    assembly the client never referenced at build time, streamed from the server
    and loaded with <code>LoadFromStream</code>.
</p>

<p><strong>Status:</strong> @_status</p>

@if (string.IsNullOrEmpty(Code))
{
    <button @onclick="CreateRoom" disabled="@(!_connected)">Create a Hidden Agenda spike room</button>
}
else
{
    <p>
        <strong>Room:</strong> <code>@Code</code> &nbsp;
        <em>(share this URL with other tabs/browsers to join)</em>
    </p>

    @if (_rootComponentType is not null)
    {
        <DynamicComponent Type="_rootComponentType" Parameters="_rootParameters" />
    }
    else
    {
        <p><em>Loading runtime game UI…</em></p>
    }
}

@code {
    private const string Route = "hidden-agenda";

    [Parameter] public string? Code { get; set; }

    private HubConnection? _hub;
    private string _lobbyUri = "";
    private Guid _userId;
    private string _userName = "";
    private bool _connected;
    private string _status = "Initializing…";

    private Type? _rootComponentType;
    private string? _viewJson;
    private long _lastVersion = -1;
    private string? _lastCommandResult;
    private Dictionary<string, object> _rootParameters = new();

    protected override async Task OnInitializedAsync()
    {
        // Self-asserted per-tab identity (mirrors KnockBox's existing player model;
        // a real deployment resolves this from localStorage / the auth cookie).
        _userId = Guid.NewGuid();
        _userName = $"Player-{_userId.ToString()[..4]}";

        _hub = HubFactory.Create(_userId, _userName);
        _hub.On<string, long, string>(nameof(IGameClient.ReceiveView), OnReceiveView);

        await _hub.StartAsync();
        _connected = true;
        _status = $"Connected to hub as {_userName}.";

        if (!string.IsNullOrEmpty(Code))
            await JoinAndLoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Handle navigation from /spike/wasm to /spike/wasm/{code} after creating.
        if (_connected && !string.IsNullOrEmpty(Code) && string.IsNullOrEmpty(_lobbyUri))
            await JoinAndLoadAsync();
    }

    private async Task CreateRoom()
    {
        _status = "Creating room…";
        var uri = await _hub!.InvokeAsync<string?>("CreateRoom", Route);
        if (uri is null)
        {
            _status = "Failed to create room.";
            return;
        }

        // uri == "room/hidden-agenda/{guidA}-{guidB}"; navigate to the spike page for it.
        var code = uri[(uri.LastIndexOf('/') + 1)..];
        Nav.NavigateTo($"/spike/wasm/{code}");
    }

    private async Task JoinAndLoadAsync()
    {
        _lobbyUri = $"room/{Route}/{Code}";

        _status = "Joining room…";
        var joinError = await _hub!.InvokeAsync<string?>("JoinRoom", _lobbyUri);
        if (joinError is not null)
        {
            _status = $"Join failed: {joinError}";
            return;
        }

        _status = "Joined. Downloading runtime game UI…";
        var load = await PluginLoader.LoadGameRootAsync(Route);
        if (!load.Ok || load.RootComponentType is null)
        {
            _status = $"Failed to load game UI: {load.Error}";
            return;
        }

        _rootComponentType = load.RootComponentType;
        _status = "Runtime game UI loaded.";
        BuildRootParameters();
        StateHasChanged();
    }

    private Task OnReceiveView(string routeIdentifier, long version, string payloadJson)
    {
        // Drop out-of-order / duplicate projections after a reconnect.
        if (version < _lastVersion)
            return Task.CompletedTask;

        _lastVersion = version;
        _viewJson = payloadJson;
        BuildRootParameters();
        return InvokeAsync(StateHasChanged);
    }

    private async Task SendCommandAsync(string command)
    {
        _lastCommandResult = await _hub!.InvokeAsync<string?>("SubmitCommand", _lobbyUri, command, null);
        _lastCommandResult = _lastCommandResult is null ? null : $"Command [{command}] rejected: {_lastCommandResult}";
        BuildRootParameters();
        StateHasChanged();
    }

    private void BuildRootParameters()
    {
        var dict = new Dictionary<string, object>
        {
            ["OnCommand"] = EventCallback.Factory.Create<string>(this, SendCommandAsync),
        };
        if (_viewJson is not null) dict["ViewJson"] = _viewJson;
        if (_lastCommandResult is not null) dict["LastCommandResult"] = _lastCommandResult;
        _rootParameters = dict;
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}
