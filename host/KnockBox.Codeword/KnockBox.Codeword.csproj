<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Content Include="Services\Logic\Games\Data\WordPairs.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <ProjectReference Include="../../sdk/KnockBox.Tooling/KnockBox.Tooling.csproj" />
    <ProjectReference Include="..\KnockBox.Codeword.Contracts\KnockBox.Codeword.Contracts.csproj" />
  </ItemGroup>

  <!--
    The Contracts DLL is a private dependency loaded into this plugin's own ALC
    (it is not promoted to the default ALC), so it must be staged into
    games/KnockBox.Codeword/ alongside the plugin DLL. See Directory.Plugin.targets.
  -->
  <ItemGroup>
    <PluginPrivateAssembly Include="$(TargetDir)KnockBox.Codeword.Contracts.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <!-- The phase/role enums, round-result records, and settings moved to the Contracts
         assembly; a global using keeps the engine/state/FSM source resolving them unchanged. -->
    <Using Include="KnockBox.Codeword.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KnockBox.CodewordTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Import Project="..\Directory.Plugin.targets" />

</Project>
