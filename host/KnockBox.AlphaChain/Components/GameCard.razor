@using KnockBox.AlphaChain.Services.Logic.Games.Data.Cards.Library

@* The uniform card renderer, in two fixed-dimension sizes so cards always line up:

   • Small — accent + icon + a compact type/magnitude chip + the live status badge. Used wherever a
     card just needs to be recognised (Engine Bay during a round, opponent summaries, discard bin).
   • Large — a flip card. Front teaches the card (icon + title + type & magnitude chips); the full
     description lives on the back, revealed by flipping. The back scrolls if the text overflows.

   This component owns visuals only — interaction (drag, discard, and toggling Flipped on click) lives
   in the wrapping consumer, which keeps GameCard free of any interactive nesting concerns. *@

@if (Size == CardSize.Large)
{
    <div class="@RootClass" style="@CardColorStyle">
        <div class="gc-flip-inner">
            <div class="gc-face gc-front">
                <span class="gc-watermark" aria-hidden="true"><CardIcon Card="@Card" /></span>
                <div class="gc-head">
                    <span class="gc-icon"><CardIcon Card="@Card" /></span>
                    <div class="gc-chips">
                        <span class="gc-chip gc-chip-type">@TypeLabel</span>
                        @if (!string.IsNullOrEmpty(MagnitudeText))
                        {
                            <span class="gc-chip @MagnitudeChipClass">@MagnitudeText</span>
                        }
                    </div>
                </div>
                <span class="gc-name">@Name</span>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="gc-front-desc">@Description</p>
                }
                <span class="gc-flip-hint">tap to flip</span>
            </div>
            <div class="gc-face gc-back">
                <span class="gc-back-name">@Name</span>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="gc-desc">@Description</p>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="@RootClass" style="@CardColorStyle" title="@SmallTooltip">
        <span class="gc-watermark" aria-hidden="true"><CardIcon Card="@Card" /></span>
        <span class="gc-icon"><CardIcon Card="@Card" /></span>
        <div class="gc-chips">
            @if (!string.IsNullOrEmpty(MagnitudeText))
            {
                <span class="gc-chip @MagnitudeChipClass">@MagnitudeText</span>
            }
            @if (!string.IsNullOrEmpty(LiveBadge))
            {
                <span class="gc-livebadge">@LiveBadge</span>
            }
        </div>
    </div>
}

@code {
    /// <summary>Card display name.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>Rules text — shown on the back of a Large card (ignored by Small).</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>The card whose glyph to show, resolved by <see cref="CardIcon"/>.</summary>
    [Parameter] public ModifierId Card { get; set; }

    /// <summary>Modifier type (additive/multiplicative), driving the accent tint + type chip.</summary>
    [Parameter] public ModifierType? Kind { get; set; }

    /// <summary>The card's glanceable magnitude chip (e.g. "+10", "×0.5–2", "FX"); null hides it.</summary>
    [Parameter] public string? MagnitudeText { get; set; }

    /// <summary>A live per-player status glyph for the Small card (e.g. the Titanium Mirror's "×0.7").</summary>
    [Parameter] public string? LiveBadge { get; set; }

    /// <summary>Which fixed footprint to render.</summary>
    [Parameter] public CardSize Size { get; set; } = CardSize.Small;

    /// <summary>For a Large card: whether the description side is showing. The parent owns this state.</summary>
    [Parameter] public bool Flipped { get; set; }

    /// <summary>Selected outline (e.g. a chosen action target).</summary>
    [Parameter] public bool Selected { get; set; }

    /// <summary>Drag-in-progress styling.</summary>
    [Parameter] public bool Dragging { get; set; }

    /// <summary>Dimmed/disabled look (a card that can't be played right now).</summary>
    [Parameter] public bool Dim { get; set; }

    /// <summary>Plays the entrance pop + glow (a freshly-dealt card).</summary>
    [Parameter] public bool New { get; set; }

    /// <summary>Full root class string (base + size + category + state modifiers).</summary>
    private string RootClass =>
        $"gc-card gc-{SizeClass} gc-{CategoryClass}{StateClasses}";

    private string SizeClass => Size == CardSize.Large ? "large" : "small";

    /// <summary>The card's identity color, exposed as the <c>--gc-card-color</c> variable that fills the
    /// icon swatch, the magnitude chip, the faint icon watermark, and (faintly) the background. Picked by
    /// hand (see <see cref="CardColor"/>) and spread across hue and lightness for separation. Color alone
    /// can't fully separate ~32 categories under color-vision deficiency, so the big icon watermark and
    /// the unique glyph carry shape as the dependable cue; additive-vs-multiplicative stays on the border.</summary>
    private string CardColorStyle => $"--gc-card-color:{CardColor(Card)}";

    /// <summary>Hand-tuned per-card palette — vivid, with deliberate lightness variation so confusable
    /// hues still differ in brightness. Unknown/unmapped falls back to a neutral slate.</summary>
    private static string CardColor(ModifierId id) => id switch
    {
        ModifierId.TheAnchor => "#4f9dff",
        ModifierId.Vanilla => "#f2e2a8",
        ModifierId.ConsonantCrunch => "#ff7a59",
        ModifierId.VocalVowels => "#34c7e6",
        ModifierId.VowelSurge => "#2ed6b6",
        ModifierId.TheArchitect => "#8f8cff",
        ModifierId.BrickLayer => "#d96a3c",
        ModifierId.Speedracer => "#ffd23d",
        ModifierId.LetterHoarder => "#f0a93c",
        ModifierId.Sesquipedalian => "#b06bff",
        ModifierId.GutturalRoar => "#c0603a",
        ModifierId.HighRoller => "#ff5ca0",
        ModifierId.PerfectLink => "#57e08a",
        ModifierId.TheVault => "#9fb3d6",
        ModifierId.Redline => "#ff4d4d",
        ModifierId.PanicButton => "#ff6a2b",
        ModifierId.HyperDrive => "#7d5bff",
        ModifierId.TaxCollector => "#2fa85a",
        ModifierId.IrsAgent => "#b6c24a",
        ModifierId.RouletteWheel => "#ff4fc0",
        ModifierId.TollBooth => "#d98f2e",
        ModifierId.BaitAndSwitch => "#e36ad6",
        ModifierId.Blindfold => "#6f7bff",
        ModifierId.DoubleDown => "#ff5f7a",
        ModifierId.AnchorChain => "#3aa6b8",
        ModifierId.FlakCannon => "#ffb02e",
        ModifierId.BountyHunter => "#cda06a",
        ModifierId.TitaniumMirror => "#b9cfe6",
        ModifierId.HeatSink => "#7fd8ff",
        ModifierId.Prism => "#d3a7ff",
        ModifierId.Wildcard => "#e9e9f2",
        ModifierId.Catalyst => "#b6e84a",
        _ => "#8aa0b3",
    };

    /// <summary>Hover tooltip for the Small card (which shows no text): title + description if present,
    /// else just the title. Null when there's nothing to show, so the attribute is omitted.</summary>
    private string? SmallTooltip =>
        string.IsNullOrEmpty(Description)
            ? (string.IsNullOrEmpty(Name) ? null : Name)
            : $"{Name} — {Description}";

    /// <summary>additive / multiplicative — selects the accent variable.</summary>
    private string CategoryClass =>
        Kind == ModifierType.Multiplier ? "multiplicative" : "additive";

    /// <summary>The type chip text (additive vs multiplicative).</summary>
    private string TypeLabel => Kind == ModifierType.Multiplier ? "MULT" : "ADD";

    /// <summary>An "FX" magnitude reads as a neutral effect chip, not a scoring multiplier.</summary>
    private string MagnitudeChipClass =>
        string.Equals(MagnitudeText, "FX", StringComparison.Ordinal) ? "gc-chip-effect" : "gc-chip-mag";

    private string StateClasses =>
        (Flipped ? " gc-flipped" : "")
        + (Selected ? " gc-selected" : "")
        + (Dragging ? " gc-dragging" : "")
        + (Dim ? " gc-dim" : "")
        + (New ? " gc-new" : "");
}
