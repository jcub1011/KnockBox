@using KnockBox.AlphaChain.Services.Logic.Games.Data.Cards

@* The player's action hand. Clicking a self-targeted card (Pivot/Amnesty) queues it
   immediately; clicking Time Thief opens a modal target-picker listing the available
   opponents, and choosing one plays the card against them. A card whose effect is already
   queued for the next submission carries a "Queued" badge. *@

<div class="ac-hand">
    <div class="ac-hand-header">
        <span class="ac-hand-title">Action Hand</span>
    </div>

    @if (Cards.Count == 0)
    {
        <p class="ac-hand-empty">No action cards.</p>
    }
    else
    {
        <ul class="ac-hand-cards">
            @foreach (var card in Cards)
            {
                var current = card;
                bool queued = QueuedKind == current.Kind && current.Kind != ActionKind.TimeThief;
                <li class="ac-hand-card-wrap">
                    <CardTooltip Name="@current.Name" Description="@current.Description" Category="CardCategory.Action">
                        <button type="button"
                                class="ac-card ac-card-action @(_pickerCard == current ? "ac-card-selected" : "")"
                                disabled="@Disabled"
                                @onclick="() => OnCardClicked(current)">
                            <span class="ac-card-name">@current.Name</span>
                            @if (queued)
                            {
                                <span class="ac-card-queued-badge" title="Queued for your next word">Queued</span>
                            }
                        </button>
                    </CardTooltip>
                </li>
            }
        </ul>
    }
</div>

@* Time Thief target-picker modal. Rendered once (not per-card) as a true overlay so it's
   centered and never clipped by the hand's layout. *@
@if (_pickerCard is { } picker && picker.Kind == ActionKind.TimeThief)
{
    <div class="ac-modal-backdrop" @onclick="ClosePicker">
        <div class="ac-modal" role="dialog" aria-modal="true" aria-label="Choose a Time Thief target"
             @onclick:stopPropagation="true">
            <div class="ac-modal-head">
                <span class="ac-modal-title">@picker.Name — steal time from…</span>
                <button type="button" class="ac-modal-close" @onclick="ClosePicker" aria-label="Cancel">✕</button>
            </div>
            <div class="ac-modal-body">
                @if (Opponents.Count == 0)
                {
                    <span class="ac-target-none">No opponents available.</span>
                }
                else
                {
                    @foreach (var opp in Opponents)
                    {
                        var target = opp;
                        <button type="button" class="ac-target-btn"
                                @onclick="() => OnTargetPicked(picker, target.Id)">
                            @target.Name
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>A possible Time Thief victim.</summary>
    public record ActionTarget(string Id, string Name);

    /// <summary>A request to play a card, optionally against a target (Time Thief).</summary>
    public record ActionPlayRequest(string CardId, string? TargetUserId);

    /// <summary>The cards currently in the player's hand.</summary>
    [Parameter] public IReadOnlyList<ActionCard> Cards { get; set; } = [];

    /// <summary>Opponents the player may target with Time Thief.</summary>
    [Parameter] public IReadOnlyList<ActionTarget> Opponents { get; set; } = [];

    /// <summary>When true, all cards are non-interactive.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The self-targeted action already queued for the next submission, if any.</summary>
    [Parameter] public ActionKind? QueuedKind { get; set; }

    /// <summary>Raised when the player commits to playing a card.</summary>
    [Parameter] public EventCallback<ActionPlayRequest> OnPlay { get; set; }

    /// <summary>The card whose target-picker modal is currently open, if any.</summary>
    private ActionCard? _pickerCard;

    /// <summary>
    /// Self-targeted cards (Pivot/Amnesty) play immediately; Time Thief opens the modal
    /// target-picker (a second click on the same card closes it).
    /// </summary>
    private async Task OnCardClicked(ActionCard card)
    {
        if (Disabled) return;

        if (card.Kind == ActionKind.TimeThief)
        {
            _pickerCard = _pickerCard == card ? null : card;
            return;
        }

        _pickerCard = null;
        await OnPlay.InvokeAsync(new ActionPlayRequest(card.Id, null));
    }

    private async Task OnTargetPicked(ActionCard card, string targetUserId)
    {
        _pickerCard = null;
        await OnPlay.InvokeAsync(new ActionPlayRequest(card.Id, targetUserId));
    }

    private void ClosePicker() => _pickerCard = null;
}
