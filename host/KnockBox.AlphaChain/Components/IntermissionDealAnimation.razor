@using KnockBox.AlphaChain.Services.Logic.Games.Data
@using KnockBox.AlphaChain.Services.Logic.Games.Data.Cards

@* Deal / Expansion sub-phase visuals. Deal reveals the local player's freshly-stocked
   hand; Expansion announces the +1 Engine Bay slot. Both are short, cosmetic dwells —
   the FSM drives the timing; this component only reflects the current sub-phase. *@

<div class="ac-im-deal">
    @if (SubPhase == IntermissionSubPhase.Expansion)
    {
        <h3 class="ac-im-deal-title">Engine Bay Expanded</h3>
        <p class="ac-im-deal-sub">Every Engine Bay gains a slot — now <strong>@Slots</strong>.</p>
        <div class="ac-im-slot-badge">+1 SLOT</div>
    }
    else
    {
        <h3 class="ac-im-deal-title">Dealing cards…</h3>
        <p class="ac-im-deal-sub">Stocking your Engine Bay and Action Hand for the next era.</p>
    }

    <div class="ac-im-deal-cards">
        @foreach (var card in Modifiers)
        {
            <CardTooltip Name="@card.Name" Description="@card.Description" Category="CardCategory.Modifier">
                <div class="ac-card ac-card-modifier ac-card-@(card.Kind == ModifierKind.Additive ? "additive" : "multiplicative")">
                    <span class="ac-card-name">@card.Name</span>
                    <span class="ac-card-op">@(card.Kind == ModifierKind.Additive ? "+" : "×")</span>
                </div>
            </CardTooltip>
        }
        @foreach (var card in Actions)
        {
            <CardTooltip Name="@card.Name" Description="@card.Description" Category="CardCategory.Action">
                <div class="ac-card ac-card-action">
                    <span class="ac-card-name">@card.Name</span>
                </div>
            </CardTooltip>
        }
    </div>
</div>

@code {
    /// <summary>The current sub-phase (Deal or Expansion) so the heading matches.</summary>
    [Parameter] public IntermissionSubPhase SubPhase { get; set; } = IntermissionSubPhase.Deal;

    /// <summary>The local player's modifier cards, revealed during the deal.</summary>
    [Parameter] public IReadOnlyList<ModifierCard> Modifiers { get; set; } = [];

    /// <summary>The local player's action cards, revealed during the deal.</summary>
    [Parameter] public IReadOnlyList<ActionCard> Actions { get; set; } = [];

    /// <summary>The local player's (post-expansion) slot count, shown in the expansion banner.</summary>
    [Parameter] public int Slots { get; set; }
}
