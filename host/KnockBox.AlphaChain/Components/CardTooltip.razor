@using KnockBox.AlphaChain.Services.Logic.Games.Data.Cards

@* Shared hover/focus tooltip for any card. Wraps arbitrary child content (the card
   chip) and shows the card's name, category, and description on hover or keyboard
   focus. Purely presentational — no state, no callbacks. *@

<span class="ac-card-tip" tabindex="0">
    @ChildContent
    <span class="ac-card-tip-popup" role="tooltip">
        <span class="ac-card-tip-name">@Name</span>
        <span class="ac-card-tip-category">@Category</span>
        <span class="ac-card-tip-desc">@Description</span>
    </span>
</span>

@code {
    /// <summary>The card chip (or any trigger element) the tooltip attaches to.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Card display name shown as the tooltip heading.</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary>Card rules text.</summary>
    [Parameter] public string Description { get; set; } = string.Empty;

    /// <summary>Which family the card belongs to (Modifier / Action), shown as a sub-label.</summary>
    [Parameter] public CardCategory Category { get; set; }
}
