@* A distinct inline SVG glyph per card, keyed by ModifierCard.Icon / ActionCard.Icon.
   Stroke uses currentColor so the parent (GameCard) can tint it to the card's category
   accent. Inline SVG (not static files) keeps icons working without per-plugin static-asset
   path wiring and lets them inherit color cleanly. *@

<svg class="gc-icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Icon)
    {
        case "anchor":
            <circle cx="12" cy="5" r="2.3" />
            <line x1="12" y1="7.3" x2="12" y2="20" />
            <line x1="8" y1="11" x2="16" y2="11" />
            <path d="M4 13a8 8 0 0 0 16 0" />
            break;

        case "consonant":
            @* Crunch — a jagged saw line. *@
            <polyline points="3,8 7,8 9.5,16 13,8 16,16 21,8" />
            break;

        case "wave":
            @* Vowel surge — a rolling wave. *@
            <path d="M3 13c2.2 0 2.2-5 4.5-5s2.3 5 4.5 5 2.2-5 4.5-5 2.3 5 4.5 5" />
            break;

        case "architect":
            @* Roof + crossbeam. *@
            <polyline points="4,18 12,5 20,18" />
            <line x1="7.2" y1="13" x2="16.8" y2="13" />
            break;

        case "brick":
            <rect x="3.5" y="6" width="17" height="12" rx="0.5" />
            <line x1="3.5" y1="12" x2="20.5" y2="12" />
            <line x1="12" y1="6" x2="12" y2="12" />
            <line x1="7.7" y1="12" x2="7.7" y2="18" />
            <line x1="16.3" y1="12" x2="16.3" y2="18" />
            break;

        case "sprinter":
            @* Lightning bolt — speed. *@
            <polygon points="13,2 6,13 11,13 10,22 18,9 12,9" />
            break;

        case "hoarder":
            @* Stacked coins. *@
            <ellipse cx="12" cy="7" rx="7" ry="2.6" />
            <path d="M5 7v4c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6V7" />
            <path d="M5 11v4c0 1.4 3.1 2.6 7 2.6s7-1.2 7-2.6v-4" />
            break;

        case "tax":
            @* Percent sign. *@
            <circle cx="7" cy="7" r="2.4" />
            <circle cx="17" cy="17" r="2.4" />
            <line x1="6" y1="18" x2="18" y2="6" />
            break;

        case "pivot":
            @* Refresh / redirect arrow. *@
            <path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3" />
            <polyline points="18,2.5 18,7 13.5,7" />
            break;

        case "amnesty":
            @* Shield with a check — protection. *@
            <path d="M12 3l7 3v4.6c0 4.8-3.4 7.7-7 8.9-3.6-1.2-7-4.1-7-8.9V6z" />
            <polyline points="8.8,12 11.2,14.4 15.4,9.6" />
            break;

        case "time-thief":
            @* Clock losing time — a minus by the dial. *@
            <circle cx="11" cy="13" r="7" />
            <polyline points="11,9 11,13 14,15" />
            <line x1="17" y1="4.5" x2="22" y2="4.5" />
            break;

        default:
            <circle cx="12" cy="12" r="6" />
            break;
    }
</svg>

@code {
    /// <summary>The card's icon key (see <c>ModifierCard.Icon</c> / <c>ActionCard.Icon</c>).</summary>
    [Parameter] public string? Icon { get; set; }
}
