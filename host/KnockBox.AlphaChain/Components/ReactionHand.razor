@using KnockBox.AlphaChain.Services.Logic.Games.Data.Cards

@* The player's reaction hand. Reactions are passive — they sit here and auto-fire on game
   events (see ReactionResolver); there is nothing to click. Each card states its own trigger,
   so the hand is purely informational. *@

<div class="ac-hand">
    <div class="ac-hand-header">
        <span class="ac-hand-title">Reaction Hand</span>
        <span class="ac-hand-sub">auto-fires</span>
    </div>

    @if (Cards.Count == 0)
    {
        <p class="ac-hand-empty">No reaction cards.</p>
    }
    else
    {
        <ul class="ac-hand-cards">
            @foreach (var card in Cards)
            {
                <li class="ac-hand-card-wrap">
                    <GameCard Name="@card.Name" Description="@card.Description" Icon="@card.Icon"
                              Category="CardCategory.Reaction" ReactionClass="card.Class" />
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>The reaction cards currently in the player's hand (display only).</summary>
    [Parameter] public IReadOnlyList<ReactionCard> Cards { get; set; } = [];
}
