<Project>

  <!--
    Shared MSBuild target for game-plugin projects.

    Imported by each plugin .csproj to publish build output into the host app's
    games/{TargetName}/ folder so the host can discover and load it at runtime.

    Each plugin is loaded into its own PluginLoadContext (ALC) at runtime, and
    that ALC uses an AssemblyDependencyResolver rooted at games/{TargetName}/
    to resolve transitive deps. In principle, any dep dropped into this folder
    alongside a matching {Plugin}.deps.json entry is resolvable.

    We still deliberately copy ONLY plugin-owned outputs, not the full
    $(TargetDir). Rationale:
      (a) Host-owned contracts (KnockBox.Core, logging/DI abstractions, BCL)
          are classified as shared at load time and deferred to the default
          ALC so type identity is preserved across the host/plugin boundary.
          Copies under games/{Plugin}/ for those assemblies are dead disk
          weight; they will never be loaded from there.
      (b) Current plugins have no host-unknown transitive deps. If a future
          plugin genuinely needs a private dep that the host does NOT ship,
          extend this targets file to include it explicitly; the ALC will
          pick it up via AssemblyDependencyResolver.

    Copies:
      1. The primary assembly, its PDB, and its deps.json.
      2. Static-web-assets manifests (if produced).
      3. The scoped-CSS bundle (if produced).
      4. The plugin's wwwroot assets (if present).
      5. plugin.json (the soft-sandbox manifest).
  -->

  <!--
    ReadyToRun (R2R) ahead-of-time compilation for every plugin. Activates
    only on Release publishes that supply a RuntimeIdentifier (matches the
    host's gating). Composite must stay false: a plugin loads into its own
    PluginLoadContext but defers KnockBox.Core/Platform/BCL to the default
    ALC. Composite-baking those into the plugin image would produce duplicate
    types and break ALC type identity across the host/plugin boundary.

    Plugins are not published as part of the host's normal publish chain
    (ReferenceOutputAssembly="false" only triggers Build); the host csproj
    has a PublishPluginProjects target that explicitly invokes Publish on
    each plugin so these properties take effect.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
  </PropertyGroup>

  <!--
    plugin.json is mandatory for every plugin project. Fail fast at build time
    if it's missing so the author sees the error before publish, not at host
    startup. Runs BEFORE Build so it short-circuits the rest of the build.
  -->
  <Target Name="ValidatePluginManifest" BeforeTargets="BeforeBuild;PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\plugin.json')"
           Text="Plugin project '$(MSBuildProjectName)' is missing required [plugin.json] in its project root. Every plugin must declare its identity and capabilities in plugin.json; see docs for the schema." />
  </Target>

  <!--
    Embed plugin.json into the assembly as a resource (so PluginManifest.FromEmbeddedResource
    can find it at runtime for cross-check against the on-disk copy) and stage
    a disk copy next to the DLL so the loader can read it before activating
    the assembly.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\plugin.json')">
    <EmbeddedResource Include="plugin.json">
      <LogicalName>plugin.json</LogicalName>
    </EmbeddedResource>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Wire the KnockBox sandbox-escape analyzer into every first-party plugin.
    OutputItemType="Analyzer" routes the analyzer DLL to the compiler's
    analyzer pipeline instead of the normal reference set;
    ReferenceOutputAssembly="false" keeps the plugin's runtime output clean
    (the analyzer only exists to produce warnings at build time). When the
    analyzer is shipped as a NuGet package, third-party plugin authors get
    the same behavior via a PackageReference with PrivateAssets="all".
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\sdk\KnockBox.Plugins.Analyzer\KnockBox.Plugins.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Mark this as a SERVER plugin for the gated WASM analyzers (KB1005–KB1008).
    CompilerVisibleProperty surfaces KnockBoxPluginKind to the analyzer config so
    the server projection rule KB1007 runs here while the client-only rules
    (KB1005/KB1006/KB1008) stay off.
  -->
  <PropertyGroup>
    <KnockBoxPluginKind>server</KnockBoxPluginKind>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="KnockBoxPluginKind" />
  </ItemGroup>

  <Target Name="PublishPlugin" AfterTargets="Build">
    <Message Text="Publishing plugin $(TargetName) to KnockBox app..." Importance="high" />
    <PropertyGroup>
      <!--
        Anchor on $(MSBuildThisFileDirectory) (the repo root, since this
        targets file lives there) instead of $(SolutionDir). The latter is
        undefined when dotnet publish is invoked on a single .csproj without
        a solution context.
      -->
      <PluginDestDir>$(MSBuildThisFileDirectory)KnockBox\bin\$(Configuration)\$(TargetFramework)\games\$(TargetName)\</PluginDestDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginPrimary Include="$(TargetDir)$(TargetName).dll" />
      <PluginPrimary Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <PluginPrimary Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
      <PluginPrimary Include="$(TargetDir)plugin.json" Condition="Exists('$(TargetDir)plugin.json')" />
      <PluginPrimary Include="$(TargetDir)$(TargetName).staticwebassets.endpoints.json"
                     Condition="Exists('$(TargetDir)$(TargetName).staticwebassets.endpoints.json')" />
      <PluginPrimary Include="$(TargetDir)$(TargetName).staticwebassets.runtime.json"
                     Condition="Exists('$(TargetDir)$(TargetName).staticwebassets.runtime.json')" />
      <PluginPrimary Include="$(TargetDir)KnockBox.Tooling.dll" Condition="Exists('$(TargetDir)KnockBox.Tooling.dll')" />
      <PluginPrimary Include="$(TargetDir)KnockBox.Tooling.pdb" Condition="Exists('$(TargetDir)KnockBox.Tooling.pdb')" />
      <ScopedCss Include="$(IntermediateOutputPath)scopedcss\projectbundle\$(TargetName).bundle.scp.css" />
      <WwwRootFiles Include="wwwroot\**\*.*" />
      <PluginContentFiles Include="$(TargetDir)**\*.csv" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPrimary)"
          DestinationFolder="$(PluginDestDir)" />
    <Copy SourceFiles="@(PluginContentFiles)"
          DestinationFolder="$(PluginDestDir)%(RecursiveDir)"
          Condition="'@(PluginContentFiles)' != ''" />
    <Copy SourceFiles="@(ScopedCss)"
          DestinationFiles="$(PluginDestDir)wwwroot\$(TargetName).styles.css"
          Condition="Exists('@(ScopedCss)')" />
    <Copy SourceFiles="@(WwwRootFiles)"
          DestinationFolder="$(PluginDestDir)wwwroot\%(RecursiveDir)"
          Condition="'@(WwwRootFiles)' != ''" />
  </Target>

  <!--
    Re-stage the R2R-compiled DLL and (RID-qualified) deps.json over the IL
    versions that PublishPlugin (AfterTargets="Build") wrote earlier. Only the
    DLL and deps.json change between Build and Publish under R2R; the rest of
    the staged artifacts (PDB, plugin.json, scoped CSS, staticwebassets,
    wwwroot, KnockBox.Tooling.*) are identical and don't need re-copying.

    This target only fires when the plugin is being published (the host's
    PublishPluginProjects target invokes that during the host's Publish).
  -->
  <Target Name="PublishPluginAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <PluginDestDir>$(MSBuildThisFileDirectory)KnockBox\bin\$(Configuration)\$(TargetFramework)\games\$(TargetName)\</PluginDestDir>
    </PropertyGroup>
    <ItemGroup>
      <PluginPublishedPrimary Include="$(PublishDir)$(TargetName).dll" />
      <PluginPublishedPrimary Include="$(PublishDir)$(TargetName).deps.json"
                              Condition="Exists('$(PublishDir)$(TargetName).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginPublishedPrimary)"
          DestinationFolder="$(PluginDestDir)"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
