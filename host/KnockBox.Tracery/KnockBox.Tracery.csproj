<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <!--
      Reference the word-service contracts assembly so Tracery can inject
      IWordListService (to build its dictionary trie) at compile time. The runtime
      resolves the interface via the host's DI container; the implementation lives in
      the sibling KnockBox.WordService library plugin, loaded before any game plugin.
    -->
    <ProjectReference Include="..\KnockBox.WordService.Contracts\KnockBox.WordService.Contracts.csproj" />
    <!-- Shared contract DTOs for the tri-split (the projected view, command payloads, and the
         moved gameplay types: Grid, TracedWord, the mode/phase enums, reveal/round records). -->
    <ProjectReference Include="..\KnockBox.Tracery.Contracts\KnockBox.Tracery.Contracts.csproj" />
  </ItemGroup>

  <!-- The Contracts DLL is a PRIVATE ALC dependency (not promoted to the default ALC). It must be
       staged into games/KnockBox.Tracery/ or the plugin's load context throws FileNotFoundException
       and the loader silently skips the whole plugin (the tile vanishes). -->
  <ItemGroup>
    <PluginPrivateAssembly Include="$(TargetDir)KnockBox.Tracery.Contracts.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="KnockBox.Tracery.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnockBox.TraceryTests" />
  </ItemGroup>

  <Import Project="..\Directory.Plugin.targets" />

</Project>
