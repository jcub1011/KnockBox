@page "/room/tracery/{ObfuscatedRoomCode}"

@inherits LobbyPageBase<TraceryGameState>
@using KnockBox.Tracery.Services.State.Games

<PageTitle>Tracery</PageTitle>

<HeadContent>
    <link href="_content/KnockBox.Tracery/KnockBox.Tracery.styles.css" rel="stylesheet" />
</HeadContent>

<div class="content">
    @if (GameState == null)
    {
        <div>Loading...</div>
    }
    else if (GameState.IsJoinable)
    {
        <div class="card">
            <h4>Players</h4>
            <div class="player-list">
                @foreach (var entry in GameState.Players)
                {
                    <button class="btn" title="Click to kick player."
                            @onclick="() => GameState.KickPlayer(UserService.CurrentUser!, entry.User)">
                        @entry.DisplayName @(entry.User.Id == GameState.Host.Id ? "(Host)" : "")
                    </button>
                }
            </div>
            @if (UserService.CurrentUser?.Id == GameState.Host.Id)
            {
                <button class="btn btn-primary start-btn mt-3" @onclick="StartGame">Start Session</button>
            }
        </div>
    }
    else
    {
        <div class="card">
            <h4>Game in progress</h4>
            <p>Tracery placeholder lobby — game logic coming soon.</p>
        </div>
    }
</div>
