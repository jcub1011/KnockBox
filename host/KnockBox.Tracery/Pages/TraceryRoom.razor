@page "/room/tracery/{ObfuscatedRoomCode}"
@inherits LobbyPageBase<TraceryGameState>

<PageTitle>Tracery</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="_content/KnockBox.Tracery/css/tracery-theme.css" rel="stylesheet" />
    <link href="_content/KnockBox.Tracery/KnockBox.Tracery.styles.css" rel="stylesheet" />
</HeadContent>

@if (GameState is null || UserService.CurrentUser is null)
{
    <div class="tr-loading">Loading…</div>
}
else
{
    <div class="tr-page">
        @switch (GameState.Phase)
        {
            case GamePhase.Lobby:
                <TraceryLobbyView State="GameState" RoomCode="@RoomCode" />
                break;

            case GamePhase.RoundIntro:
                <div class="tr-stage tr-intro">
                    <span class="tr-intro-label">ROUND</span>
                    <span class="tr-intro-number">@((GameState.CurrentRound + 1).ToString("00")) <span class="tr-intro-of">/ @GameState.Settings.TotalRounds.ToString("00")</span></span>
                    <span class="tr-intro-getready">GET READY</span>
                    <TraceryRoundTimer State="GameState" Duration="GameState.Settings.TransitionDuration" />
                </div>
                break;

            case GamePhase.Playing:
                <div class="tr-stage tr-playing">
                    <div class="tr-playing-head">
                        <span class="tr-playing-round">Round @GameState.CurrentRound / @GameState.Settings.TotalRounds</span>
                        <TraceryRoundTimer State="GameState" Duration="GameState.Settings.RoundTimer" />
                    </div>
                    @if (IsHostObserver)
                    {
                        <TraceryHostGridView State="GameState" />
                    }
                    else
                    {
                        <div class="tr-play-body">
                            <p class="tr-muted tr-play-hint">Drag or tap touching tiles — min @GameState.Settings.MinWordLength letters.</p>
                            <div class="tr-play-layout">
                                <div class="tr-bank">
                                    <div class="tr-bank-head">
                                        <span class="tr-bank-label">FOUND</span>
                                        <span class="tr-bank-total" title="Round score so far (provisional)">@ProvisionalRoundScore</span>
                                    </div>
                                    <div class="tr-bank-list">
                                        @foreach (var entry in ScoredBankedWords())
                                        {
                                            <div class="tr-bank-word" @key="entry.Word">
                                                <span class="tr-bank-word-text">@entry.Word.ToUpperInvariant()</span>
                                                <span class="tr-bank-word-pts">+@entry.Points</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <TraceryGrid Grid="GameState.CurrentGrid"
                                             IsActive="GameState.IsRoundActive"
                                             Invalid="_invalidTrace"
                                             OnPathSubmitted="HandlePathSubmitted" />
                            </div>
                        </div>
                    }
                    <TraceryToast Message="@_toastMessage" Tone="_toastTone" />
                </div>
                break;

            case GamePhase.Reveal:
                <TraceryRevealView State="GameState" CurrentUserId="@UserService.CurrentUser?.Id" OnSkip="HandleSkipReveal" />
                break;

            case GamePhase.FinalStandings:
                <TraceryFinalStandingsView State="GameState" />
                break;
        }
    </div>
}
