@* The reveal screen (GDD §7) — the round's social payoff. A pure renderer of the pre-assembled
   RevealData on the state; it never recomputes scores or re-solves the board. Beats that don't
   exist (e.g. an empty round) are simply skipped. v1 shows every beat at once; staggering the
   beats over time is a later polish (the data is already ordered for that). *@

@if (Reveal is null)
{
    <div class="tr-stage tr-reveal">
        <span class="tr-reveal-title">THE REVEAL</span>
        <p class="tr-muted">Tallying the round…</p>
        <TraceryRoundTimer State="State" Duration="State.Settings.TransitionDuration" />
    </div>
}
else
{
    <div class="tr-stage tr-reveal">
        <span class="tr-reveal-title">THE REVEAL</span>

        <div class="tr-reveal-beats">
            @if (Reveal.LongestWord is { } longest)
            {
                <div class="tr-beat tr-beat-longest">
                    <span class="tr-beat-label">LONGEST WORD</span>
                    <span class="tr-beat-word">@longest.Word.ToUpperInvariant()</span>
                    <span class="tr-beat-meta">@longest.Length letters · @FindersText(longest.Finders)</span>
                </div>
            }

            @if (Reveal.HighestScoringWord is { } top)
            {
                <div class="tr-beat tr-beat-top">
                    <span class="tr-beat-label">HIGHEST-SCORING WORD</span>
                    <span class="tr-beat-word">@top.Word.ToUpperInvariant()</span>
                    <span class="tr-beat-meta">
                        @top.Points pts@(top.IsUnique ? " · UNIQUE" : "") · @FindersText(top.Finders)
                    </span>
                </div>
            }

            @if (Reveal.RarestLetters.Length > 0)
            {
                <div class="tr-beat tr-beat-rare">
                    <span class="tr-beat-label">RAREST LETTERS USED</span>
                    <div class="tr-beat-rare-list">
                        @foreach (var rare in Reveal.RarestLetters)
                        {
                            <span class="tr-rare-chip" title="@rare.ExampleWord.ToUpperInvariant()">
                                <span class="tr-rare-letter">@rare.Letter</span>
                                <span class="tr-rare-bonus">+@rare.BonusValue</span>
                            </span>
                        }
                    </div>
                </div>
            }

            @if (Reveal.WordsNobodyFound.Length > 0)
            {
                <div class="tr-beat tr-beat-missed">
                    <span class="tr-beat-label">NOBODY FOUND</span>
                    <div class="tr-beat-missed-list">
                        @foreach (var missed in Reveal.WordsNobodyFound)
                        {
                            <span class="tr-missed-chip">
                                <span class="tr-missed-word">@missed.Word.ToUpperInvariant()</span>
                                <span class="tr-missed-score">@missed.WouldBeScore</span>
                            </span>
                        }
                    </div>
                </div>
            }

            @if (Reveal.TheoreticalMax is { } max)
            {
                <div class="tr-beat tr-beat-max">
                    <span class="tr-beat-label">THEORETICAL MAX</span>
                    <span class="tr-beat-word">@max</span>
                    <span class="tr-beat-meta">if one player banked the whole board</span>
                </div>
            }
        </div>

        @if (Reveal.Standings.Length > 0)
        {
            <div class="tr-over-board">
                @foreach (var row in Reveal.Standings)
                {
                    <div class="tr-over-row">
                        <span class="tr-over-name">@row.DisplayName</span>
                        <span class="tr-over-delta">+@row.RoundPoints</span>
                        <span class="tr-over-score">@row.CumulativeScore</span>
                    </div>
                }
            </div>
        }

        <TraceryRoundTimer State="State" Duration="State.Settings.TransitionDuration" />
    </div>
}

@code {
    [Parameter, EditorRequired] public TraceryGameState State { get; set; } = default!;

    private RevealData? Reveal => State.CurrentReveal;

    private static string FindersText(System.Collections.Immutable.ImmutableArray<string> finders)
        => finders.Length switch
        {
            0 => "—",
            1 => finders[0],
            2 => $"{finders[0]} & {finders[1]}",
            _ => $"{finders[0]} +{finders.Length - 1} more",
        };
}
