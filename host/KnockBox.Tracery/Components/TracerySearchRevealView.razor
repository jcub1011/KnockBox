@* Search-mode reveal: the round's finishing order. Completers are listed first by placement (with
   their bonus), then anyone who didn't finish the list. A pure renderer of the latest RoundResult —
   it never recomputes scores. Mirrors TraceryRevealView's stage chrome (title, timer, host skip). *@

<div class="tr-stage tr-reveal">
    <span class="tr-reveal-title">THE RESULTS</span>

    @if (Outcomes.Count == 0)
    {
        <p class="tr-muted">Tallying the round…</p>
    }
    else
    {
        <div class="tr-results">
            @foreach (var row in Outcomes)
            {
                var isYou = row.UserId == CurrentUserId;
                <div class="tr-result-row @(isYou ? "is-you" : null) @(row.CompletionRank is null ? "is-dnf" : null)">
                    <span class="tr-result-place">
                        @(row.CompletionRank is int rank ? Ordinal(rank) : "—")
                    </span>
                    <span class="tr-result-name">@row.DisplayName@(isYou ? " (you)" : "")</span>
                    <span class="tr-result-detail">
                        @row.WordsFound / @row.SearchListSize found
                        @if (row.CompletionBonus > 0)
                        {
                            <span class="tr-result-bonus">+@row.CompletionBonus bonus</span>
                        }
                    </span>
                    <span class="tr-result-delta">+@row.PointsAwarded</span>
                    <span class="tr-result-total">@row.CumulativeScore</span>
                </div>
            }
        </div>
    }

    @if (State.CurrentGrid is not null)
    {
        <div class="tr-reveal-explorer">
            <span class="tr-reveal-subtitle">THE BOARD</span>
            <TraceryBoardExplorer State="State" CurrentUserId="@CurrentUserId" />
        </div>
    }

    @if (State.CurrentRound < State.Settings.TotalRounds)
    {
        <span class="tr-reveal-next">NEXT · ROUND @((State.CurrentRound + 1).ToString("00")) / @State.Settings.TotalRounds.ToString("00")</span>
    }
    else
    {
        <span class="tr-reveal-next">FINAL STANDINGS NEXT</span>
    }

    <TraceryRoundTimer State="State" Duration="State.Settings.IntermissionDuration" />

    @if (IsHost)
    {
        <button type="button" class="tr-btn tr-reveal-skip" @onclick="OnSkip">
            @(State.CurrentRound < State.Settings.TotalRounds ? "Skip to next round" : "Skip to standings") →
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public TraceryGameState State { get; set; } = default!;

    /// <summary>The viewer's user id, used to highlight their row.</summary>
    [Parameter] public Guid? CurrentUserId { get; set; }

    /// <summary>Invoked when the host skips the remaining intermission. Host-only in the UI.</summary>
    [Parameter] public EventCallback OnSkip { get; set; }

    private bool IsHost => CurrentUserId is not null && CurrentUserId == State.Host.Id;

    // Completers first, ordered by finishing place; non-completers after, richest round first.
    private IReadOnlyList<TraceryPlayerRoundOutcome> Outcomes =>
        State.RoundResults.IsEmpty
            ? []
            : [.. State.RoundResults[^1].Outcomes
                .OrderBy(o => o.CompletionRank ?? int.MaxValue)
                .ThenByDescending(o => o.PointsAwarded)];

    private static string Ordinal(int n)
    {
        string suffix = (n % 100) is >= 11 and <= 13
            ? "th"
            : (n % 10) switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };
        return $"{n}{suffix}";
    }
}
