@* The host-observer view during Playing (GDD §2, §7): the shared grid the whole room is racing
   on, plus a live standings rail that updates as players bank (the room page re-renders on every
   StateChangedEventManager notification). Scores are last-locked cumulative totals — per-round
   points are only resolved at round close — so the live signal here is each player's banked count. *@

<div class="tr-host">
    <div class="tr-host-board">
        <TraceryGrid Grid="State.CurrentGrid" IsActive="false" />
    </div>

    <aside class="tr-host-rail">
        @if (IsSearch)
        {
            <div class="tr-host-rail-head">
                <span class="tr-host-rail-label">FIND THESE</span>
                <span class="tr-host-rail-sub">@State.SearchList.Length words</span>
            </div>
            <div class="tr-host-searchwords">
                @foreach (var word in State.SearchList)
                {
                    <span class="tr-host-searchword">@word.ToUpperInvariant()</span>
                }
            </div>
        }
        <div class="tr-host-rail-head">
            <span class="tr-host-rail-label">STANDINGS</span>
            <span class="tr-host-rail-sub">@(IsSearch ? "found this round" : "banked this round")</span>
        </div>
        <div class="tr-host-standings">
            @foreach (var row in LiveStandings())
            {
                <div class="tr-host-row">
                    <span class="tr-host-name">@row.DisplayName</span>
                    <span class="tr-host-banked">@(IsSearch ? $"{row.Banked}/{State.SearchList.Length}" : row.Banked.ToString())</span>
                    <span class="tr-host-score">@row.Cumulative</span>
                </div>
            }
        </div>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public TraceryGameState State { get; set; } = default!;

    private bool IsSearch => State.Settings.Mode == GameMode.Search;

    /// <summary>
    /// The frozen participant roster with each player's live banked-word count this round and
    /// their cumulative score, richest first then most-banked. Reads the start-of-match snapshot
    /// so a disconnected player still holds their spot.
    /// </summary>
    private IEnumerable<(string DisplayName, int Banked, int Cumulative)> LiveStandings()
        => State.Participants
            .Select(entry =>
            {
                var hasState = State.PlayerStates.TryGetValue(entry.User.Id, out var ps);
                return (
                    entry.DisplayName,
                    Banked: hasState ? ps!.BankedWords.Count : 0,
                    Cumulative: hasState ? ps!.CumulativeScore : 0);
            })
            .OrderByDescending(x => x.Cumulative)
            .ThenByDescending(x => x.Banked)
            .ThenBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase);
}
