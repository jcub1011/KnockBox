<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared contract DTOs for the KnockBox.Operator tri-split game: the pure data types
    both runtimes need (card/operator/action enums, the per-card CardView with its
    server-computed play affordances, settings, the per-player view the server projects
    back, and the commands the browser UI sends). This assembly loads in BOTH runtimes —
    compiled against by the server plugin AND streamed to the browser alongside the
    client UI — so both sides bind the same CLR types.

    CRITICAL: this project has ZERO KnockBox.* references and imports no plugin targets
    (mirrors KnockBox.CardCounter.Contracts / KnockBox.WordService.Contracts). It is pure
    DTOs/enums only. Source-generated JSON keeps the DTOs trim-safe in the WASM client.

    NOTE: the enums live in the KnockBox.Operator.Models namespace (not .Contracts) on
    purpose — the server plugin's pervasive `using KnockBox.Operator.Models;` then rebinds
    to these types with zero churn once the originals are removed from the server project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Shared contract DTOs for the KnockBox.Operator tri-split game.</Description>
  </PropertyGroup>

</Project>
