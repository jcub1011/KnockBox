@implements IDisposable
@*
    Playing phase — the full table UI (overlays, host-spectator vs. player fork, hand,
    reorder, target/skim/not-my-money selection, operator toasts), re-expressed against the
    projected CardCounterView. Opponent hands are never present in the view (only counts);
    the recipient's own hand/private-reveal are.
*@

@{
    var myId = View.RecipientId;
    var myPlayer = View.Players.FirstOrDefault(p => p.PlayerId == myId);
    var myHand = myPlayer?.ActionHand ?? (IReadOnlyList<ActionCard>)[];
    var activeId = View.CurrentPlayerId ?? Guid.Empty;
    var isSharedDisplay = IsSharedDisplay();
    var allPlayers = View.Players;
    var leaderboardRanked = View.Settings.FlipWinCondition
        ? View.Players.OrderByDescending(p => Math.Abs(p.Balance)).ToList()
        : View.Players.OrderBy(p => Math.Abs(p.Balance)).ToList();
}

@* ══ SHARED OVERLAYS (host + player) ════════════════════════════════════════ *@

@* ── Discard Overlay ── *@
@if (myPlayer != null && IsOverHandLimit())
{
    <div class="cc-discard-overlay">
        <div class="cc-discard-panel">
            <h3 class="cc-discard-title">⚠️ TOO MANY CARDS</h3>
            <p class="cc-discard-subtitle">
                You have <strong>@myHand.Count</strong> cards
                (limit: <strong>@View.Settings.ActionHandLimit</strong>).
                Select <strong>@DiscardNeeded()</strong> card(s) to discard.
            </p>
            <div class="cc-discard-hand">
                @for (int i = 0; i < myHand.Count; i++)
                {
                    var idx = i;
                    var card = myHand[i];
                    bool isSelectedDiscard = _selectedDiscardIndices.Contains(idx);
                    <div class="cc-action-card @CardDisplay.GetActionCardColor(card.Action) @(isSelectedDiscard ? "cc-card-discard-selected" : "")"
                         title="@CardDisplay.GetActionCardDescription(card.Action)"
                         @onclick="() => ToggleDiscardSelection(idx)">
                        <div class="cc-card-corner cc-card-corner-tl">
                            <span class="cc-card-suit">@CardDisplay.GetActionCardIcon(card.Action)</span>
                        </div>
                        <div class="cc-card-center-icon">@CardDisplay.GetActionCardIcon(card.Action)</div>
                        <div class="cc-card-name-label">@CardDisplay.GetActionCardName(card.Action)</div>
                        <div class="cc-card-corner cc-card-corner-br">
                            <span class="cc-card-suit cc-card-suit-flipped">@CardDisplay.GetActionCardIcon(card.Action)</span>
                        </div>
                        @if (isSelectedDiscard)
                        {
                            <div class="cc-card-discard-mark">✕</div>
                        }
                    </div>
                }
            </div>
            <button class="cc-btn cc-btn-danger cc-btn-lg"
                    disabled="@(!CanConfirmDiscard())"
                    @onclick="ConfirmDiscard">
                🗑️ DISCARD SELECTED (@_selectedDiscardIndices.Count / @DiscardNeeded() needed)
            </button>
        </div>
    </div>
}
else if (View.Players.Any(p => p.ActionHandCount > View.Settings.ActionHandLimit))
{
    <div class="cc-discard-overlay">
        <div class="cc-discard-panel">
            <h3 class="cc-discard-title">⏳ WAITING ON OTHER PLAYERS</h3>
            <p class="cc-discard-subtitle">Waiting for all players to finish discarding their action cards.</p>
        </div>
    </div>
}

@* ── Discard History Overlay ── *@
@if (_showDiscardOverlay)
{
    <div class="cc-discard-history-overlay" @onclick="ToggleDiscardOverlay">
        <div class="cc-discard-history-panel" @onclick:stopPropagation="true">
            <div class="cc-discard-history-header">
                <span class="cc-discard-history-title">📋 DISCARD PILE HISTORY</span>
                <button class="cc-btn cc-btn-ghost cc-btn-sm" @onclick="ToggleDiscardOverlay">✕ Close</button>
            </div>
            @if (View.DiscardHistory.Count == 0)
            {
                <div class="cc-discard-history-empty">No cards discarded yet.</div>
            }
            else
            {
                <div class="cc-discard-history-list">
                    @for (int i = View.DiscardHistory.Count - 1; i >= 0; i--)
                    {
                        var entry = View.DiscardHistory[i];
                        <div class="cc-discard-history-entry @(entry.IsActionCard ? "cc-history-action" : "cc-history-draw")">
                            <span class="cc-history-value">@entry.Description</span>
                            <div class="cc-history-info">
                                @if (entry.PlayerName != null)
                                {
                                    <span class="cc-history-player">by @entry.PlayerName</span>
                                }
                            </div>
                            <span class="cc-history-badge @(entry.IsActionCard ? "cc-badge-action" : "cc-badge-draw")">
                                @(entry.IsActionCard ? "ACTION" : "DRAW")
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@* ── Shoe Transition Animation ── *@
@if (IsAnimatingShoe)
{
    <div class="cc-shoe-animation-overlay">
        <div class="cc-shoe-animation-content">
            <div class="cc-shoe-anim-cards">
                <span class="cc-shoe-anim-card cc-shoe-anim-card-1">🂠</span>
                <span class="cc-shoe-anim-card cc-shoe-anim-card-2">🂠</span>
                <span class="cc-shoe-anim-card cc-shoe-anim-card-3">🂠</span>
                <span class="cc-shoe-anim-card cc-shoe-anim-card-4">🂠</span>
                <span class="cc-shoe-anim-card cc-shoe-anim-card-5">🂠</span>
            </div>
            <div class="cc-shoe-anim-text">
                <span class="cc-shoe-anim-title">NEW SHOE BEING DEALT</span>
                <span class="cc-shoe-anim-subtitle">♠ Shoe #@View.ShoeIndex — Action Cards Distributed ♥</span>
                <span class="cc-shoe-anim-subtitle"><b>Numbers:</b> @ShoeCount("Number")</span>
                <span class="cc-shoe-anim-subtitle"><b>Operators:</b> @ShoeCount("Operator")</span>
            </div>
        </div>
    </div>
}

@* ── Reaction Overlay ── *@
@if ((myPlayer != null && (View.FeelingLuckyTargetId == myId || (View.PendingReaction is { TargetId: var targetId } && targetId == myId))) || (isSharedDisplay && (View.FeelingLuckyTargetId != null || View.PendingReaction != null)))
{
    bool isAnyFeelingLucky = View.FeelingLuckyTargetId != null;
    bool isAnyPendingReaction = View.PendingReaction != null;
    bool isMyReaction = myPlayer != null && (View.FeelingLuckyTargetId == myId || (View.PendingReaction is { TargetId: var targetId2 } && targetId2 == myId));

    bool isFeelingLucky = isAnyFeelingLucky;
    bool isPendingReaction = !isFeelingLucky && isAnyPendingReaction;
    bool isSkim = isPendingReaction && View.PendingReaction?.PlayedCard.Action == ActionType.Skim;

    Guid sourceId = isFeelingLucky
        ? (View.ForceDrawTopId ?? View.LastPlayedAction?.PlayerId ?? Guid.Empty)
        : (View.PendingReaction?.SourceId ?? Guid.Empty);

    Guid theTargetId = isFeelingLucky ? (View.FeelingLuckyTargetId ?? Guid.Empty) : (View.PendingReaction?.TargetId ?? Guid.Empty);

    var sourcePlayer = View.Players.FirstOrDefault(p => p.PlayerId == sourceId);
    var targetPlayer = View.Players.FirstOrDefault(p => p.PlayerId == theTargetId);

    var actionName = isFeelingLucky ? "Feeling Lucky" : CardDisplay.GetActionCardName(View.PendingReaction!.PlayedCard.Action);
    if (isPendingReaction && View.PendingReaction?.PlayedCard.Action == ActionType.NotMyMoney && View.Settings.ShowMakeMyMoneyOperator && View.PendingReaction?.NotMyMoneyOperator is { } op)
    {
        actionName += $" [{CardDisplay.GetOperatorSymbol(op)}]";
    }
    var isNotMyMoney = isPendingReaction && View.PendingReaction?.PlayedCard.Action == ActionType.NotMyMoney;
    var icon = isFeelingLucky ? "🎲" : (isSkim ? "✂️" : (isNotMyMoney ? "💸" : "⚔️"));
    var attackTitle = isFeelingLucky ? "🎲 FEELING LUCKY! 🎲" : (isSkim ? "✂️ SKIM ATTACK ✂️" : (isNotMyMoney ? "💸 NOT MY MONEY 💸" : "⚔️ INCOMING ATTACK ⚔️"));

    var compdOption = isMyReaction && myPlayer != null ? myHand
        .Select((card, index) => new { Card = card, Index = index })
        .FirstOrDefault(x => x.Card.Action == ActionType.Compd || (isFeelingLucky && x.Card.Action == ActionType.FeelingLucky)) : null;

    <div class="cc-reaction-overlay">
        <div class="cc-reaction-panel">
            <h3 class="cc-reaction-title">@attackTitle</h3>

            <div class="cc-reaction-subtitle">
                <strong>@(sourcePlayer?.DisplayName ?? "Someone")</strong> played <strong>@actionName</strong> on <strong>@(isMyReaction ? "you" : (targetPlayer?.DisplayName ?? "Someone"))</strong>!
            </div>

            <div class="cc-reaction-actors">
                @if (sourcePlayer != null)
                {
                    <div class="cc-reaction-actor-col">
                        <h4 class="cc-reaction-actor-title-attacker">Attacker</h4>
                        <div class="cc-opponent-card cc-opponent-active cc-reaction-actor-card">
                            <div class="cc-opp-header">
                                <span class="cc-opp-name">@sourcePlayer.DisplayName</span>
                            </div>
                            <div class="cc-opp-stats">
                                <div class="cc-opp-stat"><span class="cc-stat-icon">💰</span><span class="cc-stat-val @(sourcePlayer.Balance >= 0 ? "cc-positive" : "cc-negative")">@sourcePlayer.Balance.FormatBalance()</span></div>
                                <div class="cc-opp-stat"><span class="cc-stat-icon">🎰</span><span class="cc-stat-val">
                                    @if (isSkim && View.PendingReaction?.SourceDigitIndex is int sdi && sourcePlayer.Pot.Count > 0)
                                    {
                                        @for (int i = 0; i < sourcePlayer.Pot.Count; i++)
                                        {
                                            if (i == sdi) { <span class="cc-skim-highlight">@sourcePlayer.Pot[i]</span> }
                                            else { @sourcePlayer.Pot[i] }
                                        }
                                    }
                                    else
                                    {
                                        @sourcePlayer.PotValue
                                    }
                                </span></div>
                            </div>
                        </div>
                    </div>
                }

                <div class="cc-reaction-icon">@icon</div>

                @if (targetPlayer != null)
                {
                    <div class="cc-reaction-actor-col">
                        <h4 class="cc-reaction-actor-title-target">Target @(isMyReaction ? "(You)" : "")</h4>
                        <div class="cc-opponent-card cc-opponent-targeted cc-reaction-actor-card">
                            <div class="cc-opp-header">
                                <span class="cc-opp-name">@targetPlayer.DisplayName</span>
                            </div>
                            <div class="cc-opp-stats">
                                <div class="cc-opp-stat"><span class="cc-stat-icon">💰</span><span class="cc-stat-val @(targetPlayer.Balance >= 0 ? "cc-positive" : "cc-negative")">@targetPlayer.Balance.FormatBalance()</span></div>
                                <div class="cc-opp-stat"><span class="cc-stat-icon">🎰</span><span class="cc-stat-val">
                                    @if (isSkim && View.PendingReaction?.TargetDigitIndex is int tdi && targetPlayer.Pot.Count > 0)
                                    {
                                        @for (int i = 0; i < targetPlayer.Pot.Count; i++)
                                        {
                                            if (i == tdi) { <span class="cc-skim-highlight">@targetPlayer.Pot[i]</span> }
                                            else { @targetPlayer.Pot[i] }
                                        }
                                    }
                                    else
                                    {
                                        @targetPlayer.PotValue
                                    }
                                </span></div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (isMyReaction)
            {
                <div class="cc-reaction-options">
                    @if (compdOption != null)
                    {
                        <div class="cc-reaction-option-col">
                            <span class="cc-reaction-play-label">Play to @(isFeelingLucky ? "Block/Chain" : "Block"):</span>
                            <div class="cc-reaction-card-wrap">
                                <div class="cc-action-card @CardDisplay.GetActionCardColor(compdOption.Card.Action)"
                                     @onclick="() => OnActionCardClick(compdOption.Index)">
                                    <div class="cc-card-corner cc-card-corner-tl"><span class="cc-card-suit">@CardDisplay.GetActionCardIcon(compdOption.Card.Action)</span></div>
                                    <div class="cc-card-center-icon">@CardDisplay.GetActionCardIcon(compdOption.Card.Action)</div>
                                    <div class="cc-card-name-label">@CardDisplay.GetActionCardName(compdOption.Card.Action)</div>
                                    <div class="cc-card-corner cc-card-corner-br"><span class="cc-card-suit cc-card-suit-flipped">@CardDisplay.GetActionCardIcon(compdOption.Card.Action)</span></div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cc-reaction-no-card">(You do not have a card to play)</div>
                    }

                    <div class="cc-reaction-accept-col">
                        @if (isSkim && View.PendingReaction?.SourceDigitIndex == null)
                        {
                            <span class="cc-reaction-accept-hint">or wait for them to select digits...</span>
                        }
                        <button class="cc-btn cc-btn-danger cc-btn-lg cc-reaction-accept-btn"
                                @onclick="@(() => isFeelingLucky ? DrawCard() : AcceptPending())">
                            @(isFeelingLucky ? "Accept (Draw)" : "Accept Effect")
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="cc-reaction-options">
                    <div class="cc-reaction-no-card">Waiting for reaction...</div>
                </div>
            }
        </div>
    </div>
}

@* ── Skim Digit Selection ── *@
@if (IsInSkimDigitSelect() && View.PendingReaction is { } skimSrc)
{
    var srcPlayer = myPlayer;
    var tgtPlayer = View.Players.FirstOrDefault(p => p.PlayerId == skimSrc.TargetId);
    <div class="cc-skim-select-overlay">
        <div class="cc-skim-select-panel">
            <h3 class="cc-skim-title">✂️ SKIM — Select Digits to Swap</h3>
            @if (srcPlayer != null && tgtPlayer != null)
            {
                <div class="cc-skim-pots">
                    <div class="cc-skim-pot-area">
                        <div class="cc-skim-pot-label">Your pot — select digit to give:</div>
                        <div class="cc-skim-digits">
                            @for (int i = 0; i < srcPlayer.Pot.Count; i++)
                            {
                                var di = i;
                                bool sel = _pendingSkimSourceDigit == di || skimSrc.SourceDigitIndex == di;
                                <button class="cc-skim-digit @(sel ? "cc-skim-digit-selected" : "")"
                                        disabled="@(skimSrc.SourceDigitIndex != null)"
                                        @onclick="() => SelectSkimSourceDigit(di)">
                                    @srcPlayer.Pot[di]
                                </button>
                            }
                        </div>
                    </div>
                    <div class="cc-skim-swap-icon">⇌</div>
                    <div class="cc-skim-pot-area">
                        <div class="cc-skim-pot-label">@tgtPlayer.DisplayName's pot — select digit to receive:</div>
                        <div class="cc-skim-digits">
                            @for (int i = 0; i < tgtPlayer.Pot.Count; i++)
                            {
                                var di = i;
                                bool sel = _pendingSkimTargetDigit == di || skimSrc.TargetDigitIndex == di;
                                <button class="cc-skim-digit @(sel ? "cc-skim-digit-selected" : "")"
                                        disabled="@(skimSrc.TargetDigitIndex != null)"
                                        @onclick="() => SelectSkimTargetDigit(di)">
                                    @tgtPlayer.Pot[di]
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="cc-skim-actions">
                    @if (skimSrc.SourceDigitIndex != null && skimSrc.TargetDigitIndex != null)
                    {
                        <button class="cc-btn cc-btn-primary" disabled>⏳ Waiting for target to accept...</button>
                    }
                    else
                    {
                        <button class="cc-btn cc-btn-primary"
                                disabled="@(_pendingSkimSourceDigit == null || _pendingSkimTargetDigit == null)"
                                @onclick="ConfirmSkimSwap">
                            ✅ Confirm Swap
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@* ── Not My Money Target Selection ── *@
@if (IsInNotMyMoneySelect())
{
    <div class="cc-not-my-money-overlay">
        <div class="cc-not-my-money-panel">
            <h3 class="cc-nmm-title">
                💸 NOT MY MONEY
                @if (View.PendingNotMyMoneyOperator.HasValue)
                {
                    <span>[<strong>@CardDisplay.GetOperatorSymbol(View.PendingNotMyMoneyOperator.Value)</strong>]</span>
                }
            </h3>
            @if (View.Settings.ActiveOperatorMode)
            {
                <p class="cc-nmm-subtitle">Select a player to apply this operator as their active operator, or cancel to apply it to yourself.</p>
            }
            else
            {
                <p class="cc-nmm-subtitle">Select a player to apply this operator to their pot, or cancel to apply it to yourself.</p>
            }
            <div class="cc-nmm-players">
                @foreach (var pl in View.Players)
                {
                    bool isMe = pl.PlayerId == myId;
                    bool isNmmTarget = _notMyMoneyTargetId == pl.PlayerId;
                    <div class="cc-nmm-player @(isNmmTarget ? "cc-nmm-player-selected" : "") @(isMe ? "cc-nmm-player-me-disabled" : "")"
                         @onclick="() => { if (!isMe) SelectNotMyMoneyTarget(pl.PlayerId); }">
                        <span class="cc-nmm-player-name">@pl.DisplayName @(isMe ? "(you)" : "")</span>
                        <span class="cc-nmm-player-balance" title="Balance">
                            <span class="cc-stat-val @(pl.Balance >= 0 ? "cc-positive" : "cc-negative")">@pl.Balance.FormatBalance()</span>
                        </span>
                        @if (View.Settings.ActiveOperatorMode)
                        {
                            <span class="cc-nmm-player-pot" title="Active Operator">
                                @if (pl.ActiveOperator.HasValue)
                                {
                                    <span>⚡ @CardDisplay.GetOperatorSymbol(pl.ActiveOperator.Value)</span>
                                }
                                else { <span>—</span> }
                            </span>
                        }
                        else
                        {
                            <span class="cc-nmm-player-pot" title="Pot">
                                @if (pl.Pot.Count > 0)
                                {
                                    @string.Join("", pl.Pot)
                                    <span class="cc-pot-value"> (@pl.PotValue)</span>
                                }
                                else { <span>—</span> }
                            </span>
                        }
                        @if (isNmmTarget)
                        {
                            <span class="cc-target-selected-mark">🎯</span>
                        }
                    </div>
                }
            </div>
            <div class="cc-nmm-actions">
                <button class="cc-btn cc-btn-primary" disabled="@(_notMyMoneyTargetId == null)" @onclick="ConfirmNotMyMoneyTarget">
                    ▶ Apply to Selected
                </button>
                <button class="cc-btn cc-btn-ghost" @onclick="CancelNotMyMoney">✕ Don't Use Card</button>
            </div>
        </div>
    </div>
}

@* ── Operator Result Overlay / Balance Change Toast (PLAYER only) ── *@
@if (myPlayer != null && !_operatorResultDismissed && View.LastOperatorResult is { } opResult && opResult.PlayerId == myId)
{
    double opDelta = opResult.BalanceAfter - opResult.BalanceBefore;
    @if (View.Settings.ActiveOperatorMode)
    {
        <div @key="_toastKey"
             class="cc-balance-change-toast @(opDelta > 0 ? "cc-balance-change-gain" : opDelta < 0 ? "cc-balance-change-loss" : "")">
            <div class="cc-balance-change-row">
                <span class="cc-balance-change-before @(opResult.BalanceBefore >= 0 ? "cc-positive" : "cc-negative")">@opResult.BalanceBefore.FormatBalance()</span>
                <span class="cc-balance-change-arrow">→</span>
                <span class="cc-balance-change-after @(opResult.BalanceAfter >= 0 ? "cc-positive" : "cc-negative")">@opResult.BalanceAfter.FormatBalance()</span>
            </div>
            <span class="cc-balance-change-delta @(opDelta > 0 ? "cc-positive" : opDelta < 0 ? "cc-negative" : "")">
                @(opDelta > 0 ? "▲ +" + opDelta.ToString("N0") : opDelta < 0 ? "▼ −" + Math.Abs(opDelta).ToString("N0") : "No change")
            </span>
        </div>
    }
    else
    {
        string opSymbol = CardDisplay.GetOperatorSymbol(opResult.Op);
        string opName = CardDisplay.GetOperatorName(opResult.Op);
        <div class="cc-operator-result-overlay">
            <div class="cc-operator-result-panel">
                <h3 class="cc-operator-result-title">⚡ OPERATOR APPLIED</h3>
                <div class="cc-operator-result-op">
                    <span class="cc-operator-result-symbol">@opSymbol</span>
                    <span class="cc-operator-result-opname">@opName</span>
                </div>
                <div class="cc-operator-result-balances">
                    <div class="cc-operator-result-balance-row">
                        <span class="cc-operator-result-label">Before:</span>
                        <span class="cc-operator-result-val @(opResult.BalanceBefore >= 0 ? "cc-positive" : "cc-negative")">@opResult.BalanceBefore.FormatBalance()</span>
                    </div>
                    <div class="cc-operator-result-arrow">→</div>
                    <div class="cc-operator-result-balance-row">
                        <span class="cc-operator-result-label">After:</span>
                        <span class="cc-operator-result-val @(opResult.BalanceAfter >= 0 ? "cc-positive" : "cc-negative")">@opResult.BalanceAfter.FormatBalance()</span>
                    </div>
                </div>
                @if (opDelta > 0)
                {
                    <div class="cc-operator-result-delta cc-operator-result-gain">▲ +@(opDelta.ToString("N0")) from operation</div>
                }
                else if (opDelta < 0)
                {
                    <div class="cc-operator-result-delta cc-operator-result-loss">▼ −@(Math.Abs(opDelta).ToString("N0")) from operation</div>
                }
                else
                {
                    <div class="cc-operator-result-delta">No change in balance</div>
                }
                <button class="cc-btn cc-btn-primary cc-btn-lg" @onclick="DismissOperatorResult">✓ Got it</button>
            </div>
        </div>
    }
}

@* ── Host Broadcast: Operator Result Toast ── *@
@if (isSharedDisplay && !_operatorResultDismissed && View.LastOperatorResult is { } hostOpResult)
{
    double hostOpDelta = hostOpResult.BalanceAfter - hostOpResult.BalanceBefore;
    <div @key="_toastKey"
         class="cc-host-op-toast @(hostOpDelta > 0 ? "cc-balance-change-gain" : hostOpDelta < 0 ? "cc-balance-change-loss" : "")">
        <span class="cc-host-op-toast-player">⚡ @hostOpResult.PlayerName</span>
        <div class="cc-host-op-toast-row">
            <span class="@(hostOpResult.BalanceBefore >= 0 ? "cc-positive" : "cc-negative")">@hostOpResult.BalanceBefore.FormatBalance()</span>
            <span class="cc-host-op-toast-arrow">→</span>
            <span class="@(hostOpResult.BalanceAfter >= 0 ? "cc-positive" : "cc-negative")">@hostOpResult.BalanceAfter.FormatBalance()</span>
        </div>
        <span class="cc-host-op-toast-delta @(hostOpDelta > 0 ? "cc-positive" : hostOpDelta < 0 ? "cc-negative" : "")">
            @(hostOpDelta > 0 ? "▲ +" + hostOpDelta.ToString("N0") : hostOpDelta < 0 ? "▼ −" + Math.Abs(hostOpDelta).ToString("N0") : "No change")
        </span>
    </div>
}

@* ── Operator Change Toast (Active Operator Mode) ── *@
@if (myPlayer != null && !_operatorChangeDismissed && View.LastOperatorChange is { } opChange && opChange.PlayerId == myId && View.Settings.ActiveOperatorMode)
{
    <div @key="_opChangeToastKey" class="cc-op-change-toast">
        <span class="cc-op-change-label">⚡ OPERATOR CHANGED</span>
        <div class="cc-op-change-row">
            @if (opChange.PreviousOperator.HasValue)
            {
                <span class="cc-op-change-prev">@CardDisplay.GetOperatorSymbol(opChange.PreviousOperator.Value)</span>
            }
            else
            {
                <span class="cc-op-change-prev cc-op-change-none">—</span>
            }
            <span class="cc-op-change-arrow">→</span>
            <span class="cc-op-change-new">@CardDisplay.GetOperatorSymbol(opChange.NewOperator)</span>
        </div>
    </div>
}

@* ══ TABLE AREA — HOST vs PLAYER FORK ══════════════════════════════════════ *@

<div class="cc-table-area">
@if (isSharedDisplay)
{
    var activePlayer = View.Players.FirstOrDefault(p => p.PlayerId == activeId);
    var nextPlayer = GetNextPlayer();
    int numCards = ShoeCount("Number");
    int opCards = ShoeCount("Operator");
    int totalShoeCards = numCards + opCards;
    double numPercent = totalShoeCards > 0 ? (double)numCards / totalShoeCards * 100 : 50;

    <div class="cc-host-spectator">
        <div class="cc-host-topbar">
            <span class="cc-host-timer">⏱ @GameTime.ToString(@"hh\:mm\:ss")</span>
            <div class="cc-host-shoe-info">
                <span class="cc-host-shoe-badge">SHOE #@View.ShoeIndex</span>
                <div class="cc-host-shoe-bar" title="@numCards Numbers / @opCards Operators">
                    <div class="cc-host-shoe-bar-num" style="width: @(numPercent.ToString("F0"))%"></div>
                    <div class="cc-host-shoe-bar-op" style="width: @((100 - numPercent).ToString("F0"))%"></div>
                </div>
                <span class="cc-host-shoe-counts">@numCards NUM / @opCards OPS</span>
            </div>
            <div class="cc-host-deck-info">
                <span class="cc-host-deck-label">DECK</span>
                <span class="cc-host-deck-count">@View.MainDeckCount</span>
            </div>
        </div>

        <div class="cc-host-body">
            <div class="cc-host-standings">
                <h2 class="cc-host-standings-title">LIVE STANDINGS</h2>
                <div class="cc-host-standings-list">
                    @for (int i = 0; i < leaderboardRanked.Count; i++)
                    {
                        var lp = leaderboardRanked[i];
                        bool lpActive = lp.PlayerId == activeId;
                        bool lpTargeted = View.FeelingLuckyTargetId == lp.PlayerId || View.PendingReaction?.TargetId == lp.PlayerId;
                        string medal = i switch { 0 => "🥇", 1 => "🥈", 2 => "🥉", _ => $"#{i + 1}" };

                        <div class="cc-host-standing-row @(lpActive ? "cc-host-row-active" : "") @(lpTargeted ? "cc-host-row-targeted" : "")">
                            <span class="cc-host-rank">@medal</span>
                            <div class="cc-host-player-info">
                                <span class="cc-host-player-name">@lp.DisplayName</span>
                                <div class="cc-host-player-details">
                                    <span class="cc-host-player-balance @(lp.Balance >= 0 ? "cc-positive" : "cc-negative")">@lp.Balance.FormatBalance()</span>
                                    @if (View.Settings.ActiveOperatorMode)
                                    {
                                        <span class="cc-host-player-op">
                                            @if (lp.ActiveOperator.HasValue)
                                            {
                                                <span>⚡ @CardDisplay.GetOperatorSymbol(lp.ActiveOperator.Value)</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cc-host-player-pot">
                                            @if (lp.Pot.Count > 0)
                                            {
                                                @string.Join("", lp.Pot) <span class="cc-pot-value">(@lp.PotValue)</span>
                                            }
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="cc-host-player-badges">
                                @if (lp.ExtraTurns > 0)
                                {
                                    <span class="cc-extra-turns-badge">🔁 +@lp.ExtraTurns</span>
                                }
                                @if (View.HedgeYourBetPlayerId == lp.PlayerId)
                                {
                                    <span class="cc-hedge-badge">🎯</span>
                                }
                                <span class="cc-host-player-cards">@lp.ActionHandCount 🂠</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="cc-host-spotlight">
                @if (activePlayer != null)
                {
                    <div class="cc-host-spotlight-player" @key="activeId">
                        <div class="cc-host-spotlight-name">@activePlayer.DisplayName's Turn</div>
                        <div class="cc-host-spotlight-stats">
                            <div class="cc-host-spotlight-stat">
                                <span class="cc-host-spotlight-stat-label">BALANCE</span>
                                <span class="cc-host-spotlight-stat-val @(activePlayer.Balance >= 0 ? "cc-positive" : "cc-negative")">@activePlayer.Balance.FormatBalance()</span>
                            </div>
                            @if (View.Settings.ActiveOperatorMode)
                            {
                                <div class="cc-host-spotlight-stat">
                                    <span class="cc-host-spotlight-stat-label">OPERATOR</span>
                                    <span class="cc-host-spotlight-stat-val">
                                        @if (activePlayer.ActiveOperator.HasValue)
                                        {
                                            @CardDisplay.GetOperatorSymbol(activePlayer.ActiveOperator.Value)
                                        }
                                        else { <span class="cc-empty-pot">—</span> }
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="cc-host-spotlight-stat">
                                    <span class="cc-host-spotlight-stat-label">POT</span>
                                    <span class="cc-host-spotlight-stat-val">
                                        @if (activePlayer.Pot.Count > 0)
                                        {
                                            <span class="cc-host-pot-digits">
                                                @foreach (var d in activePlayer.Pot)
                                                {
                                                    <span class="cc-host-pot-digit">@d</span>
                                                }
                                            </span>
                                            <span class="cc-pot-value">(@activePlayer.PotValue)</span>
                                        }
                                        else { <span class="cc-empty-pot">empty</span> }
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="cc-host-last-card">
                            @if (View.DiscardHistory.Count > 0 && View.DiscardHistory[^1].IsActionCard && View.LastPlayedAction is { } lastAction)
                            {
                                <div class="cc-host-card-event" @key="@($"host-action-{View.DiscardHistory.Count}")">
                                    <div class="cc-card-event-card">
                                        <div class="cc-card-event-card-inner">
                                            <div class="cc-card-event-card-face cc-card-event-card-back">🂠</div>
                                            <div class="cc-card-event-card-face cc-card-event-card-front cc-card-event-card-front-action">
                                                <span class="cc-card-event-icon">@CardDisplay.GetActionCardIcon(lastAction.Action)</span>
                                                <span class="cc-card-event-label">@CardDisplay.GetActionCardName(lastAction.Action)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cc-host-card-caption">
                                        <strong>@lastAction.PlayerName</strong> played <strong>@CardDisplay.GetActionCardName(lastAction.Action)</strong>
                                        @if (lastAction.TargetName != null)
                                        {
                                            <span> on <strong>@lastAction.TargetName</strong></span>
                                        }
                                    </div>
                                </div>
                            }
                            else if (View.DiscardHistory.Count > 0 && !View.DiscardHistory[^1].IsActionCard && View.LastDrawnCard is { } drawnCard)
                            {
                                <div class="cc-host-card-event" @key="@($"host-draw-{View.DiscardHistory.Count}")">
                                    <div class="cc-card-event-card">
                                        <div class="cc-card-event-card-inner">
                                            <div class="cc-card-event-card-face cc-card-event-card-back">🂠</div>
                                            <div class="cc-card-event-card-face cc-card-event-card-front @(drawnCard.Card is OperatorCard ? "cc-card-event-card-front-operator" : "cc-card-event-card-front-number")">
                                                <span class="cc-card-event-value">@CardDisplay.FormatBaseCardDisplay(drawnCard.Card)</span>
                                                <span class="cc-card-event-label">@CardDisplay.GetBaseCardTypeLabel(drawnCard.Card)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cc-host-card-caption">
                                        <strong>@drawnCard.DrawerName</strong> drew <strong>@CardDisplay.FormatBaseCardDisplay(drawnCard.Card)</strong>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (activePlayer.ExtraTurns > 0)
                        {
                            <div class="cc-host-spotlight-badges">
                                <span class="cc-extra-turns-badge">🔁 +@activePlayer.ExtraTurns Extra Turn(s)</span>
                            </div>
                        }
                    </div>
                }

                @if (nextPlayer != null)
                {
                    <div class="cc-host-next-up">Next up: <strong>@nextPlayer.DisplayName</strong></div>
                }
            </div>

            <div class="cc-host-feed">
                <h2 class="cc-host-feed-title">ACTIVITY</h2>
                <div class="cc-host-feed-list">
                    @{
                        var total = View.DiscardHistory.Count;
                        var start = total > 12 ? total - 12 : 0;
                    }
                    @for (var i = total - 1; i >= start; i--)
                    {
                        var entry = View.DiscardHistory[i];
                        <div class="cc-host-feed-entry @(entry.IsActionCard ? "cc-host-feed-action" : "cc-host-feed-draw")" @key="@($"feed-{i}")">
                            <span class="cc-host-feed-desc">@entry.Description</span>
                            @if (entry.PlayerName != null)
                            {
                                <span class="cc-host-feed-player">@entry.PlayerName</span>
                            }
                        </div>
                    }
                    @if (View.DiscardHistory.Count == 0)
                    {
                        <div class="cc-host-feed-empty">Waiting for first draw...</div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ── Mobile: Compact Opponent Strip ── *@
    <div class="cc-mobile-opponent-strip">
        @foreach (var pl in allPlayers)
        {
            bool plActive = pl.PlayerId == activeId;
            bool plIsMe = pl.PlayerId == myId;
            bool plExpanded = _expandedOpponentId == pl.PlayerId;
            <div class="cc-mobile-opp-pill-wrap">
                <div class="cc-mobile-opp-pill @(plActive ? "cc-mobile-opp-active" : "") @(plIsMe ? "cc-mobile-opp-me" : "")"
                     @onclick="() => ToggleOpponentPopover(pl.PlayerId)">
                    <span class="cc-mobile-opp-name">@(plIsMe ? "You" : pl.DisplayName)</span>
                    <span class="cc-mobile-opp-bal @(pl.Balance >= 0 ? "cc-positive" : "cc-negative")">@pl.Balance.FormatBalance()</span>
                </div>
                @if (plExpanded)
                {
                    <div class="cc-mobile-opp-popover">
                        <div class="cc-mobile-opp-popover-name">@pl.DisplayName @(plIsMe ? "(you)" : "")</div>
                        <div class="cc-mobile-opp-popover-stat">
                            <span>💰</span>
                            <span class="@(pl.Balance >= 0 ? "cc-positive" : "cc-negative")">@pl.Balance.FormatBalance()</span>
                        </div>
                        @if (View.Settings.ActiveOperatorMode)
                        {
                            <div class="cc-mobile-opp-popover-stat">
                                <span>⚡</span>
                                <span>@(pl.ActiveOperator.HasValue ? CardDisplay.GetOperatorSymbol(pl.ActiveOperator.Value) : "—")</span>
                            </div>
                        }
                        else
                        {
                            <div class="cc-mobile-opp-popover-stat">
                                <span>🎰</span>
                                <span>@(pl.Pot.Count > 0 ? $"{string.Join("", pl.Pot)} ({pl.PotValue})" : "—")</span>
                            </div>
                        }
                        <div class="cc-mobile-opp-popover-stat">
                            <span>🂠</span>
                            <span>@pl.ActionHandCount cards</span>
                        </div>
                    </div>
                }
            </div>
        }
        <div class="cc-mobile-shoe-badge" title="Shoe composition">
            @ShoeCount("Number")N / @ShoeCount("Operator")O
        </div>
    </div>

    @* ── Desktop: Player List ── *@
    <div class="cc-opponents-row">
        @foreach (var pl in allPlayers)
        {
            bool isActive = pl.PlayerId == activeId;
            bool isMe = pl.PlayerId == myId;
            bool isFeelingLuckyTarget = View.FeelingLuckyTargetId == pl.PlayerId;
            bool isReactionTarget = View.PendingReaction?.TargetId == pl.PlayerId;
            bool isSkimSource = View.PendingReaction?.SourceId == pl.PlayerId && View.PendingReaction?.PlayedCard.Action == ActionType.Skim;

            bool isInvalidSkimTarget = _pendingActionCardIndex.HasValue
                && myPlayer != null
                && myHand.ElementAtOrDefault(_pendingActionCardIndex.Value)?.Action == ActionType.Skim
                && (pl.Pot.Count == 0 || pl.PlayerId == myId);

            <div class="cc-opponent-card @(isActive ? "cc-opponent-active" : "") @(isMe ? "cc-opponent-me" : "") @(isFeelingLuckyTarget || isReactionTarget ? "cc-opponent-targeted" : "") @(isInvalidSkimTarget ? "cc-opponent-invalid-target" : "")"
                 @onclick="() => { if (!isSharedDisplay && !isInvalidSkimTarget) SelectTarget(pl.PlayerId); }"
                 title="@(pl.DisplayName + (isMe ? " (you)" : "") + (isInvalidSkimTarget ? " — cannot target (empty pot)" : ""))">
                <div class="cc-opp-header">
                    @if (isActive)
                    {
                        <span class="cc-active-marker" title="Active player">🎴</span>
                    }
                    @if (isFeelingLuckyTarget)
                    {
                        <span class="cc-targeted-marker" title="Feeling Lucky target">🎲</span>
                    }
                    @if (isReactionTarget)
                    {
                        <span class="cc-targeted-marker" title="Awaiting reaction">⚔️</span>
                    }
                    @if (isSkimSource)
                    {
                        <span class="cc-targeted-marker" title="Choosing Skim digits">✂️</span>
                    }
                    @if (pl.ExtraTurns > 0)
                    {
                        <span class="cc-extra-turns-badge" title="@pl.ExtraTurns extra turn(s) queued (Let It Ride)">🔁 +@pl.ExtraTurns</span>
                    }
                    @if (View.HedgeYourBetPlayerId == pl.PlayerId)
                    {
                        <span class="cc-hedge-badge" title="Next drawn card will be converted to an operator (Hedge Your Bet)">🎯</span>
                    }
                    <span class="cc-opp-name">@pl.DisplayName @(isMe ? "(you)" : "")</span>
                    @if (_selectedTargetId == pl.PlayerId)
                    {
                        <span class="cc-target-selected-mark">🎯</span>
                    }
                </div>
                <div class="cc-opp-stats">
                    <div class="cc-opp-stat" title="Balance">
                        <span class="cc-stat-icon">💰</span>
                        <span class="cc-stat-val @(pl.Balance >= 0 ? "cc-positive" : "cc-negative")">@pl.Balance.FormatBalance()</span>
                    </div>
                    @if (View.Settings.ActiveOperatorMode)
                    {
                        <div class="cc-opp-stat" title="Active Operator">
                            <span class="cc-stat-icon">⚡</span>
                            <span class="cc-stat-val">
                                @if (pl.ActiveOperator.HasValue)
                                {
                                    @CardDisplay.GetOperatorSymbol(pl.ActiveOperator.Value)
                                }
                                else { <span class="cc-empty-pot">—</span> }
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="cc-opp-stat" title="Pot">
                            <span class="cc-stat-icon">🎰</span>
                            <span class="cc-stat-val">
                                @if (pl.Pot.Count > 0)
                                {
                                    @string.Join("", pl.Pot)
                                    <span class="cc-pot-value"> (@pl.PotValue)</span>
                                }
                                else { <span class="cc-empty-pot">—</span> }
                            </span>
                        </div>
                    }
                </div>
                <div class="cc-opp-cards" title="@pl.ActionHandCount action card(s)">
                    @for (int i = 0; i < Math.Min(pl.ActionHandCount, 8); i++)
                    {
                        <span class="cc-mini-card">🂠</span>
                    }
                    @if (pl.ActionHandCount > 8)
                    {
                        <span class="cc-mini-card-more">+@(pl.ActionHandCount - 8)</span>
                    }
                </div>
            </div>
        }
    </div>

    @* ── Mobile: My Stats Bar ── *@
    @if (myPlayer != null)
    {
        <div class="cc-mobile-stats-bar">
            <div class="cc-mobile-turn-indicator">
                @if (activeId == myId)
                {
                    <span class="cc-mobile-your-turn">YOUR TURN</span>
                }
                else
                {
                    var activeName = View.Players.FirstOrDefault(p => p.PlayerId == activeId)?.DisplayName ?? "...";
                    <span class="cc-mobile-waiting-turn">@activeName's turn</span>
                }
            </div>
            <div class="cc-mobile-my-stats">
                <div class="cc-mobile-stat">
                    <span class="cc-mobile-stat-label">💰</span>
                    <span class="cc-mobile-stat-val @(myPlayer.Balance >= 0 ? "cc-positive" : "cc-negative")">@myPlayer.Balance.FormatBalance()</span>
                </div>
                @if (View.Settings.ActiveOperatorMode)
                {
                    <div class="cc-mobile-stat">
                        <span class="cc-mobile-stat-label">⚡</span>
                        <span class="cc-mobile-stat-val">@(myPlayer.ActiveOperator.HasValue ? CardDisplay.GetOperatorSymbol(myPlayer.ActiveOperator.Value) : "—")</span>
                    </div>
                }
                else
                {
                    <div class="cc-mobile-stat">
                        <span class="cc-mobile-stat-label">🎰</span>
                        <span class="cc-mobile-stat-val">@(myPlayer.Pot.Count > 0 ? $"{string.Join("", myPlayer.Pot)} ({myPlayer.PotValue})" : "empty")</span>
                    </div>
                }
                @if (myPlayer.ExtraTurns > 0)
                {
                    <div class="cc-mobile-stat">
                        <span class="cc-mobile-stat-label">🔁</span>
                        <span class="cc-mobile-stat-val cc-positive">+@myPlayer.ExtraTurns</span>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Table Center ── *@
    <div class="cc-table-center-wrap">
        <div class="cc-deck-pile cc-discard-pile @(View.DiscardHistory.Count > 1 ? "cc-discard-pile-active" : "")"
             title="Discard Pile — click to view history"
             @onclick="ToggleDiscardOverlay">
            @if (View.DiscardHistory.Count > 0 && View.DiscardHistory[^1].IsActionCard && View.LastPlayedAction is { } lastAction)
            {
                <div class="cc-last-event-panel">
                    <div class="cc-shoe-event-card-wrap" @key="@($"action-{View.DiscardHistory.Count}")">
                        <div class="cc-card-event-card">
                            <div class="cc-card-event-card-inner">
                                <div class="cc-card-event-card-face cc-card-event-card-back">🂠</div>
                                <div class="cc-card-event-card-face cc-card-event-card-front cc-card-event-card-front-action">
                                    <span class="cc-card-event-icon">@CardDisplay.GetActionCardIcon(lastAction.Action)</span>
                                    <span class="cc-card-event-label">@CardDisplay.GetActionCardName(lastAction.Action)</span>
                                </div>
                            </div>
                        </div>
                        <div class="cc-shoe-event-caption">
                            <strong>@lastAction.PlayerName</strong> played <strong>@CardDisplay.GetActionCardName(lastAction.Action)</strong>
                        </div>
                    </div>
                </div>
            }
            else if (View.DiscardHistory.Count > 0 && !View.DiscardHistory[^1].IsActionCard && View.LastDrawnCard is { } drawnCard)
            {
                <div class="cc-last-event-panel">
                    <div class="cc-shoe-event-card-wrap" @key="@($"draw-{View.DiscardHistory.Count}")">
                        <div class="cc-card-event-card">
                            <div class="cc-card-event-card-inner">
                                <div class="cc-card-event-card-face cc-card-event-card-back">🂠</div>
                                <div class="cc-card-event-card-face cc-card-event-card-front @(drawnCard.Card is OperatorCard ? "cc-card-event-card-front-operator" : "cc-card-event-card-front-number")">
                                    <span class="cc-card-event-value">@CardDisplay.FormatBaseCardDisplay(drawnCard.Card)</span>
                                    <span class="cc-card-event-label">@CardDisplay.GetBaseCardTypeLabel(drawnCard.Card)</span>
                                </div>
                            </div>
                        </div>
                        <div class="cc-shoe-event-caption">
                            <strong>@drawnCard.DrawerName</strong> drew <strong>@CardDisplay.FormatBaseCardDisplay(drawnCard.Card)</strong>
                        </div>
                    </div>
                </div>
            }
            <div class="cc-pile-label">DISCARD</div>
            <div class="cc-pile-count">@View.DiscardHistory.Count</div>
        </div>

        <div class="cc-card-table-group">
            <div class="cc-shoe-stats">
                <div class="cc-shoe-badge"><span>SHOE #@View.ShoeIndex</span></div>
                <div class="cc-shoe-stat" title="Number cards in shoe">
                    <span class="cc-stat-label">Numbers</span>
                    <span class="cc-stat-num">@ShoeCount("Number")</span>
                </div>
                <div class="cc-shoe-stat" title="Operator cards in shoe">
                    <span class="cc-stat-label">Operators</span>
                    <span class="cc-stat-num">@ShoeCount("Operator")</span>
                </div>
            </div>

            <div class="cc-table-stats">
                <div class="cc-deck-pile cc-shoe-pile @(CanDrawCard() ? "cc-shoe-pile-active" : "")"
                     title="@(CanDrawCard() ? "Click to draw a card from the shoe" : $"Current Shoe — {View.CurrentShoeCount} cards remaining")"
                     @onclick="OnShoeClick">
                    @if (View.CurrentShoeCount > 0)
                    {
                        <div class="cc-pile-stack">
                            <div class="cc-shoe-card"><div class="cc-shoe-card-back">🂠</div></div>
                        </div>
                    }
                    else
                    {
                        <div class="cc-pile-empty"><span class="cc-pile-empty-icon">📭</span></div>
                    }
                    <div class="cc-pile-label">SHOE</div>
                    <div class="cc-pile-count">@View.CurrentShoeCount</div>
                    @if (CanDrawCard())
                    {
                        <div class="cc-mobile-draw-label">TAP TO DRAW</div>
                    }
                </div>

                <div class="cc-deck-pile cc-main-deck-pile" title="Main Deck — @View.MainDeckCount cards remaining">
                    <div class="cc-pile-stack">
                        <div class="cc-main-deck-card"><div class="cc-main-deck-card-back">🂠</div></div>
                    </div>
                    <div class="cc-pile-label">DECK</div>
                    <div class="cc-pile-count">@View.MainDeckCount</div>
                </div>
            </div>
        </div>
    </div>

    @* ── My Player Panel ── *@
    @if (myPlayer != null)
    {
        <div class="cc-my-panel @(activeId == myId ? "cc-my-panel-active" : "")">
            <div class="cc-my-panel-stats">
                <div class="cc-my-stat" title="Your balance">
                    <span class="cc-stat-icon">💰</span>
                    <span class="cc-stat-label">Balance</span>
                    <span class="cc-stat-val @(myPlayer.Balance >= 0 ? "cc-positive" : "cc-negative")">@myPlayer.Balance.FormatBalance()</span>
                </div>
                @if (!View.Settings.ActiveOperatorMode)
                {
                    <div class="cc-my-stat" title="Your pot">
                        <span class="cc-stat-icon">🎰</span>
                        <span class="cc-stat-label">Pot</span>
                        <span class="cc-stat-val">
                            @if (myPlayer.Pot.Count > 0)
                            {
                                @string.Join("", myPlayer.Pot)
                                <span class="cc-pot-value"> (@myPlayer.PotValue)</span>
                            }
                            else { <span class="cc-empty-pot">empty</span> }
                        </span>
                    </div>
                }
                @if (myPlayer.ExtraTurns > 0)
                {
                    <div class="cc-my-stat cc-extra-turns-stat" title="Extra turns queued from Let It Ride">
                        <span class="cc-stat-icon">🔁</span>
                        <span class="cc-stat-label">Extra Turns</span>
                        <span class="cc-stat-val cc-positive">+@myPlayer.ExtraTurns</span>
                    </div>
                }
            </div>

            <div class="cc-action-row">
                @if (activeId == myId && myPlayer.PrivateReveal == null && !IsOverHandLimit()
                     && View.FeelingLuckyTargetId == null && View.PendingReaction == null && !View.IsNotMyMoneySelecting)
                {
                    <div class="cc-your-turn-hint">
                        🃏 Click the <strong>SHOE</strong> to draw a card
                    </div>
                }
                else if (activeId != myId && myPlayer.PrivateReveal == null && !IsOverHandLimit())
                {
                    var activeName = View.Players.FirstOrDefault(p => p.PlayerId == activeId)?.DisplayName ?? "...";
                    <div class="cc-waiting-turn">
                        <span>⌛ Waiting for <strong>@activeName</strong></span>
                    </div>
                }
            </div>

            @* ── Make My Luck Reorder ── *@
            @if (myPlayer.PrivateReveal != null)
            {
                <div class="cc-reorder-panel">
                    <h4 class="cc-reorder-title">⭐ MAKE MY LUCK — Reorder the Top Cards</h4>
                    <p class="cc-reorder-subtitle">Click cards in the order you want them placed on top (first clicked = top card).</p>
                    <div class="cc-reorder-cards">
                        @for (int i = 0; i < myPlayer.PrivateReveal.Count; i++)
                        {
                            var idx = i;
                            var revealCard = myPlayer.PrivateReveal[i];
                            bool isSelected = SelectedReorderIndices.Contains(idx);
                            int selPos = SelectedReorderIndices.IndexOf(idx);
                            string cardLabel = revealCard switch
                            {
                                NumberCard nc => $"# {nc.Value}",
                                OperatorCard oc => CardDisplay.GetOperatorSymbol(oc.Op),
                                _ => "?"
                            };
                            <div class="cc-reveal-card @(isSelected ? "cc-reveal-selected" : "")"
                                 @onclick="() => SelectForReorder(idx)">
                                @if (isSelected)
                                {
                                    <span class="cc-reveal-pos">@(selPos + 1)</span>
                                }
                                <span class="cc-reveal-label">@cardLabel</span>
                            </div>
                        }
                    </div>
                    <div class="cc-reorder-buttons">
                        <button class="cc-btn cc-btn-primary"
                                disabled="@(SelectedReorderIndices.Count != myPlayer.PrivateReveal.Count)"
                                @onclick="SubmitReorder">
                            ✅ Confirm Order
                        </button>
                        <button class="cc-btn cc-btn-ghost" @onclick="ResetReorder">↩️ Reset</button>
                    </div>
                </div>
            }
            @if (View.Settings.ActiveOperatorMode)
            {
                <div class="cc-active-op-card" title="Your active operator">
                    <span class="cc-active-op-symbol">
                        @if (myPlayer.ActiveOperator.HasValue)
                        {
                            @CardDisplay.GetOperatorSymbol(myPlayer.ActiveOperator.Value)
                        }
                        else { <span class="cc-empty-pot">—</span> }
                    </span>
                    <span class="cc-active-op-label">ACTIVE OPERATOR</span>
                </div>
            }
        </div>

        @* ── My Hand ── *@
        <div class="cc-hand-area">
            @if (myHand.Count == 0)
            {
                <div class="cc-hand-empty">No action cards. More will be dealt next round.</div>
            }
            else
            {
                var groupedCards = myHand
                    .Select((card, idx) => (card, idx))
                    .GroupBy(x => x.card.Action)
                    .OrderBy(g => CardDisplay.GetActionCardName(g.Key))
                    .ToList();

                <div class="cc-hand-cards">
                    @foreach (var group in groupedCards)
                    {
                        foreach (var (card, cardIdx) in group)
                        {
                            var idx = cardIdx;
                            bool isPending = _pendingActionCardIndex == idx;
                            bool isDiscardSelected = _selectedDiscardIndices.Contains(idx);

                            bool isMyTurn = activeId == myId
                                && myPlayer.PrivateReveal == null
                                && !IsOverHandLimit()
                                && View.FeelingLuckyTargetId == null
                                && View.PendingReaction == null
                                && !View.IsNotMyMoneySelecting;

                            bool isReactionCompd = View.PendingReaction?.TargetId == myId && card.Action == ActionType.Compd;
                            bool isFeelingLuckyCompd = View.FeelingLuckyTargetId == myId
                                && (card.Action == ActionType.Compd || card.Action == ActionType.FeelingLucky);

                            bool canPlay = isMyTurn || isReactionCompd || isFeelingLuckyCompd;

                            if (card.Action == ActionType.Compd)
                                canPlay = isReactionCompd || isFeelingLuckyCompd;

                            if (card.Action == ActionType.Skim && !CanPlaySkim())
                                canPlay = false;

                            if (card.Action == ActionType.HedgeYourBet && !CanPlayHedgeYourBet())
                                canPlay = false;

                            if (card.Action == ActionType.NotMyMoney)
                                canPlay = false;

                            <div class="cc-action-card @CardDisplay.GetActionCardColor(card.Action) @(isPending ? "cc-card-pending" : "") @(isDiscardSelected ? "cc-card-discard-selected" : "") @(!canPlay && !IsOverHandLimit() ? "cc-card-disabled" : "")"
                                 @onclick="() => OnActionCardClick(idx)">
                                <div class="cc-card-tooltip">@CardDisplay.GetActionCardDescription(card.Action)</div>
                                <div class="cc-card-corner cc-card-corner-tl">
                                    <span class="cc-card-suit">@CardDisplay.GetActionCardIcon(card.Action)</span>
                                </div>
                                <div class="cc-card-center-icon">@CardDisplay.GetActionCardIcon(card.Action)</div>
                                <div class="cc-card-name-label">@CardDisplay.GetActionCardName(card.Action)</div>
                                <div class="cc-card-corner cc-card-corner-br">
                                    <span class="cc-card-suit cc-card-suit-flipped">@CardDisplay.GetActionCardIcon(card.Action)</span>
                                </div>
                                @if (CardDisplay.RequiresTarget(card.Action))
                                {
                                    <div class="cc-card-requires-target" title="Requires a target player">🎯</div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
}
</div>

@* ── Target Select UI (player only) ── *@
@if (!isSharedDisplay && _pendingActionCardIndex.HasValue)
{
    var card = myHand.ElementAtOrDefault(_pendingActionCardIndex.Value);
    <div class="cc-target-select">
        <div class="cc-target-select-header">
            <span class="cc-target-icon">@(card != null ? CardDisplay.GetActionCardIcon(card.Action) : "🃏")</span>
            <span>Select a target for <strong>@(card != null ? CardDisplay.GetActionCardName(card.Action) : "card")</strong></span>
            <button class="cc-btn cc-btn-ghost cc-btn-sm" @onclick="CancelTargetSelect">✕</button>
        </div>
        <p class="cc-target-hint">Click a player in the list to select them as your target, then confirm.</p>
        <div class="cc-target-confirm">
            @if (_selectedTargetId is { } selId && View.Players.FirstOrDefault(p => p.PlayerId == selId) is { } targetPl)
            {
                <span class="cc-target-name">🎯 @targetPl.DisplayName</span>
            }
            <button class="cc-btn cc-btn-primary" disabled="@(_selectedTargetId == null)" @onclick="ConfirmPlayWithTarget">▶ Play Card</button>
            <button class="cc-btn cc-btn-ghost" @onclick="CancelTargetSelect">Cancel</button>
        </div>
    </div>
}

@* ── Header ── *@
<div class="cc-header">
    <div class="cc-header-left">
        <span class="cc-game-timer">⏱ @GameTime.ToString(@"hh\:mm\:ss")</span>
    </div>
    <div class="cc-header-right">
        <span class="cc-phase-badge cc-phase-@View.Phase.ToString().ToLower()">@GetPhaseLabel()</span>
        @if (View.Phase == GamePhase.Playing && View.Players.Count > 0)
        {
            if (View.Players.FirstOrDefault(p => p.PlayerId == activeId) is { } activePl)
            {
                <span class="cc-turn-indicator">
                    🎴 @activePl.DisplayName's turn
                    @if (activePl.ExtraTurns > 0)
                    {
                        <span class="cc-extra-turns-indicator" title="@activePl.ExtraTurns extra turn(s) queued">🔁 +@activePl.ExtraTurns</span>
                    }
                </span>
            }
            @if (View.HedgeYourBetPlayerId is { } hedgeId && View.Players.FirstOrDefault(p => p.PlayerId == hedgeId) is { } hedgePl)
            {
                <span class="cc-hedge-indicator" title="Next drawn card will be converted (Hedge Your Bet)">
                    🎯 @hedgePl.DisplayName hedged next draw
                </span>
            }
        }
    </div>
</div>

@code {
    [Parameter] public CardCounterView View { get; set; } = default!;
    [Parameter] public Func<string, string?, Task> Submit { get; set; } = default!;
    [Parameter] public bool IsAnimatingShoe { get; set; }

    private readonly CancellationTokenSource _cts = new();

    // ── Local UI state ────────────────────────────────────────────────────
    private bool _showDiscardOverlay;
    private GamePhase? _lastKnownPhase;
    private Guid? _lastKnownPlayerId = null;
    private bool _lastKnownInitialized;

    private int? _pendingActionCardIndex;
    private Guid? _selectedTargetId;
    private int? _pendingSkimSourceDigit;
    private int? _pendingSkimTargetDigit;
    private Guid? _notMyMoneyTargetId;

    private OperatorResultInfo? _cachedOperatorResult;
    private bool _operatorResultDismissed;
    private int _toastKey;

    private OperatorChangeInfo? _cachedOperatorChange;
    private bool _operatorChangeDismissed;
    private int _opChangeToastKey;

    private readonly List<int> SelectedReorderIndices = [];
    private readonly HashSet<int> _selectedDiscardIndices = [];
    private Guid? _expandedOpponentId;

    private static readonly TimeSpan ToastDuration = TimeSpan.FromSeconds(3);

    private TimeSpan GameTime => DateTime.UtcNow - View.CreatedAtUtc;

    private int ShoeCount(string key) => View.ShoeCardCounts.GetValueOrDefault(key);

    protected override void OnParametersSet()
    {
        // Detect a new operator result/change by value (each projection is a fresh
        // object, so reference equality from the server page won't translate).
        if (!Equals(View.LastOperatorResult, _cachedOperatorResult))
        {
            _cachedOperatorResult = View.LastOperatorResult;
            if (View.LastOperatorResult is not null)
            {
                _operatorResultDismissed = false;
                _toastKey++;
                _operatorChangeDismissed = true;
                ScheduleToastDismiss(_toastKey, isOpChange: false);
            }
        }

        if (!Equals(View.LastOperatorChange, _cachedOperatorChange))
        {
            _cachedOperatorChange = View.LastOperatorChange;
            if (View.LastOperatorChange is not null)
            {
                _operatorChangeDismissed = false;
                _opChangeToastKey++;
                _operatorResultDismissed = true;
                ScheduleToastDismiss(_opChangeToastKey, isOpChange: true);
            }
        }

        var currentPhase = View.Phase;
        var currentPlayerId = View.CurrentPlayerId;
        if (!_lastKnownInitialized || currentPhase != _lastKnownPhase || currentPlayerId != _lastKnownPlayerId)
        {
            _lastKnownInitialized = true;
            _lastKnownPhase = currentPhase;
            _lastKnownPlayerId = currentPlayerId;
            ClearTransientUiState();
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    private void ToggleDiscardOverlay() => _showDiscardOverlay = !_showDiscardOverlay;

    private bool IsSharedDisplay() => View.RecipientId == View.HostId && !View.HostIsParticipant;

    private PlayerView? GetMyPlayer() => View.Players.FirstOrDefault(p => p.PlayerId == View.RecipientId);

    private bool IsOverHandLimit()
    {
        var me = GetMyPlayer();
        return me != null && me.ActionHandCount > View.Settings.ActionHandLimit;
    }

    private int DiscardNeeded()
    {
        var me = GetMyPlayer();
        return me == null ? 0 : Math.Max(0, me.ActionHandCount - View.Settings.ActionHandLimit);
    }

    private bool CanConfirmDiscard()
    {
        var me = GetMyPlayer();
        if (me == null) return false;
        int afterDiscard = me.ActionHandCount - _selectedDiscardIndices.Count;
        return afterDiscard <= View.Settings.ActionHandLimit && _selectedDiscardIndices.Count > 0;
    }

    private bool CanPlaySkim()
    {
        var me = GetMyPlayer();
        return me != null && me.Pot.Count > 0;
    }

    private bool CanPlayHedgeYourBet() => View.CurrentShoeCount > 0;

    private bool CanDrawCard()
    {
        var me = GetMyPlayer();
        if (me == null) return false;
        return View.CurrentPlayerId == View.RecipientId
            && me.PrivateReveal == null
            && !IsOverHandLimit()
            && View.FeelingLuckyTargetId == null
            && View.PendingReaction == null
            && !View.IsNotMyMoneySelecting
            && View.CurrentShoeCount > 0;
    }

    private Task OnShoeClick() => CanDrawCard() ? DrawCard() : Task.CompletedTask;

    private void ClearTransientUiState()
    {
        _pendingActionCardIndex = null;
        _selectedTargetId = null;
        _selectedDiscardIndices.Clear();
        _pendingSkimSourceDigit = null;
        _pendingSkimTargetDigit = null;
        _notMyMoneyTargetId = null;
        SelectedReorderIndices.Clear();
    }

    // ── Actions ───────────────────────────────────────────────────────────
    private Task DrawCard() => Submit(CardCounterCommands.DrawCard, null);
    private Task AcceptPending() => Submit(CardCounterCommands.AcceptPending, null);

    private Task OnActionCardClick(int cardIndex)
    {
        var me = GetMyPlayer();
        var hand = me?.ActionHand;
        if (hand == null || cardIndex < 0 || cardIndex >= hand.Count) return Task.CompletedTask;

        var card = hand[cardIndex];

        if (card.Action == ActionType.NotMyMoney || card.Action == ActionType.Compd)
        {
            bool isReaction = View.PendingReaction?.TargetId == View.RecipientId || View.FeelingLuckyTargetId == View.RecipientId;
            if (!isReaction) return Task.CompletedTask;
            if (card.Action == ActionType.NotMyMoney) return Task.CompletedTask;
        }

        if (CardDisplay.RequiresTarget(card.Action))
        {
            _pendingActionCardIndex = cardIndex;
            _selectedTargetId = null;
            _pendingSkimSourceDigit = null;
            _pendingSkimTargetDigit = null;
            return Task.CompletedTask;
        }

        return PlayAction(cardIndex, null);
    }

    private Task PlayAction(int cardIndex, Guid? targetPlayerId)
        => Submit(CardCounterCommands.PlayAction,
            JsonSerializer.Serialize(new PlayActionPayload(cardIndex, targetPlayerId), CardCounterContractsJsonContext.Default.PlayActionPayload));

    private void SelectTarget(Guid playerId)
    {
        if (IsSharedDisplay()) return;
        _selectedTargetId = playerId;
    }

    private Task ConfirmPlayWithTarget()
    {
        if (_pendingActionCardIndex is not { } idx || _selectedTargetId is not { } target) return Task.CompletedTask;
        var task = PlayAction(idx, target);
        _pendingActionCardIndex = null;
        _selectedTargetId = null;
        _pendingSkimSourceDigit = null;
        _pendingSkimTargetDigit = null;
        return task;
    }

    private void CancelTargetSelect()
    {
        _pendingActionCardIndex = null;
        _selectedTargetId = null;
        _pendingSkimSourceDigit = null;
        _pendingSkimTargetDigit = null;
    }

    // ── Skim digit selection ──────────────────────────────────────────────
    private bool IsInSkimDigitSelect()
        => View.PendingReaction?.PlayedCard.Action == ActionType.Skim
           && View.PendingReaction.SourceId == View.RecipientId;

    private void SelectSkimSourceDigit(int index) => _pendingSkimSourceDigit = index;
    private void SelectSkimTargetDigit(int index) => _pendingSkimTargetDigit = index;

    private Task ConfirmSkimSwap()
    {
        if (_pendingSkimSourceDigit is not { } src || _pendingSkimTargetDigit is not { } tgt) return Task.CompletedTask;
        return Submit(CardCounterCommands.SkimSelect,
            JsonSerializer.Serialize(new SkimPayload(src, tgt), CardCounterContractsJsonContext.Default.SkimPayload));
    }

    // ── Not My Money target selection ─────────────────────────────────────
    private bool IsInNotMyMoneySelect()
        => View.IsNotMyMoneySelecting && (View.CurrentPlayerId ?? Guid.Empty) == View.RecipientId;

    private void SelectNotMyMoneyTarget(Guid playerId) => _notMyMoneyTargetId = playerId;

    private Task ConfirmNotMyMoneyTarget()
    {
        if (_notMyMoneyTargetId is not { } target) return Task.CompletedTask;
        var task = Submit(CardCounterCommands.NotMyMoneyTarget,
            JsonSerializer.Serialize(new TargetPayload(target), CardCounterContractsJsonContext.Default.TargetPayload));
        _notMyMoneyTargetId = null;
        return task;
    }

    private Task CancelNotMyMoney()
    {
        _notMyMoneyTargetId = null;
        return Submit(CardCounterCommands.NotMyMoneyCancel, null);
    }

    // ── Operator toasts ───────────────────────────────────────────────────
    private void ScheduleToastDismiss(int capturedKey, bool isOpChange) => _ = DismissAfterDelay(capturedKey, isOpChange);

    private async Task DismissAfterDelay(int capturedKey, bool isOpChange)
    {
        try { await Task.Delay(ToastDuration, _cts.Token); }
        catch (OperationCanceledException) { return; }

        bool stale = isOpChange ? capturedKey != _opChangeToastKey : capturedKey != _toastKey;
        if (stale) return;

        if (isOpChange) _operatorChangeDismissed = true;
        else _operatorResultDismissed = true;
        await InvokeAsync(StateHasChanged);
    }

    private void DismissOperatorResult() => _operatorResultDismissed = true;
    private void DismissOperatorChange() => _operatorChangeDismissed = true;

    // ── Discard ───────────────────────────────────────────────────────────
    private void ToggleDiscardSelection(int index)
    {
        if (!_selectedDiscardIndices.Remove(index))
            _selectedDiscardIndices.Add(index);
    }

    private Task ConfirmDiscard()
    {
        if (!CanConfirmDiscard()) return Task.CompletedTask;
        var task = Submit(CardCounterCommands.Discard,
            JsonSerializer.Serialize(new DiscardPayload([.. _selectedDiscardIndices]), CardCounterContractsJsonContext.Default.DiscardPayload));
        _selectedDiscardIndices.Clear();
        return task;
    }

    // ── Reorder ───────────────────────────────────────────────────────────
    private void SelectForReorder(int index)
    {
        if (!SelectedReorderIndices.Contains(index))
            SelectedReorderIndices.Add(index);
    }

    private void ResetReorder() => SelectedReorderIndices.Clear();

    private Task SubmitReorder()
    {
        var me = GetMyPlayer();
        if (me?.PrivateReveal == null) return Task.CompletedTask;
        if (SelectedReorderIndices.Count != me.PrivateReveal.Count) return Task.CompletedTask;
        var task = Submit(CardCounterCommands.SubmitReorder,
            JsonSerializer.Serialize(new ReorderPayload([.. SelectedReorderIndices]), CardCounterContractsJsonContext.Default.ReorderPayload));
        SelectedReorderIndices.Clear();
        return task;
    }

    // ── Host / Mobile helpers ─────────────────────────────────────────────
    private PlayerView? GetNextPlayer()
    {
        if (View.Players.Count == 0) return null;
        var activeId = View.CurrentPlayerId ?? Guid.Empty;
        int idx = -1;
        for (int i = 0; i < View.Players.Count; i++)
            if (View.Players[i].PlayerId == activeId) { idx = i; break; }
        if (idx < 0) return null;
        return View.Players[(idx + 1) % View.Players.Count];
    }

    private void ToggleOpponentPopover(Guid playerId)
        => _expandedOpponentId = _expandedOpponentId == playerId ? null : playerId;

    private string GetPhaseLabel() => View.Phase switch
    {
        GamePhase.BuyIn => "🎲 Buy In",
        GamePhase.Playing => "🃏 Playing",
        GamePhase.GameOver => "🏆 Game Over",
        _ => "…"
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
