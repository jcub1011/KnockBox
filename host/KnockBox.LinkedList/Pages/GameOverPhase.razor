@using KnockBox.LinkedList.Services.State.Games

@{
    var myId = UserService.CurrentUser?.Id ?? "";
    var ranked = RankedPlayers;
}

<div class="ll-gameover">

    @* ── Headline ── *@
    <div class="ll-go-banner">
        <span class="ll-go-emoji">🏆</span>
        <h3 class="ll-go-headline">The Final Chain</h3>
        <p class="ll-go-sub">@GameState.RoundNumber round@(GameState.RoundNumber == 1 ? "" : "s") played</p>
    </div>

    @* ── Superlatives ── *@
    @if (GameState.Superlatives.Count > 0)
    {
        <div class="ll-go-superlatives">
            @foreach (var s in GameState.Superlatives)
            {
                <div class="ll-superlative-card">
                    <span class="ll-superlative-emoji">@s.Emoji</span>
                    <div class="ll-superlative-body">
                        <span class="ll-superlative-title">@s.Title</span>
                        <span class="ll-superlative-player">@s.PlayerName</span>
                        <span class="ll-superlative-detail">@s.Detail</span>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Group standings (competitive, §8.2) ── *@
    @if (IsGroups && Standings.Count > 0)
    {
        <div class="ll-go-scoreboard">
            <h4 class="ll-go-section-title">Final Group Standings</h4>
            <table class="ll-standings">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Group</th>
                        <th>@(PrimaryIsTime ? "Time" : "Guesses")</th>
                        <th class="ll-standings-secondary">@(PrimaryIsTime ? "Guesses" : "Time")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Standings)
                    {
                        <tr class="@(s.Rank == 1 ? "ll-standings-top" : "")" style="--ll-route: var(--ll-route-@(GameState.Groups.FindIndex(grp => grp.GroupId == s.GroupId) % 6))">
                            <td>@RankMedal(s.Rank)</td>
                            <td>
                                @s.GroupName
                                @if (s.IsTieBreakWinner)
                                {
                                    <span class="ll-tiebreak">⚖️ tiebreak</span>
                                }
                                @if (!s.DestinationReached)
                                {
                                    <span class="ll-standings-dnf">DNF</span>
                                }
                            </td>
                            <td>@(PrimaryIsTime ? FormatElapsed(s.Elapsed) : s.Guesses.ToString())</td>
                            <td class="ll-standings-secondary">@(PrimaryIsTime ? s.Guesses.ToString() : FormatElapsed(s.Elapsed))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ── Ranked scoreboard ── *@
    <div class="ll-go-scoreboard">
        <h4 class="ll-go-section-title">Linksmiths</h4>
        <div class="ll-go-rows">
            @{ int rank = 1; }
            @foreach (var ps in ranked)
            {
                bool isMe = ps.PlayerId == myId;
                <div class="ll-go-row @(rank == 1 ? "ll-go-row-top" : "") @(isMe ? "ll-go-row-me" : "")">
                    <span class="ll-go-rank">@RankMedal(rank)</span>
                    <span class="ll-go-name">@ps.DisplayName</span>
                    <span class="ll-go-stats">
                        <span class="ll-go-stat" title="Accepted pairs">✅ @ps.AcceptedPairs</span>
                        <span class="ll-go-stat" title="Rejections received">🙅 @ps.RejectionsReceived</span>
                        @if (ps.LoopPairsMade > 0)
                        {
                            <span class="ll-go-stat" title="Loop pairs">🔁 @ps.LoopPairsMade</span>
                        }
                        @if (GameState.Settings.ScoringMode == ScoringMode.FastestTime && ps.FastestContribution is { } fc)
                        {
                            <span class="ll-go-stat" title="Fastest pair">⚡ @FormatElapsed(fc)</span>
                        }
                    </span>
                </div>
                rank++;
            }
        </div>
    </div>

    @* ── Final chain ── *@
    @if (GameState.Chain.Count > 0)
    {
        <div class="ll-chain-card">
            <h4 class="ll-chain-title">Final Chain</h4>
            <div class="ll-chain">
                <span class="ll-anchor ll-anchor-start">@GameState.StartWord</span>
                @foreach (var link in GameState.Chain)
                {
                    <span class="ll-connector">─</span>
                    <span class="ll-link @(link.IsLoop ? "ll-link-loop" : "")">
                        <span class="ll-link-pair">@link.FromWord → @link.ToWord</span>
                        <span class="ll-link-by">@link.PlayerName</span>
                        @if (link.IsLoop)
                        {
                            <span class="ll-loop-badge" title="This pair already appeared in the chain">↺ kink</span>
                        }
                    </span>
                }
                <span class="ll-connector @(GameState.DestinationReached ? "" : "ll-connector-pending")">─</span>
                <span class="ll-anchor ll-anchor-dest @(GameState.DestinationReached ? "ll-anchor-reached" : "")">
                    @GameState.DestinationWord
                </span>
            </div>
        </div>
    }

    @* ── Host controls ── *@
    @if (IsHost)
    {
        <div class="ll-go-actions">
            <button class="ll-btn ll-btn-primary" @onclick="ReturnToLobby" disabled="@_starting">
                @(_starting ? "Returning…" : "Return to Lobby")
            </button>
        </div>
    }
    else
    {
        <p class="ll-go-wait">Waiting for the host…</p>
    }
</div>
