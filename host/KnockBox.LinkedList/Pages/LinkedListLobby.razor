@page "/room/linked-list/{ObfuscatedRoomCode}"

@inherits LobbyPageBase<LinkedListGameState>
@using KnockBox.LinkedList.Services.State.Games

<PageTitle>Linked List</PageTitle>

<HeadContent>
    <link href="_content/KnockBox.LinkedList/KnockBox.LinkedList.styles.css" rel="stylesheet" />
</HeadContent>

<div class="content">
@if (GameState == null)
{
    <div>Loading...</div>
}
else
{
    @if (GameState.IsJoinable)
    {
        <div class="card">
            <div class="joinable-state">
                <h4>Players</h4>
                <div class="player-list">
                    @foreach (var entry in GameState.Players)
                    {
                        <button class="btn" title="Click to kick player."
                                @onclick="() => GameState.KickPlayer(UserService.CurrentUser!, entry.User)">@entry.DisplayName @(entry.User.Id == GameState.Host.Id ? "(Host)" : "")</button>
                    }
                </div>
                @if (UserService.CurrentUser?.Id == GameState.Host.Id)
                {
                    <button class="btn btn-primary start-btn mt-3" @onclick="StartGame">Start Session</button>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Game UI TODO -->
        <div class="card">
            <p>The game has started. Add the Linked List game UI here.</p>
        </div>
    }
}
</div>
