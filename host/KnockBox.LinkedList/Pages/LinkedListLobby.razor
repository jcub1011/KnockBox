@page "/room/linked-list/{ObfuscatedRoomCode}"

@inherits LobbyPageBase<LinkedListGameState>
@using KnockBox.LinkedList.Services.State.Games

<PageTitle>Linked List</PageTitle>

<HeadContent>
    <link href="_content/KnockBox.LinkedList/KnockBox.LinkedList.styles.css" rel="stylesheet" />
</HeadContent>

<div class="content">
@* ── Error toast ── *@
@if (_errorMessage is not null)
{
    <div @key="_errorKey" class="ll-error-toast">
        <span class="ll-error-icon">⚠️</span>
        <span>@_errorMessage</span>
    </div>
}

@if (GameState == null)
{
    <div>Loading...</div>
}
else if (GameState.IsJoinable)
{
    <LobbyPhase GameState="GameState" />
}
else
{
    @switch (GameState.Phase)
    {
        case LinkedListGamePhase.Playing:
            <PlayingPhase GameState="GameState" OnError="ShowError" />
            break;
        case LinkedListGamePhase.RoundOver:
            <RoundOverPhase GameState="GameState" OnError="ShowError" />
            break;
        case LinkedListGamePhase.GameOver:
            <div class="card"><p>Game over. (Milestone 4.)</p></div>
            break;
        default:
            <div class="card"><p>Setting up…</p></div>
            break;
    }
}
</div>
