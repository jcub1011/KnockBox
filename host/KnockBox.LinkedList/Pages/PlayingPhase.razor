@using KnockBox.LinkedList.Services.State.Games

@{
    var myId = UserService.CurrentUser?.Id ?? "";
    var isHostSpectator = GameState.Host.Id == myId && !GameState.HostIsParticipant;
    var isAuditor = myId == GameState.AuditorPlayerId;
    var auditorName = DisplayNameOf(GameState.AuditorPlayerId);

    // Reusable chain view for one group's chain.
    RenderFragment<ChainState> chainView = g =>
    @<div class="ll-chain">
        <span class="ll-anchor ll-anchor-start">@GameState.StartWord</span>
        @foreach (var link in g.Chain)
        {
            <span class="ll-connector">─</span>
            <span class="ll-link @(link.IsLoop ? "ll-link-loop" : "")">
                <span class="ll-link-pair">@link.FromWord → @link.ToWord</span>
                <span class="ll-link-by">@link.PlayerName</span>
                @if (link.IsLoop)
                {
                    <span class="ll-loop-badge" title="This pair already appeared in the chain">↺ loop</span>
                }
            </span>
        }
        <span class="ll-connector @(g.DestinationReached ? "" : "ll-connector-pending")">─</span>
        <span class="ll-anchor ll-anchor-dest @(g.DestinationReached ? "ll-anchor-reached" : "")">
            @GameState.DestinationWord
        </span>
    </div>;
}

<div class="ll-play">

    @* ── Journey banner: start → destination ── *@
    <div class="ll-journey">
        <span class="ll-journey-word ll-journey-start">@GameState.StartWord</span>
        <span class="ll-journey-arrow">➜</span>
        <span class="ll-journey-word ll-journey-dest">@GameState.DestinationWord</span>
    </div>

    @* ── Round + Auditor strip ── *@
    <div class="ll-meta-strip">
        <span class="ll-round-chip">Round @GameState.RoundNumber / @GameState.Settings.RoundsPerMatch</span>
        <span class="ll-auditor-chip">
            <span class="ll-auditor-label">Auditor</span>
            <span class="ll-auditor-name">@auditorName</span>
        </span>
    </div>

    @* ════════════════════════════════════════════════════════════════════ *@
    @* COLLECTIVE (co-op): one shared chain — unchanged from M2–M4.          *@
    @* ════════════════════════════════════════════════════════════════════ *@
    @if (!IsGroups)
    {
        var activeId = GameState.TurnManager.CurrentPlayer ?? "";
        var isMyTurn = !isHostSpectator && myId == activeId && !isAuditor;
        var pending = GameState.PendingSubmission;
        var activeName = DisplayNameOf(activeId);

        @* ── Timer bar (Fastest Time only): live per-turn countdown + banked total ── *@
        @if (GameState.Settings.ScoringMode == ScoringMode.FastestTime && GameState.Settings.EnableTimers)
        {
            <div class="ll-timer">
                <div class="ll-timer-total">
                    <span class="ll-timer-label">Elapsed</span>
                    <span class="ll-timer-value">@FormatElapsed(GameState.ElapsedThinkingTime)</span>
                </div>

                @if (GameState.ClockRunning && GameState.PhaseExpiresAtUtc is { } expires)
                {
                    var duration = GameState.Settings.PerTurnClock;
                    <CountdownClock EndTimeUtc="expires" Duration="duration" Context="countdown">
                        @{
                            var barWidth = 20;
                            var filled = (int)Math.Ceiling(countdown.Fraction * barWidth);
                            if (filled < 0) filled = 0;
                            if (filled > barWidth) filled = barWidth;
                            var bar = new string('█', filled) + new string('░', barWidth - filled);
                            var seconds = (int)Math.Ceiling(countdown.RemainingSeconds);
                        }
                        <div class="ll-timer-bar @(seconds < 5 ? "ll-timer-urgent" : "")">
                            <span class="ll-timer-mono">[@bar] @(seconds)s</span>
                            <span class="ll-timer-caption">@activeName is on the clock</span>
                        </div>
                    </CountdownClock>
                }
                else if (pending is not null)
                {
                    <div class="ll-timer-bar ll-timer-paused">
                        <span class="ll-timer-mono">⏸ PAUSED — auditing</span>
                        <span class="ll-timer-caption">the clock resumes if the pair is rejected</span>
                    </div>
                }
            </div>
        }

        @* ════════════════ SUBMITTER VIEW ════════════════ *@
        @if (isMyTurn)
        {
            <div class="ll-panel ll-panel-turn">
                <p class="ll-turn-label">Your turn — build from</p>
                <div class="ll-carried">@GameState.CarriedWord</div>

                @if (pending is null)
                {
                    <form class="ll-submit-row" @onsubmit="SubmitPair" @onsubmit:preventDefault="true">
                        @* DOM owns the value; @key bump clears it after a successful submit. *@
                        <input @key="_inputKey" type="text" class="ll-input"
                               placeholder="@($"a word that pairs with {GameState.CarriedWord}…")"
                               @oninput="OnWordInput" maxlength="40" autocomplete="off" />
                        <button type="submit" class="ll-btn ll-btn-primary">Submit</button>
                    </form>
                }
                else
                {
                    <div class="ll-pending-note">
                        Proposed <strong>@pending.ProposedWord</strong> — waiting for the Auditor…
                    </div>
                }
            </div>
        }
        @* ════════════════ AUDITOR VIEW ════════════════ *@
        else if (isAuditor)
        {
            <div class="ll-panel ll-panel-auditor">
                <p class="ll-role-label">You are the Auditor</p>

                @if (pending is not null)
                {
                    <div class="ll-proposal">
                        <span class="ll-proposal-word">@GameState.CarriedWord</span>
                        <span class="ll-proposal-arrow">→</span>
                        <span class="ll-proposal-word ll-proposal-new">@pending.ProposedWord</span>
                    </div>
                    <p class="ll-proposal-by">from @DisplayNameOf(pending.PlayerId)</p>

                    <div class="ll-decision-row">
                        <button class="ll-btn ll-btn-approve" @onclick="Approve">✓ Approve</button>
                        <button class="ll-btn ll-btn-reject" @onclick="Reject">✕ Reject</button>
                    </div>
                }
                else
                {
                    <p class="ll-waiting">Waiting for @activeName to submit a word…</p>
                }
            </div>
        }
        @* ════════════════ SPECTATOR / OTHER PLAYERS ════════════════ *@
        else
        {
            <div class="ll-panel">
                <p class="ll-carried-label">Carried word</p>
                <div class="ll-carried ll-carried-sm">@GameState.CarriedWord</div>
                @if (pending is null)
                {
                    <p class="ll-waiting">Waiting for @activeName to submit a word…</p>
                }
                else
                {
                    <p class="ll-waiting">@activeName proposed <strong>@pending.ProposedWord</strong> — the Auditor is deciding…</p>
                }
            </div>
        }

        @* ── The chain, rendered as connected links (the linked list) ── *@
        <div class="ll-chain-card">
            <h4 class="ll-chain-title">The Chain</h4>
            @chainView(GameState.PrimaryGroup!)
        </div>
    }
    @* ════════════════════════════════════════════════════════════════════ *@
    @* GROUPS (competitive): per-group chains + single-Auditor audit queue.  *@
    @* ════════════════════════════════════════════════════════════════════ *@
    else
    {
        @* ════════════════ AUDITOR VIEW — audit queue ════════════════ *@
        @if (isAuditor)
        {
            var auditing = AuditingGroup;
            var waiting = GameState.AuditQueue.Count;

            <div class="ll-panel ll-panel-auditor">
                <p class="ll-role-label">You are the Auditor</p>

                @if (auditing is { PendingSubmission: { } sub })
                {
                    <div class="ll-audit-queue-head">
                        <strong>@auditing.GroupName</strong> is up
                        @if (waiting > 1)
                        {
                            <span class="ll-audit-waiting">· @(waiting - 1) more waiting</span>
                        }
                    </div>
                    <div class="ll-proposal">
                        <span class="ll-proposal-word">@auditing.CarriedWord</span>
                        <span class="ll-proposal-arrow">→</span>
                        <span class="ll-proposal-word ll-proposal-new">@sub.ProposedWord</span>
                    </div>
                    <p class="ll-proposal-by">from @DisplayNameOf(sub.PlayerId)</p>

                    <div class="ll-decision-row">
                        <button class="ll-btn ll-btn-approve" @onclick="Approve">✓ Approve</button>
                        <button class="ll-btn ll-btn-reject" @onclick="Reject">✕ Reject</button>
                    </div>
                }
                else
                {
                    <p class="ll-waiting">No submissions waiting — groups are thinking…</p>
                }
            </div>
        }
        @* ════════════════ PLAYER VIEW — own group ════════════════ *@
        else if (MyGroup is { } group)
        {
            var pending = group.PendingSubmission;
            var activeId = group.TurnManager.CurrentPlayer ?? "";
            var isMyTurn = myId == activeId;
            var activeName = DisplayNameOf(activeId);

            @if (GameState.Settings.ScoringMode == ScoringMode.FastestTime && GameState.Settings.EnableTimers)
            {
                <div class="ll-timer">
                    <div class="ll-timer-total">
                        <span class="ll-timer-label">@group.GroupName time</span>
                        <span class="ll-timer-value">@FormatElapsed(group.ElapsedThinkingTime)</span>
                    </div>
                    @if (group.ClockRunning && group.PhaseExpiresAtUtc is { } expires)
                    {
                        <CountdownClock EndTimeUtc="expires" Duration="GameState.Settings.PerTurnClock" Context="countdown">
                            @{
                                var seconds = (int)Math.Ceiling(countdown.RemainingSeconds);
                            }
                            <div class="ll-timer-bar @(seconds < 5 ? "ll-timer-urgent" : "")">
                                <span class="ll-timer-mono">@(seconds)s</span>
                                <span class="ll-timer-caption">@activeName is on the clock</span>
                            </div>
                        </CountdownClock>
                    }
                    else if (pending is not null)
                    {
                        <div class="ll-timer-bar ll-timer-paused">
                            <span class="ll-timer-mono">⏸ with the Auditor</span>
                        </div>
                    }
                </div>
            }

            <div class="ll-group-banner" style="--ll-route: var(--ll-route-@(GameState.Groups.IndexOf(group) % 6))">You're on <strong>@group.GroupName</strong></div>

            @if (group.Finished)
            {
                <div class="ll-panel ll-panel-turn">
                    <p class="ll-turn-label">🎉 @group.GroupName reached the destination!</p>
                    <p class="ll-waiting">Waiting for the other groups to finish…</p>
                </div>
            }
            else if (isMyTurn)
            {
                <div class="ll-panel ll-panel-turn">
                    <p class="ll-turn-label">Your turn — build from</p>
                    <div class="ll-carried">@group.CarriedWord</div>
                    @if (pending is null)
                    {
                        <form class="ll-submit-row" @onsubmit="SubmitPair" @onsubmit:preventDefault="true">
                            <input @key="_inputKey" type="text" class="ll-input"
                                   placeholder="@($"a word that pairs with {group.CarriedWord}…")"
                                   @oninput="OnWordInput" maxlength="40" autocomplete="off" />
                            <button type="submit" class="ll-btn ll-btn-primary">Submit</button>
                        </form>
                    }
                    else
                    {
                        <div class="ll-pending-note">
                            Proposed <strong>@pending.ProposedWord</strong> — waiting for the Auditor…
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ll-panel">
                    <p class="ll-carried-label">@group.GroupName carried word</p>
                    <div class="ll-carried ll-carried-sm">@group.CarriedWord</div>
                    @if (pending is null)
                    {
                        <p class="ll-waiting">Waiting for @activeName to submit…</p>
                    }
                    else
                    {
                        <p class="ll-waiting">@activeName proposed <strong>@pending.ProposedWord</strong> — awaiting the Auditor…</p>
                    }
                </div>
            }

            @* Rival groups' progress for tension. *@
            var rivals = RivalsOf(group);
            @if (rivals.Count > 0)
            {
                <div class="ll-rivals">
                    @foreach (var r in rivals)
                    {
                        <div class="ll-rival-chip @(r.Finished ? "ll-rival-done" : "")" style="--ll-route: var(--ll-route-@(GameState.Groups.IndexOf(r) % 6))">
                            <span class="ll-rival-name">@r.GroupName</span>
                            <span class="ll-rival-stat">@r.GuessCount link@(r.GuessCount == 1 ? "" : "s")</span>
                            @if (r.Finished)
                            {
                                <span class="ll-rival-flag">🏁</span>
                            }
                            else
                            {
                                <span class="ll-rival-carried">@r.CarriedWord</span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="ll-chain-card" style="--ll-route: var(--ll-route-@(GameState.Groups.IndexOf(group) % 6))">
                <h4 class="ll-chain-title">@group.GroupName's Chain</h4>
                @chainView(group)
            </div>
        }
        @* ════════════════ HOST SPECTATOR — all groups ════════════════ *@
        else
        {
            <div class="ll-all-groups">
                @foreach (var g in GameState.Groups)
                {
                    <div class="ll-chain-card" style="--ll-route: var(--ll-route-@(GameState.Groups.IndexOf(g) % 6))">
                        <h4 class="ll-chain-title">
                            @g.GroupName
                            <span class="ll-chain-sub">@g.GuessCount link@(g.GuessCount == 1 ? "" : "s")@(g.Finished ? " · 🏁" : "")</span>
                        </h4>
                        @chainView(g)
                    </div>
                }
            </div>
        }
    }
</div>
