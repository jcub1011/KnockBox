<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <!--
      Reference the word-service contracts assembly so Linked List can inject
      IWordListService at compile time and register its own audited word list as
      a custom pool. The runtime resolves the interface via the host's DI
      container; the implementation lives in the sibling KnockBox.WordService
      library plugin, which the host loads before any game plugin.
    -->
    <ProjectReference Include="..\KnockBox.WordService.Contracts\KnockBox.WordService.Contracts.csproj" />
    <!-- Shared contract DTOs for the tri-split (the projected view, command payloads, and the
         moved gameplay types: the chain/standing/superlative records + the scoring/structure/phase
         enums). -->
    <ProjectReference Include="..\KnockBox.LinkedList.Contracts\KnockBox.LinkedList.Contracts.csproj" />
  </ItemGroup>

  <!-- The Contracts DLL is a PRIVATE ALC dependency (not promoted to the default ALC). It must be
       staged into games/KnockBox.LinkedList/ or the plugin's load context throws
       FileNotFoundException and the loader silently skips the whole plugin (the tile vanishes). -->
  <ItemGroup>
    <PluginPrivateAssembly Include="$(TargetDir)KnockBox.LinkedList.Contracts.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="KnockBox.LinkedList.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\words.csv" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KnockBox.LinkedListTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Import Project="..\Directory.Plugin.targets" />

</Project>
