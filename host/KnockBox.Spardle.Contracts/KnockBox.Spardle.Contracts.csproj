<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared contract DTOs for the KnockBox.Spardle tri-split game: the pure data
    types both runtimes need (the letter/word-source/order/win-condition/phase
    enums and the GuessResult board cell), the host-editable settings view + the
    commands the browser UI sends, and the per-player view the server projects
    back. This assembly loads in BOTH runtimes — compiled against by the server
    plugin AND streamed to the browser alongside the client UI — so both sides
    bind the same CLR types.

    CRITICAL: this project has ZERO KnockBox.* references and imports no plugin
    targets (mirrors KnockBox.LinkedList.Contracts). It is pure DTOs/enums only.
    Source-generated JSON keeps the DTOs trim-safe in the WASM client.

    The moved gameplay types (the enums, GamePhase, GuessResult) intentionally
    keep their original KnockBox.Spardle.Models namespace so the server plugin
    (which already `using`s it pervasively) binds them across the assembly
    boundary with no churn. The new wire DTOs live in the
    KnockBox.Spardle.Contracts namespace.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Shared contract DTOs for the KnockBox.Spardle tri-split game.</Description>
  </PropertyGroup>

</Project>
