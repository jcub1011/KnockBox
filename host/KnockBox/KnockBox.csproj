<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!--
    ReadyToRun (R2R) ahead-of-time compilation for the host. Only activates on
    Release publishes that supply a RuntimeIdentifier (Dockerfile and the
    release-host.yml matrix do; dev `dotnet build`/`dotnet run` do not).
    Composite mode bundles the host's compile-time closure (KnockBox.Core,
    KnockBox.Platform, ASP.NET/Blazor) into one native image. Plugins are
    compile-time unreferenced (ReferenceOutputAssembly="false" below) and are
    therefore excluded from the composite — they get their own per-assembly
    R2R image via Directory.Plugin.targets.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
  </PropertyGroup>

  <PropertyGroup>
	<ContainerRegistry>registry.hub.docker.com</ContainerRegistry>
	<ContainerRepository>jabobb/knockbox</ContainerRepository>
	<EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
	<ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
	<UserSecretsId>dcb89ed8-c20c-46d8-b097-91f5e5655201</UserSecretsId>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Models\" />
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\KnockBox.Platform\KnockBox.Platform.csproj" />
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <!--
      Plugin projects are loaded at runtime, not linked at compile time.
      ReferenceOutputAssembly="false" keeps the host from taking a compile-time
      dependency on plugin types (preserving the runtime-discovery architecture);
      Private="false" keeps plugin binaries out of the host's bin root (they are
      staged to bin/.../games/{Plugin}/ via Directory.Plugin.targets instead).
      These references exist so that building or publishing the host transitively
      builds every plugin, ensuring games/ is populated before CopyPluginsToPublish runs.
    -->
    <ProjectReference Include="..\KnockBox.CardCounter\KnockBox.CardCounter.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Codeword\KnockBox.Codeword.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.DiceSimulator\KnockBox.DiceSimulator.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.DrawnToDress\KnockBox.DrawnToDress.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Operator\KnockBox.Operator.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.HiddenAgenda\KnockBox.HiddenAgenda.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.TaskMaster\KnockBox.TaskMaster.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Spardle\KnockBox.Spardle.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.DndMapper\KnockBox.DndMapper.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.AlphaChain\KnockBox.AlphaChain.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Copy game plugins into the publish output so `dotnet publish` produces
    a runnable folder layout. Each plugin project's PublishPlugin target in
    Directory.Plugin.targets writes to KnockBox/bin/$(Configuration)/$(TargetFramework)/games/
    (no runtime-identifier subfolder) during Build. This target mirrors that
    folder into $(PublishDir)games\ so it ships inside the published output.
  -->
  <PropertyGroup>
    <PluginStagingDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\games\</PluginStagingDir>
  </PropertyGroup>

  <!--
    Plugin projects are referenced with ReferenceOutputAssembly="false", which
    means the host's `dotnet publish` only triggers `Build` on each plugin
    (not `Publish`). That's fine for IL builds — Directory.Plugin.targets
    stages the build output to bin/.../games/ via its AfterTargets="Build"
    target. But R2R compilation is a publish-time operation, so plugins need
    `Publish` invoked explicitly to get R2R'd.

    This target runs after the host's Publish, before CopyPluginsToPublish,
    and invokes Publish on every plugin ProjectReference. Each plugin's
    AfterTargets="Publish" target (in Directory.Plugin.targets) then
    overwrites its IL DLL/deps.json in the staging dir with the R2R-compiled
    publish output, which CopyPluginsToPublish then mirrors into
    $(PublishDir)games/.

    Conditional on RuntimeIdentifier so non-RID publishes (which can't do
    R2R anyway) skip this and continue using build-only plugin output.
  -->
  <Target Name="PublishPluginProjects"
          AfterTargets="Publish"
          BeforeTargets="CopyPluginsToPublish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <!--
        Qualify the metadata as %(ProjectReference.ReferenceOutputAssembly).
        Unqualified %(ReferenceOutputAssembly) batches across all items in the
        list and errors if any item doesn't define the metadata — and the
        KnockBox.Core / KnockBox.Platform references don't.
      -->
      <_PluginProjectsToPublish Include="@(ProjectReference)"
                                Condition="'%(ProjectReference.ReferenceOutputAssembly)' == 'false'" />
    </ItemGroup>
    <MSBuild Projects="@(_PluginProjectsToPublish)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false" />
  </Target>

  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginPublishFiles Include="$(PluginStagingDir)**\*.*" />
    </ItemGroup>
    <Error Text="No plugin files found at '$(PluginStagingDir)'. Plugin project references did not stage output to the host bin; check that Directory.Plugin.targets ran for each plugin project."
           Condition="'@(PluginPublishFiles)' == ''" />
    <Copy SourceFiles="@(PluginPublishFiles)"
          DestinationFiles="@(PluginPublishFiles->'$(PublishDir)games\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(PluginPublishFiles)' != ''" />
  </Target>

</Project>
