<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Workstation GC: ASP.NET Core defaults to Server GC, which reserves
         per-core heaps and is slow to return committed memory to the OS, so
         idle RSS tracks the high-water mark rather than the (small) live set.
         For this host idle footprint in the container matters more than peak
         throughput across many concurrent lobbies, so we opt into Workstation
         GC to keep idle memory low. Revert to Server GC (+ DATAS via
         GarbageCollectionAdaptationMode) if concurrent-lobby throughput
         becomes the bottleneck. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Drop ICU globalization data. Safe only while user-visible strings stay
         English-only and we don't culture-parse user input; revert if either
         changes. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cap managed heap at 75% of the cgroup memory limit so a GC growth spike
         can't push the process past the container ceiling and trigger an
         OOMKill. Pairs with mem_limit in docker-compose.yml. There is no
         MSBuild property shortcut for this one, so we set it via the generic
         RuntimeHostConfigurationOption item. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimitPercent" Value="75" />
    <!-- Trade a little CPU for a smaller committed footprint: ConserveMemory (0-9)
         makes the GC compact more often and decommit free segments back to the OS
         more aggressively, which suits a memory-constrained box already on
         Workstation GC. 5 is a moderate starting point; tune against measured RSS
         vs CPU (see the memory-measurement step in the polish plan) or set 0 to
         disable. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!--
    ReadyToRun (R2R) ahead-of-time compilation for the host. Only activates on
    Release publishes that supply a RuntimeIdentifier (Dockerfile and the
    release-host.yml matrix do; dev `dotnet build`/`dotnet run` do not).
    Composite mode bundles the host's compile-time closure (KnockBox.Core,
    KnockBox.Platform, ASP.NET/Blazor) into one native image. Plugins are
    compile-time unreferenced (ReferenceOutputAssembly="false" below) and are
    therefore excluded from the composite — they get their own per-assembly
    R2R image via Directory.Plugin.targets.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
  </PropertyGroup>

  <PropertyGroup>
	<ContainerRegistry>registry.hub.docker.com</ContainerRegistry>
	<ContainerRepository>jabobb/knockbox</ContainerRepository>
	<EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
	<ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
	<UserSecretsId>dcb89ed8-c20c-46d8-b097-91f5e5655201</UserSecretsId>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerComposeProjectPath>..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ContainerPort Include="8081" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Models\" />
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\KnockBox.Platform\KnockBox.Platform.csproj" />
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <!--
      Blazor WebAssembly client. A NORMAL reference (not ReferenceOutputAssembly=false):
      the Blazor Web App SDK wires this client's trimmed _framework payload into the
      host's served static assets. Carries the Phase 0 spike page.
    -->
    <ProjectReference Include="..\KnockBox.Client\KnockBox.Client.csproj" />
    <!--
      Dice Simulator browser UI (the first true tri-split game). Same
      ReferenceOutputAssembly="false" Private="false" pattern as a server plugin:
      built transitively (which also builds KnockBox.DiceSimulator.Contracts) and
      staged as bytes into games/KnockBox.DiceSimulator/client/ via
      Directory.Client.targets, but never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.DiceSimulator.Client\KnockBox.DiceSimulator.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Card Counter browser UI (game #2 tri-split). Built transitively (also builds
      KnockBox.CardCounter.Contracts) and staged into games/KnockBox.CardCounter/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.CardCounter.Client\KnockBox.CardCounter.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Alpha Chain browser UI (game #3 tri-split). Built transitively (also builds
      KnockBox.AlphaChain.Contracts) and staged into games/KnockBox.AlphaChain/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.AlphaChain.Client\KnockBox.AlphaChain.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Tracery browser UI (game #4 tri-split). Built transitively (also builds
      KnockBox.Tracery.Contracts) and staged into games/KnockBox.Tracery/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.Tracery.Client\KnockBox.Tracery.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Linked List browser UI (game #5 tri-split). Built transitively (also builds
      KnockBox.LinkedList.Contracts) and staged into games/KnockBox.LinkedList/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.LinkedList.Client\KnockBox.LinkedList.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Spardle browser UI (game #6 tri-split). Built transitively (also builds
      KnockBox.Spardle.Contracts) and staged into games/KnockBox.Spardle/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.Spardle.Client\KnockBox.Spardle.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Operator browser UI (game #7 tri-split). Built transitively (also builds
      KnockBox.Operator.Contracts) and staged into games/KnockBox.Operator/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.Operator.Client\KnockBox.Operator.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Codeword browser UI (game #8 tri-split). Built transitively (also builds
      KnockBox.Codeword.Contracts) and staged into games/KnockBox.Codeword/client/
      via Directory.Client.targets; never linked into the host or the WASM client.
    -->
    <ProjectReference Include="..\KnockBox.Codeword.Client\KnockBox.Codeword.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Plugin projects are loaded at runtime, not linked at compile time.
      ReferenceOutputAssembly="false" keeps the host from taking a compile-time
      dependency on plugin types (preserving the runtime-discovery architecture);
      Private="false" keeps plugin binaries out of the host's bin root (they are
      staged to bin/.../games/{Plugin}/ via Directory.Plugin.targets instead).
      These references exist so that building or publishing the host transitively
      builds every plugin, ensuring games/ is populated before CopyPluginsToPublish runs.
    -->
    <ProjectReference Include="..\KnockBox.CardCounter\KnockBox.CardCounter.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Codeword\KnockBox.Codeword.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.DiceSimulator\KnockBox.DiceSimulator.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.DrawnToDress\KnockBox.DrawnToDress.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Operator\KnockBox.Operator.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Spardle\KnockBox.Spardle.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.DndMapper\KnockBox.DndMapper.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.AlphaChain\KnockBox.AlphaChain.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.LinkedList\KnockBox.LinkedList.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\KnockBox.Tracery\KnockBox.Tracery.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!--
      Library plugins. Same ReferenceOutputAssembly="false" Private="false" pattern
      as game plugins: built transitively so libraries/{Plugin}/ is populated
      before CopyLibrariesToPublish runs, but no compile-time dependency.
      KnockBox.WordService.Contracts is built transitively as a ProjectReference
      of both KnockBox.WordService (the library plugin) and KnockBox.Spardle
      (a consumer), so it does not need an explicit entry here.
    -->
    <ProjectReference Include="..\KnockBox.WordService\KnockBox.WordService.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Copy game plugins into the publish output so `dotnet publish` produces
    a runnable folder layout. Each plugin project's PublishPlugin target in
    Directory.Plugin.targets writes to KnockBox/bin/$(Configuration)/$(TargetFramework)/games/
    (no runtime-identifier subfolder) during Build. This target mirrors that
    folder into $(PublishDir)games\ so it ships inside the published output.
  -->
  <PropertyGroup>
    <PluginStagingDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\games\</PluginStagingDir>
    <LibraryStagingDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\libraries\</LibraryStagingDir>
  </PropertyGroup>

  <!--
    Plugin projects are referenced with ReferenceOutputAssembly="false", which
    means the host's `dotnet publish` only triggers `Build` on each plugin
    (not `Publish`). That's fine for IL builds — Directory.Plugin.targets
    stages the build output to bin/.../games/ via its AfterTargets="Build"
    target. But R2R compilation is a publish-time operation, so plugins need
    `Publish` invoked explicitly to get R2R'd.

    This target runs after the host's Publish, before CopyPluginsToPublish,
    and invokes Publish on every plugin ProjectReference. Each plugin's
    AfterTargets="Publish" target (in Directory.Plugin.targets) then
    overwrites its IL DLL/deps.json in the staging dir with the R2R-compiled
    publish output, which CopyPluginsToPublish then mirrors into
    $(PublishDir)games/.

    Conditional on RuntimeIdentifier so non-RID publishes (which can't do
    R2R anyway) skip this and continue using build-only plugin output.
  -->
  <Target Name="PublishPluginProjects"
          AfterTargets="Publish"
          BeforeTargets="CopyPluginsToPublish"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <!--
        Qualify the metadata as %(ProjectReference.ReferenceOutputAssembly).
        Unqualified %(ReferenceOutputAssembly) batches across all items in the
        list and errors if any item doesn't define the metadata — and the
        KnockBox.Core / KnockBox.Platform references don't.
      -->
      <_PluginProjectsToPublish Include="@(ProjectReference)"
                                Condition="'%(ProjectReference.ReferenceOutputAssembly)' == 'false'" />
    </ItemGroup>
    <MSBuild Projects="@(_PluginProjectsToPublish)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false" />
  </Target>

  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PluginPublishFiles Include="$(PluginStagingDir)**\*.*" />
    </ItemGroup>
    <Error Text="No plugin files found at '$(PluginStagingDir)'. Plugin project references did not stage output to the host bin; check that Directory.Plugin.targets ran for each plugin project."
           Condition="'@(PluginPublishFiles)' == ''" />
    <Copy SourceFiles="@(PluginPublishFiles)"
          DestinationFiles="@(PluginPublishFiles->'$(PublishDir)games\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(PluginPublishFiles)' != ''" />
  </Target>

  <!--
    Same mechanism as CopyPluginsToPublish but for the libraries/ folder. Library
    plugins stage themselves into KnockBox/bin/.../libraries/{Plugin}/ via
    Directory.Library.targets; this target mirrors that into $(PublishDir)libraries/.
    Library staging is optional — a build with zero library plugins produces
    no libraries/ folder, so we skip silently rather than erroring.
  -->
  <Target Name="CopyLibrariesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <LibraryPublishFiles Include="$(LibraryStagingDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibraryPublishFiles)"
          DestinationFiles="@(LibraryPublishFiles->'$(PublishDir)libraries\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(LibraryPublishFiles)' != ''" />
  </Target>

</Project>
