@page "/admin"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using KnockBox.Core.Plugins
@using KnockBox.Platform.Games
@using KnockBox.Services.Logic.Admin
@inject IAdminMetricsService Metrics
@inject ILobbyService LobbyService
@inject IEnumerable<IGameModule> GameModules

<PageTitle>Knockbox - Dashboard</PageTitle>

@* Static SSR snapshot — the page used to keep a circuit alive with a
   3-second timer. Auto-refresh now happens via a full reload so no render
   tree is retained for an idle admin tab. *@
<HeadContent>
    <meta http-equiv="refresh" content="5" />
</HeadContent>

@{
    var counts = LobbyService.GetLobbyCountsByRoute();
    var totalLobbies = counts.Values.Sum();
    var sortedModules = GameModules.OrderBy(m => m.Manifest.Name).ToArray();
}

<h1 class="admin-h1">Dashboard</h1>

<div class="admin-card-grid">
    <div class="admin-card">
        <div class="admin-card-label">Active Users</div>
        <div class="admin-card-value">@Metrics.ActiveCircuitCount</div>
        <div class="admin-card-sub">Connected Blazor circuits</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-label">Active Lobbies</div>
        <div class="admin-card-value">@totalLobbies</div>
        <div class="admin-card-sub">Across all games</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-label">CPU Usage</div>
        <div class="admin-card-value">@FormatCpu(Metrics.CpuUtilization)</div>
        <div class="admin-card-sub">Process utilization</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-label">Memory</div>
        <div class="admin-card-value">@FormatMemory(Metrics.MemoryUsageBytes)</div>
        <div class="admin-card-sub">Private bytes</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-label">Uptime</div>
        <div class="admin-card-value">@FormatUptime(Metrics.Uptime)</div>
        <div class="admin-card-sub">Since @Metrics.StartedAtUtc.ToString("u")</div>
    </div>
    <div class="admin-card">
        <div class="admin-card-label">Plugins Loaded</div>
        <div class="admin-card-value">@GameModules.Count()</div>
        <div class="admin-card-sub">Discovered game modules</div>
    </div>
</div>

<h2 class="admin-h2">Games running per type</h2>
<table class="admin-table">
    <thead>
        <tr>
            <th>Game</th>
            <th>Route</th>
            <th style="text-align:right">Active lobbies</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var module in sortedModules)
        {
            counts.TryGetValue(module.Manifest.RouteIdentifier, out var count);
            <tr>
                <td>@module.Manifest.Name</td>
                <td><code>@module.Manifest.RouteIdentifier</code></td>
                <td style="text-align:right">@count</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="admin-h2">Bound addresses</h2>
<table class="admin-table">
    <tbody>
        @if (Metrics.BoundAddresses.Count == 0)
        {
            <tr><td>(not reported yet)</td></tr>
        }
        else
        {
            @foreach (var address in Metrics.BoundAddresses)
            {
                <tr><td><code>@address</code></td></tr>
            }
        }
    </tbody>
</table>

@code {
    private static string FormatUptime(TimeSpan uptime)
    {
        if (uptime.TotalDays >= 1)
            return $"{(int)uptime.TotalDays}d {uptime.Hours}h {uptime.Minutes}m";
        if (uptime.TotalHours >= 1)
            return $"{uptime.Hours}h {uptime.Minutes}m";
        if (uptime.TotalMinutes >= 1)
            return $"{uptime.Minutes}m {uptime.Seconds}s";
        return $"{uptime.Seconds}s";
    }

    private static string FormatCpu(double utilization)
    {
        return (utilization * 100).ToString("F1") + "%";
    }

    private static string FormatMemory(long bytes)
    {
        if (bytes > 1024 * 1024 * 1024)
            return $"{(bytes / 1024.0 / 1024.0 / 1024.0):F2} GB";
        if (bytes > 1024 * 1024)
            return $"{(bytes / 1024.0 / 1024.0):F1} MB";
        return $"{(bytes / 1024.0):F0} KB";
    }
}
