@inject NavigationManager Nav

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/KnockBox.Platform/app.css"]" />
    <link rel="stylesheet" href="@Assets["KnockBox.styles.css"]" />
    @if (IsAdminRequest())
    {
        @* Admin styles live on a separate port and aren't reachable from the
           public site; emit the link here so the prerendered HTML carries it
           regardless of whether the page is static-SSR or interactive (with
           prerender disabled, HeadContent from inside AdminLayout never makes
           it into the initial response). *@
        <link rel="stylesheet" href="/admin/admin.css" />
    }
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Google+Sans+Code:ital,wght@0,300..800;1,300..800&family=Lexend:wght@100..900&display=swap" rel="stylesheet">
    <ImportMap />
    <link rel="icon" type="image/png" href="@Assets[_favicon]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="GetRenderMode()" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private bool IsAdminRequest()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        return rel.Equals("admin", StringComparison.OrdinalIgnoreCase)
            || rel.StartsWith("admin/", StringComparison.OrdinalIgnoreCase)
            || rel.StartsWith("admin?", StringComparison.OrdinalIgnoreCase);
    }

    private static readonly InteractiveServerRenderMode InteractiveServer = new(prerender: false);

    private static readonly string[] FaviconPaths =
    {
        "favicons/cat-orange.png",
        "favicons/cat-brown.png",
        "favicons/cat-cream.png",
        "favicons/cat-gray.png",
        "favicons/cat-sketch.png",
    };

    private string _favicon = FaviconPaths[0];

    protected override void OnInitialized()
    {
        _favicon = FaviconPaths[Random.Shared.Next(FaviconPaths.Length)];
    }

    // Login / logout require static SSR for cookie auth (HttpContext.SignInAsync,
    // [SupplyParameterFromForm]); returning null here keeps Routes static for those
    // requests so Blazor doesn't hand them to an interactive circuit.
    private IComponentRenderMode? GetRenderMode()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        if (rel.StartsWith("admin/login", StringComparison.OrdinalIgnoreCase)
            || rel.StartsWith("admin/logout", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }
        // The WASM migration spike page declares its own @rendermode
        // InteractiveWebAssembly. Keep the Routes host static (return null) for it
        // so a static→WebAssembly transition is used rather than nesting a WASM
        // page inside an InteractiveServer parent (which is not allowed).
        if (rel.StartsWith("spike/wasm", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }
        return InteractiveServer;
    }
}
