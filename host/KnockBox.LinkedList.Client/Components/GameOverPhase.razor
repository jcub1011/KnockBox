@*
    The end-of-match results: superlatives, group standings (competitive), the ranked "Linksmiths"
    scoreboard, and the final chain — all from the projected view. The host returns to the lobby via
    the hub (ReturnToLobby).
*@

@{
    var myId = View.RecipientId;
    var ranked = RankedPlayers;
    var finalChain = View.AllGroups.FirstOrDefault();
}

<div class="ll-gameover">

    <div class="ll-go-banner">
        <span class="ll-go-emoji">🏆</span>
        <h3 class="ll-go-headline">The Final Chain</h3>
        <p class="ll-go-sub">@View.RoundNumber round@(View.RoundNumber == 1 ? "" : "s") played</p>
    </div>

    @if (View.Superlatives.Count > 0)
    {
        <div class="ll-go-superlatives">
            @foreach (var s in View.Superlatives)
            {
                <div class="ll-superlative-card">
                    <span class="ll-superlative-emoji">@s.Emoji</span>
                    <div class="ll-superlative-body">
                        <span class="ll-superlative-title">@s.Title</span>
                        <span class="ll-superlative-player">@s.PlayerName</span>
                        <span class="ll-superlative-detail">@s.Detail</span>
                    </div>
                </div>
            }
        </div>
    }

    @if (IsGroups && View.Standings.Count > 0)
    {
        <div class="ll-go-scoreboard">
            <h4 class="ll-go-section-title">Final Group Standings</h4>
            <table class="ll-standings">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Group</th>
                        <th>@(PrimaryIsTime ? "Time" : "Guesses")</th>
                        <th class="ll-standings-secondary">@(PrimaryIsTime ? "Guesses" : "Time")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in View.Standings)
                    {
                        <tr class="@(s.Rank == 1 ? "ll-standings-top" : "")" style="--ll-route: var(--ll-route-@(ColorIndexOf(s.GroupId) % 6))">
                            <td>@RankMedal(s.Rank)</td>
                            <td>
                                @s.GroupName
                                @if (s.IsTieBreakWinner)
                                {
                                    <span class="ll-tiebreak">⚖️ tiebreak</span>
                                }
                                @if (!s.DestinationReached)
                                {
                                    <span class="ll-standings-dnf">DNF</span>
                                }
                            </td>
                            <td>@(PrimaryIsTime ? FormatElapsed(s.Elapsed) : s.Guesses.ToString())</td>
                            <td class="ll-standings-secondary">@(PrimaryIsTime ? s.Guesses.ToString() : FormatElapsed(s.Elapsed))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="ll-go-scoreboard">
        <h4 class="ll-go-section-title">Linksmiths</h4>
        <div class="ll-go-rows">
            @{ int rank = 1; }
            @foreach (var ps in ranked)
            {
                bool isMe = ps.PlayerId == myId;
                <div class="ll-go-row @(rank == 1 ? "ll-go-row-top" : "") @(isMe ? "ll-go-row-me" : "")">
                    <span class="ll-go-rank">@RankMedal(rank)</span>
                    <span class="ll-go-name">@ps.DisplayName</span>
                    <span class="ll-go-stats">
                        <span class="ll-go-stat" title="Accepted pairs">✅ @ps.AcceptedPairs</span>
                        <span class="ll-go-stat" title="Rejections received">🙅 @ps.RejectionsReceived</span>
                        @if (ps.LoopPairsMade > 0)
                        {
                            <span class="ll-go-stat" title="Loop pairs">🔁 @ps.LoopPairsMade</span>
                        }
                        @if (View.Settings.ScoringMode == ScoringMode.FastestTime && ps.FastestContribution is { } fc)
                        {
                            <span class="ll-go-stat" title="Fastest pair">⚡ @FormatElapsed(fc)</span>
                        }
                    </span>
                </div>
                rank++;
            }
        </div>
    </div>

    @if (finalChain is not null && finalChain.Chain.Count > 0)
    {
        <div class="ll-chain-card">
            <h4 class="ll-chain-title">Final Chain</h4>
            <div class="ll-chain">
                <span class="ll-anchor ll-anchor-start">@View.StartWord</span>
                @foreach (var link in finalChain.Chain)
                {
                    <span class="ll-connector">─</span>
                    <span class="ll-link @(link.IsLoop ? "ll-link-loop" : "")">
                        <span class="ll-link-pair">@link.FromWord → @link.ToWord</span>
                        <span class="ll-link-by">@link.PlayerName</span>
                        @if (link.IsLoop)
                        {
                            <span class="ll-loop-badge" title="This pair already appeared in the chain">↺ kink</span>
                        }
                    </span>
                }
                <span class="ll-connector @(finalChain.DestinationReached ? "" : "ll-connector-pending")">─</span>
                <span class="ll-anchor ll-anchor-dest @(finalChain.DestinationReached ? "ll-anchor-reached" : "")">
                    @View.DestinationWord
                </span>
            </div>
        </div>
    }

    @if (IsHost)
    {
        <div class="ll-go-actions">
            <button class="ll-btn ll-btn-primary" @onclick="ReturnToLobby" disabled="@_busy">
                @(_busy ? "Returning…" : "Return to Lobby")
            </button>
        </div>
    }
    else
    {
        <p class="ll-go-wait">Waiting for the host…</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public LinkedListView View { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, string?, Task<string?>> Submit { get; set; } = default!;
    [Parameter] public EventCallback<string> OnError { get; set; }

    private bool _busy;

    private bool IsHost => View.RecipientId == View.HostId;
    private bool IsGroups => View.Settings.PlayerStructure == PlayerStructure.Groups;
    private bool PrimaryIsTime => View.Settings.ScoringMode == ScoringMode.FastestTime;

    /// <summary>Players ranked for the scoreboard — by accepted pairs (most helpful first), fewest
    /// rejections breaking ties, then display name. Mirrors the old GameOver page's RankedPlayers.</summary>
    private IReadOnlyList<LinkedListPlayerScore> RankedPlayers =>
        [.. View.Scores
            .OrderByDescending(p => p.AcceptedPairs)
            .ThenBy(p => p.RejectionsReceived)
            .ThenBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase)];

    private int ColorIndexOf(string groupId) => View.AllGroups.FirstOrDefault(g => g.GroupId == groupId)?.ColorIndex ?? 0;

    private static string RankMedal(int rank) => rank switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => $"#{rank}",
    };

    private async Task ReturnToLobby()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var error = await Submit(LinkedListCommands.ReturnToLobby, null);
            if (!string.IsNullOrEmpty(error))
                await OnError.InvokeAsync(error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
        => elapsed >= TimeSpan.FromHours(1)
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:00}:{elapsed.Seconds:00}"
            : $"{elapsed.Minutes}:{elapsed.Seconds:00}";
}
