@*
    The post-round scoreboard. Reads the projected view: LastRoundResult (Collective) or Standings
    (Groups), and the now-public per-group chains in View.AllGroups. Host controls advance the match
    via the hub (NextRound / EndMatch).
*@

@{
    var myId = View.RecipientId;
    var isHost = myId == View.HostId;
    var result = View.LastRoundResult;

    RenderFragment<GroupChainView> chainView = g =>
    @<div class="ll-chain">
        <span class="ll-anchor ll-anchor-start">@View.StartWord</span>
        @foreach (var link in g.Chain)
        {
            <span class="ll-connector">─</span>
            <span class="ll-link @(link.IsLoop ? "ll-link-loop" : "")">
                <span class="ll-link-pair">@link.FromWord → @link.ToWord</span>
                <span class="ll-link-by">@link.PlayerName</span>
                @if (link.IsLoop)
                {
                    <span class="ll-loop-badge" title="This pair already appeared in the chain">↺ kink</span>
                }
            </span>
        }
        <span class="ll-connector @(g.DestinationReached ? "" : "ll-connector-pending")">─</span>
        <span class="ll-anchor ll-anchor-dest @(g.DestinationReached ? "ll-anchor-reached" : "")">
            @View.DestinationWord
        </span>
    </div>;
}

<div class="ll-roundover">

    @if (!IsGroups)
    {
        var chain = View.AllGroups.FirstOrDefault();
        bool reached = result?.DestinationReached ?? chain?.DestinationReached ?? false;

        @if (reached)
        {
            <div class="ll-ro-banner ll-ro-success">
                <span class="ll-ro-emoji">🔗</span>
                <h3 class="ll-ro-headline">Chain complete!</h3>
                <p class="ll-ro-sub">@View.StartWord ➜ @View.DestinationWord</p>
            </div>
        }
        else
        {
            <div class="ll-ro-banner ll-ro-stalled">
                <span class="ll-ro-emoji">⛓️‍💥</span>
                <h3 class="ll-ro-headline">Chain broke</h3>
                <p class="ll-ro-sub">The chain didn't reach @View.DestinationWord this time.</p>
            </div>
        }

        @if (result is not null)
        {
            <div class="ll-ro-score">
                @if (result.Mode == ScoringMode.FewestGuesses)
                {
                    <div class="ll-ro-metric">
                        <span class="ll-ro-metric-value">@result.Guesses</span>
                        <span class="ll-ro-metric-label">accepted pair@(result.Guesses == 1 ? "" : "s")</span>
                    </div>

                    @if (result.Par is int par)
                    {
                        <div class="ll-ro-par @(result.BeatPar ? "ll-ro-par-good" : "ll-ro-par-over")">
                            Par @par · You: @result.Guesses —
                            @if (result.BeatPar)
                            {
                                <strong>@(result.Guesses < par ? "under par!" : "right on par!")</strong>
                            }
                            else
                            {
                                <strong>@(result.Guesses - par) over par</strong>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="ll-ro-metric">
                        <span class="ll-ro-metric-value">@FormatElapsed(result.Elapsed)</span>
                        <span class="ll-ro-metric-label">thinking time</span>
                    </div>
                    <p class="ll-ro-par">Auditor deliberation didn't count — only the seconds the team spent thinking.</p>
                }
            </div>
        }

        @if (chain is not null)
        {
            <div class="ll-chain-card">
                <h4 class="ll-chain-title">The Chain</h4>
                @chainView(chain)
            </div>
        }
    }
    else
    {
        <div class="ll-ro-banner ll-ro-success">
            <span class="ll-ro-emoji">🔗</span>
            <h3 class="ll-ro-headline">Round complete</h3>
            <p class="ll-ro-sub">@View.StartWord ➜ @View.DestinationWord</p>
        </div>

        <div class="ll-standings-card">
            <h4 class="ll-chain-title">Standings</h4>
            <table class="ll-standings">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Group</th>
                        <th>@(PrimaryIsTime ? "Time" : "Guesses")</th>
                        <th class="ll-standings-secondary">@(PrimaryIsTime ? "Guesses" : "Time")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in View.Standings)
                    {
                        <tr class="@(s.Rank == 1 ? "ll-standings-top" : "")" style="--ll-route: var(--ll-route-@(ColorIndexOf(s.GroupId) % 6))">
                            <td>@RankMedal(s.Rank)</td>
                            <td>
                                @s.GroupName
                                @if (s.IsTieBreakWinner)
                                {
                                    <span class="ll-tiebreak" title="Won a tie on the @(PrimaryIsTime ? "time" : "guess") metric via the tiebreaker">⚖️ tiebreak</span>
                                }
                                @if (!s.DestinationReached)
                                {
                                    <span class="ll-standings-dnf" title="Did not reach the destination">DNF</span>
                                }
                            </td>
                            <td>@(PrimaryIsTime ? FormatElapsed(s.Elapsed) : s.Guesses.ToString())</td>
                            <td class="ll-standings-secondary">@(PrimaryIsTime ? s.Guesses.ToString() : FormatElapsed(s.Elapsed))</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="ll-ro-par">Ties on @(PrimaryIsTime ? "time" : "guesses") break by @(PrimaryIsTime ? "fewer guesses" : "less thinking time").</p>
        </div>

        @foreach (var s in View.Standings)
        {
            var g = ChainOf(s.GroupId);
            if (g is null) { continue; }
            <div class="ll-chain-card" style="--ll-route: var(--ll-route-@(g.ColorIndex % 6))">
                <h4 class="ll-chain-title">@RankMedal(s.Rank) @g.GroupName</h4>
                @chainView(g)
            </div>
        }
    }

    @* ── Match progress + next Auditor ── *@
    <div class="ll-ro-progress">
        <span class="ll-round-chip">Round @View.RoundNumber / @View.Settings.RoundsPerMatch</span>
        @if (!IsLastRound)
        {
            <span class="ll-ro-next-auditor">Next Auditor: <strong>@View.NextAuditorName</strong></span>
        }
    </div>

    @if (isHost)
    {
        <div class="ll-ro-actions">
            @if (IsLastRound)
            {
                <button class="ll-btn ll-btn-primary" @onclick="EndMatch" disabled="@_busy">
                    @(_busy ? "Wrapping up…" : "View Results 🏆")
                </button>
            }
            else
            {
                <button class="ll-btn ll-btn-primary" @onclick="NextRound" disabled="@_busy">
                    @(_busy ? "Starting…" : "Next round")
                </button>
                <button class="ll-btn ll-btn-ghost" @onclick="EndMatch" disabled="@_busy">
                    End match early
                </button>
            }
        </div>
    }
    else
    {
        <p class="ll-ro-wait">
            @(IsLastRound
                ? "Waiting for the host to show the final results…"
                : "Waiting for the host to start the next round…")
        </p>
    }
</div>

@code {
    [Parameter, EditorRequired] public LinkedListView View { get; set; } = default!;
    [Parameter, EditorRequired] public Func<string, string?, Task<string?>> Submit { get; set; } = default!;
    [Parameter] public EventCallback<string> OnError { get; set; }

    private bool _busy;

    private bool IsGroups => View.Settings.PlayerStructure == PlayerStructure.Groups;
    private bool PrimaryIsTime => View.Settings.ScoringMode == ScoringMode.FastestTime;
    private bool IsLastRound => View.RoundNumber >= View.Settings.RoundsPerMatch;

    private GroupChainView? ChainOf(string groupId) => View.AllGroups.FirstOrDefault(g => g.GroupId == groupId);
    private int ColorIndexOf(string groupId) => ChainOf(groupId)?.ColorIndex ?? 0;

    private static string RankMedal(int rank) => rank switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => $"#{rank}",
    };

    private async Task NextRound() => await Advance(LinkedListCommands.NextRound);
    private async Task EndMatch() => await Advance(LinkedListCommands.EndMatch);

    private async Task Advance(string command)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var error = await Submit(command, null);
            if (!string.IsNullOrEmpty(error))
                await OnError.InvokeAsync(error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatElapsed(TimeSpan elapsed)
        => elapsed >= TimeSpan.FromHours(1)
            ? $"{(int)elapsed.TotalHours}:{elapsed.Minutes:00}:{elapsed.Seconds:00}"
            : $"{elapsed.Minutes}:{elapsed.Seconds:00}";
}
