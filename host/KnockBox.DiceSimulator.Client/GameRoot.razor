@inherits HubLobbyPageBase<DiceSimulatorView>
@inject IJSRuntime JS
@*
    GameRoot — the runtime-loaded WASM UI entry point for Dice Simulator.

    Resolved by the client loader via {RootNamespace}.GameRoot (or the explicit
    IGameClientModule in GameClientModule.cs) and rendered from an assembly the WASM
    client never referenced at build time. Inheriting HubLobbyPageBase<DiceSimulatorView>
    opens the hub, joins the lobby, deserializes each per-player projection into `View`,
    and disposes on teardown.
*@

@* The game ships its own stylesheet from the server plugin's mounted wwwroot. A
   runtime-loaded WASM component can't use HeadContent (the HeadOutlet runs in a
   different render mode), and the streamed .Client DLL has no RCL scoped-CSS bundle,
   so we link the plain stylesheet here; browsers honor a body-placed stylesheet link. *@
<link rel="stylesheet" href="_content/KnockBox.DiceSimulator/css/dice-simulator.css" />

<DiceSimulatorHeader Code="@LobbyCode" OnLeave="LeaveAsync" />

<div class="ds-root">
@if (View is null)
{
    <div>Loading...</div>
}
else
{
    @if (View.IsJoinable)
    {
        <div class="card">
            <div class="joinable-state">
                <h4>Players</h4>
                <div class="player-list">
                    @foreach (var entry in View.Roster)
                    {
                        @if (entry.IsHost)
                        {
                            <button class="btn" disabled>@entry.DisplayName (Host)</button>
                        }
                        else if (IsHost)
                        {
                            <button class="btn" title="Click to kick player."
                                    @onclick="() => KickPlayer(entry.PlayerId)">@entry.DisplayName</button>
                        }
                        else
                        {
                            <button class="btn" disabled>@entry.DisplayName</button>
                        }
                    }
                </div>
                @if (IsHost)
                {
                    <button class="btn btn-primary start-btn mt-3" @onclick="StartGame">Start Session</button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <h3>Roll Controls</h3>
            <div class="labeled-input">
                <label>Dice</label>
                <div class="dice-options">
                    @foreach (var type in Enum.GetValues<DiceType>())
                    {
                        <button class="btn @(RollAction.DiceType == type ? "btn-primary" : "btn-outline-primary")" @onclick="() => RollAction.DiceType = type">d@((int)type)</button>
                    }
                </div>
            </div>
            <div class="input-row">
                <div class="labeled-input">
                    <label>Count: @RollAction.DiceCount</label>
                    <input type="number" class="form-control" min="1" max="99" @bind="RollAction.DiceCount" />
                </div>
                <div class="labeled-input">
                    <label>Modifier: @(RollAction.Modifier >= 0 ? "+" : "")@RollAction.Modifier</label>
                    <input type="number" class="form-control" @bind="RollAction.Modifier" />
                </div>
                <div class="labeled-input">
                    <label>Expression:</label>
                    <div class="expression-preview form-control">
                        @RollAction.DiceCount@("d")@((int)RollAction.DiceType)@(RollAction.Modifier == 0 ? "" : (RollAction.Modifier > 0 ? $"+{RollAction.Modifier}" : RollAction.Modifier.ToString()))
                    </div>
                </div>
            </div>
            <div class="labeled-input">
                <label>Mode</label>
                <select class="form-control" @bind="RollAction.Mode">
                    @foreach (var mode in Enum.GetValues<RollMode>())
                    {
                        <option value="@mode">@mode</option>
                    }
                </select>
            </div>
            <div class="input-row">
                <button class="btn btn-success flex-1" @onclick="RollDice">ROLL!</button>
                @if (IsHost)
                {
                    <button class="btn btn-danger" @onclick="ClearHistory">Clear History</button>
                }
            </div>
            <div class="">
                @if (View.RollHistory.Where(r => r.PlayerId == View.RecipientId).LastOrDefault() is { } lastRoll)
                {
                    <div class="alert alert-info">
                        <strong>Last Roll:</strong> @lastRoll.Expression = @lastRoll.Result <br/>
                        <small>Mode: @lastRoll.Mode | Rolled: @string.Join(", ", lastRoll.RawRolls)</small>
                    </div>
                }
            </div>
        </div>
        <div class="right-column">
            <div class="leaderboard-panel card">
                <h4>Leaderboard</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-striped table">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Rolls</th>
                                <th class="ds-hide-sm">Dice Rolled</th>
                                <th>Crits</th>
                                <th>Highest</th>
                                <th>Cumulative</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stats in View.Leaderboard)
                            {
                                <tr>
                                    <td>@stats.PlayerName</td>
                                    <td>@stats.TotalRolls</td>
                                    <td class="ds-hide-sm">@stats.TotalDiceRolled</td>
                                    <td><span class="nat-twenty">@stats.NatTwentyCount</span> / <span class="nat-one">@stats.NatOneCount</span></td>
                                    <td>@stats.HighestResult (@stats.HighestResultExpression)</td>
                                    <td>@stats.CumulativeTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="d-flex justify-content-between align-items-center">
                    <h4>Player Rolls</h4>
                    <button class="btn btn-sm btn-outline-secondary export-btn" @onclick="ExportCsv">Export CSV</button>
                </div>
                <div class="player-rolls-list">
                    @foreach (var entry in View.Roster)
                    {
                        var playerId = entry.PlayerId;
                        var playerRolls = View.RollHistory.Where(r => r.PlayerId == playerId).ToList();
                        var playerLastRoll = playerRolls.LastOrDefault();
                        var playerRollCount = playerRolls.Count;
                        var displayRolls = playerRolls.AsEnumerable().Reverse().Take(200).ToList();
                        var isExpanded = IsPlayerExpanded(playerId);

                        <div class="player-roll-row" @onclick="() => TogglePlayerHistory(playerId)">
                            <div class="player-roll-summary">
                                <span class="player-roll-name">@entry.DisplayName</span>
                                @if (playerLastRoll is not null)
                                {
                                    <span class="player-roll-result">#@playerRollCount &mdash; @playerLastRoll.Expression = <strong>@playerLastRoll.Result</strong></span>
                                    <span class="player-roll-time">
                                        @((DateTimeOffset.UtcNow - playerLastRoll.Timestamp).TotalSeconds < 60
                                            ? "Just now"
                                            : $"{(int)(DateTimeOffset.UtcNow - playerLastRoll.Timestamp).TotalMinutes}m ago")
                                    </span>
                                }
                                else
                                {
                                    <span class="player-roll-empty">No rolls yet</span>
                                }
                                <span class="player-roll-toggle">@(isExpanded ? "-" : "+")</span>
                            </div>
                        </div>

                        <div class="player-roll-history-wrapper @(isExpanded ? "expanded" : "")">
                            <div class="player-roll-history list">
                                @for (int i = 0; i < displayRolls.Count; i++)
                                {
                                    var roll = displayRolls[i];
                                    var rollNumber = playerRolls.Count - i;
                                    <div class="list-group-item flex-column align-items-start">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6>#@rollNumber &mdash; @roll.Expression = @roll.Result</h6>
                                            <small>@((DateTimeOffset.UtcNow - roll.Timestamp).TotalSeconds < 60 ? "Just now" : $"{(int)(DateTimeOffset.UtcNow - roll.Timestamp).TotalMinutes}m ago")</small>
                                        </div>
                                        <p>
                                            @if (roll.Mode != RollMode.Normal && roll.AltRolls != null)
                                            {
                                                <span>(@roll.Mode &mdash; kept: @(roll.RawRolls.Sum()) [@string.Join(",", roll.RawRolls)] | alt: @roll.AltTotal [@string.Join(",", roll.AltRolls)])</span>
                                            }
                                            else
                                            {
                                                <span>(rolls: @string.Join(",", roll.RawRolls) @(roll.Modifier != 0 ? (roll.Modifier > 0 ? $"+ {roll.Modifier}" : $"- {Math.Abs(roll.Modifier)}") : ""))</span>
                                            }
                                        </p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
</div>

@code {
    /// <summary>The lobby code from the room URL, supplied by the WASM host page.</summary>
    [Parameter] public string Code { get; set; } = "";

    /// <summary>The player's chosen display name, propagated from the home page.</summary>
    [Parameter] public string? PlayerName { get; set; }

    protected override string RouteIdentifier => "dice-simulator";
    protected override string LobbyUri => $"room/dice-simulator/{Code}";
    protected override string DisplayName => string.IsNullOrWhiteSpace(PlayerName) ? "Player" : PlayerName!;

    private DiceRollAction RollAction { get; set; } = new();
    private readonly HashSet<Guid> _expandedPlayerIds = [];

    public GameRoot()
        : base(new SourceGenProjectionDeserializer<DiceSimulatorView>(
            DiceSimulatorContractsJsonContext.Default.DiceSimulatorView))
    {
    }

    private bool IsHost => View is not null && View.RecipientId == View.HostId;

    private void TogglePlayerHistory(Guid playerId)
    {
        if (!_expandedPlayerIds.Add(playerId))
            _expandedPlayerIds.Remove(playerId);
    }

    private bool IsPlayerExpanded(Guid playerId) => _expandedPlayerIds.Contains(playerId);

    private Task StartGame() => SubmitCommandAsync(DiceSimulatorCommands.Start);

    private Task RollDice()
        => SubmitCommandAsync(
            DiceSimulatorCommands.RollDice,
            JsonSerializer.Serialize(RollAction, DiceSimulatorContractsJsonContext.Default.DiceRollAction));

    private Task ClearHistory() => SubmitCommandAsync(DiceSimulatorCommands.ClearHistory);

    private Task KickPlayer(Guid playerId)
        // A GUID's JSON form is just its quoted string; build it directly to avoid a
        // reflection-based serializer call in the trimmed client.
        => SubmitCommandAsync(DiceSimulatorCommands.KickPlayer, $"\"{playerId}\"");

    private IJSObjectReference? _fileExport;

    private async Task ExportCsv()
    {
        if (View is null)
            return;

        // Load the download helper as an ES module from the server plugin's mounted
        // wwwroot — a <script> rendered into the body wouldn't execute.
        _fileExport ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/KnockBox.DiceSimulator/js/fileExport.js");

        var csvBytes = CsvExportService.GenerateCsv(View.RollHistory);
        var base64 = Convert.ToBase64String(csvBytes);
        var timestamp = DateTimeOffset.UtcNow.ToString("yyyyMMddTHHmmssZ");
        var filename = $"DnD-Rolls-{Code}-{timestamp}.csv";
        await _fileExport.InvokeVoidAsync("downloadCsvFile", filename, base64);
    }
}
