<div class="game-tile-surface dndm-tile">
    <svg class="dndm-tile-canvas" aria-hidden="true" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
        <defs>
            <pattern id="dndm-tile-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path class="dndm-tile-grid-line" d="M 20 0 L 0 0 0 20" />
            </pattern>
            <radialGradient id="dndm-tile-glow" cx="0.5" cy="1" r="0.85">
                <stop offset="0%" stop-color="rgba(232, 144, 85, 0.18)" />
                <stop offset="100%" stop-color="rgba(232, 144, 85, 0)" />
            </radialGradient>
        </defs>

        <rect class="dndm-tile-grid-rect" width="200" height="200" />
        <rect class="dndm-tile-grid-glow" width="200" height="200" />

        <!-- Discovered corridor / wall outline -->
        <path class="dndm-tile-wall" d="M 18 95 L 92 95 L 92 115 L 184 115" />

        <!-- Allied tokens (warm ember) -->
        <circle class="dndm-tile-token dndm-tile-token--ally" cx="48" cy="56" r="7" />
        <circle class="dndm-tile-token dndm-tile-token--ally" cx="76" cy="78" r="6" />

        <!-- Foe tokens (rust) -->
        <circle class="dndm-tile-token dndm-tile-token--foe" cx="158" cy="48" r="7" />
        <circle class="dndm-tile-token dndm-tile-token--foe" cx="134" cy="72" r="6" />
    </svg>

    <!-- d20 die — corner ornament -->
    <svg class="dndm-tile-die" aria-hidden="true" viewBox="0 0 64 64">
        <polygon class="dndm-tile-die-shell" points="32,6 54,19 54,45 32,58 10,45 10,19" />
        <polygon class="dndm-tile-die-face dndm-tile-die-face--bright" points="32,6 54,19 32,32" />
        <polygon class="dndm-tile-die-face dndm-tile-die-face--dim" points="32,6 10,19 32,32" />
        <polygon class="dndm-tile-die-face dndm-tile-die-face--mid" points="32,32 32,58 10,45" />
        <text class="dndm-tile-die-num" x="32" y="49" text-anchor="middle">20</text>
    </svg>

    <!-- Title plaque pinned to the bottom -->
    <div class="dndm-tile-plaque">
        <div class="dndm-tile-name">
            <span class="dndm-tile-name-drop">D</span><span class="dndm-tile-name-rest">nD&nbsp;Mapper</span>
        </div>
        <div class="dndm-tile-tag">Collaborative Tabletop Maps</div>
    </div>
</div>
