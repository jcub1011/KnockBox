@inherits DisposableComponent

<section class="dndm-panel">
    <header class="dndm-panel-header">
        <span>Map Layers</span>
        <ImageUploadButton State="State" Compact="true" />
    </header>
    <div class="dndm-panel-body dndm-layers-body">
        @if (ActiveMap is null)
        {
            <div class="dndm-panel-empty">No active map.</div>
        }
        else if (ActiveMap.Images.Length == 0)
        {
            <div class="dndm-panel-empty">No image layers yet. Use the upload icon above to add one.</div>
        }
        else
        {
            <ul class="dndm-layers-list">
                @foreach (var img in ActiveMap.Images.OrderByDescending(i => i.LayerOrder))
                {
                    var selected = img.Id == SelectedImageId;
                    var hidden = img.Hidden;
                    var cls = "dndm-layer-row"
                        + (selected ? " dndm-layer-row--selected" : string.Empty)
                        + (hidden ? " dndm-layer-row--hidden" : string.Empty);
                    <li @key="img.Id" class="@cls">
                        <div class="dndm-layer-clickarea"
                             @onclick="@(() => OnRowClick(img))">
                            @{
                                var thumbSrc = ResolveImageSrc(img);
                            }
                            @if (thumbSrc is not null)
                            {
                                <img class="dndm-layer-thumb"
                                     src="@thumbSrc"
                                     alt="layer @img.LayerOrder" />
                            }
                            else
                            {
                                <div class="dndm-layer-thumb dndm-layer-thumb--placeholder"
                                     title="Image share offline; will reconnect shortly."></div>
                            }
                            @if (_renamingImageId == img.Id)
                            {
                                <input class="dndm-input dndm-layer-name-input"
                                       @ref="_renameInputRef"
                                       value="@_renameLayerDraft"
                                       @oninput="OnLayerRenameInput"
                                       @onkeydown="OnLayerRenameKeyDown"
                                       @onblur="CommitLayerRename"
                                       @onclick:stopPropagation="true"
                                       @ondblclick:stopPropagation="true" />
                            }
                            else
                            {
                                <span class="dndm-layer-name"
                                      title="Double-click to rename"
                                      @ondblclick="@(() => BeginLayerRename(img))"
                                      @ondblclick:stopPropagation="true">
                                    @img.DisplayName
                                </span>
                                @if (img.WasDownscaled && img.OriginalLongEdgePx > 0 && img.DisplayLongEdgePx > 0)
                                {
                                    var tip = $"Downscaled for performance: {img.OriginalLongEdgePx:N0}px → {img.DisplayLongEdgePx:N0}px on the long edge.";
                                    <span class="dndm-layer-downscale-badge"
                                          title="@tip"
                                          aria-label="@tip">⤓</span>
                                }
                            }
                        </div>
                        <button class="dndm-btn dndm-btn--small dndm-btn--icon dndm-layer-eyebtn"
                                type="button"
                                title="@(hidden ? "Hidden — click to show" : "Visible — click to hide")"
                                @onclick="@(() => ToggleHidden(img))"
                                @onclick:stopPropagation="true">
                            @TokenIcons.Eye(!hidden)
                        </button>
                        <button class="dndm-btn dndm-btn--small dndm-btn--icon dndm-layer-lockbtn"
                                type="button"
                                title="@(img.Locked ? "Locked — click to unlock" : "Unlocked — click to lock")"
                                @onclick="@(() => ToggleLocked(img))"
                                @onclick:stopPropagation="true">
                            @(img.Locked ? "🔒" : "🔓")
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
</section>
