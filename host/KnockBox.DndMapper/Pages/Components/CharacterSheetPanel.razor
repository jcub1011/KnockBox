@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Helpers
@using KnockBox.DndMapper.Models
@using KnockBox.DndMapper.Services.Logic.Visibility
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

<section class="dndm-panel dndm-sheet">
    <header class="dndm-panel-header">
        <span>Character Sheet</span>
        <span class="dndm-sheet-header-actions">
            @if (IsHost)
            {
                <button class="dndm-btn dndm-btn--small dndm-btn--icon"
                        type="button"
                        title="Create a host-only NPC/monster sheet"
                        @onclick="OpenNpcModal">+</button>
                @if (ActiveSheet is { } activeForDup)
                {
                    <button class="dndm-btn dndm-btn--small dndm-btn--icon"
                            type="button"
                            title="Duplicate current sheet"
                            @onclick="@(() => OnDuplicateSheet(activeForDup))">⎘</button>
                }
                <button class="dndm-btn dndm-btn--small dndm-btn--icon"
                        type="button"
                        title="Sheet settings"
                        @onclick="OpenSheetSettings">⚙</button>
            }
            else if (!HasOwnSheet)
            {
                <button class="dndm-btn dndm-btn--small"
                        type="button"
                        title="Create your character sheet"
                        @onclick="CreateMySheet">+ My Sheet</button>
            }
        </span>
    </header>

    @if (VisibleSheets.Count == 0)
    {
        <div class="dndm-panel-empty">No character sheets yet.</div>
    }
    else
    {
        <div class="dndm-sheet-tabbar">
            @if (VisibleSheets.Count > 4)
            {
                var activeId = ActiveSheet?.Id;
                <div class="dndm-sheet-tabs dndm-sheet-tabs--dropdown">
                    @if (_renamingSheetId is not null && ActiveSheet is not null)
                    {
                        <input class="dndm-input dndm-sheet-tab-rename"
                               @ref="_renameInputRef"
                               value="@_renameSheetDraft"
                               @oninput="OnRenameInput"
                               @onkeydown="OnRenameKeyDown"
                               @onblur="CommitSheetRename" />
                    }
                    else
                    {
                        <select class="dndm-select dndm-sheet-tab-select"
                                @onchange="@(e => OnSheetDropdownChanged((string?)e.Value))">
                            @foreach (var s in VisibleSheets.OrderBy(s => s.CharacterName, StringComparer.OrdinalIgnoreCase))
                            {
                                <option value="@s.Id" selected="@(activeId == s.Id)">
                                    @(string.IsNullOrEmpty(s.CharacterName) ? "(unnamed)" : s.CharacterName)
                                </option>
                            }
                        </select>
                        @if (ActiveSheet is { } dropdownActive)
                        {
                            <button class="dndm-btn dndm-btn--small dndm-btn--icon dndm-btn--ghost"
                                    type="button"
                                    title="Rename selected sheet"
                                    @onclick="@(() => BeginSheetRename(dropdownActive))">
                                <span class="dndm-rename-icon" aria-hidden="true">R<svg viewBox="0 0 6 14" width="6" height="14"
                                         fill="none" stroke="currentColor" stroke-width="1.2"
                                         stroke-linecap="round">
                                        <line x1="3" y1="2" x2="3" y2="12" />
                                        <line x1="1" y1="2" x2="5" y2="2" />
                                        <line x1="1" y1="12" x2="5" y2="12" />
                                    </svg></span>
                            </button>
                        }
                    }
                </div>
            }
            else
            {
                <div class="dndm-sheet-tabs" role="tablist">
                    @{
                        var effectiveActiveId = _activeSheetId ?? ActiveSheet?.Id;
                    }
                    @foreach (var s in VisibleSheets)
                    {
                        var active = s.Id == effectiveActiveId;
                        if (_renamingSheetId == s.Id)
                        {
                            <input @key="@($"rename-{s.Id}")"
                                   class="dndm-input dndm-sheet-tab-rename"
                                   @ref="_renameInputRef"
                                   value="@_renameSheetDraft"
                                   @oninput="OnRenameInput"
                                   @onkeydown="OnRenameKeyDown"
                                   @onblur="CommitSheetRename" />
                        }
                        else
                        {
                            <button @key="s.Id"
                                    class="@($"dndm-sheet-tab{(active ? " dndm-sheet-tab--active" : "")}")"
                                    type="button"
                                    role="tab"
                                    title="Double-click to rename"
                                    @onclick="@(() => SelectSheet(s.Id))"
                                    @ondblclick="@(() => BeginSheetRename(s))">
                                @(string.IsNullOrEmpty(s.CharacterName) ? "(unnamed)" : s.CharacterName)
                            </button>
                        }
                    }
                </div>
            }
            @if (IsHost && ActiveSheet is { } activeForDelete && _renamingSheetId is null)
            {
                <button class="dndm-btn dndm-btn--small dndm-btn--icon dndm-btn--danger dndm-sheet-tabbar-delete"
                        type="button"
                        title="Delete current character sheet"
                        @onclick="@(() => RequestDeleteSheet(activeForDelete))">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 6 5 6 21 6" />
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                        <line x1="10" y1="11" x2="10" y2="17" />
                        <line x1="14" y1="11" x2="14" y2="17" />
                        <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" />
                    </svg>
                </button>
            }
        </div>

        @if (ActiveSheet is { } sheet)
        {
            var canEdit = SheetVisibilityHelper.CanEdit(sheet, CurrentUserId, IsHost, State.Settings.SheetEditByOthers);
            var canSeePrivate = SheetVisibilityHelper.CanSeeNotesAndHp(sheet, CurrentUserId, IsHost);
            var activeMap = State.ActiveMapId is { } amid ? State.Maps.FirstOrDefault(m => m.Id == amid) : null;

            <div class="dndm-panel-body dndm-sheet-body">
                @if (sheet.OwnerUserId is null && sheet.RepresentsUserId is not null)
                {
                    <div class="dndm-sheet-origin" title="This character was orphaned when its player left the session.">
                        Originally a player character
                    </div>
                }
                @if (IsHost && sheet.OwnerUserId is null)
                {
                    // A character's tokens may span multiple maps via a shared SheetId;
                    // exclude players who already own a different sheet OR a PlayerToken
                    // on any map this character has a token on — those collide with the
                    // engine's promotion guards and would only surface as a toast error.
                    var affectedMapIds = State.Maps
                        .SelectMany(m => m.Tokens)
                        .Where(t => t.SheetId == sheet.Id)
                        .Select(t => t.MapId)
                        .ToHashSet();
                    var blockedByToken = State.Maps
                        .Where(m => affectedMapIds.Contains(m.Id))
                        .SelectMany(m => m.Tokens)
                        .Where(t => t.Type == TokenType.PlayerToken && t.OwnerUserId is not null)
                        .Select(t => t.OwnerUserId!)
                        .ToHashSet();
                    var blockedBySheet = State.Sheets.Values
                        .Where(s => s.OwnerUserId is not null && s.Id != sheet.Id)
                        .Select(s => s.OwnerUserId!)
                        .ToHashSet();
                    var eligible = State.Players
                        .Where(p => !blockedByToken.Contains(p.User.Id) && !blockedBySheet.Contains(p.User.Id))
                        .ToList();
                    if (eligible.Count > 0)
                    {
                        <div class="dndm-sheet-assign">
                            <label class="dndm-label" title="Hand this character (sheet + every token referencing it) to a player">
                                <span>Assign to</span>
                                <select class="dndm-select"
                                        value=""
                                        @onchange="@(e => OnAssignSheetToPlayer(sheet, (string?)e.Value))">
                                    <option value="">— give to player —</option>
                                    @foreach (var p in eligible)
                                    {
                                        <option value="@p.User.Id">@p.DisplayName</option>
                                    }
                                </select>
                            </label>
                        </div>
                    }
                }

                @* Color + scope row — host-only. Color cascades to every token
                   linked to this sheet via Token.ResolveColor. Scope null = global,
                   non-null = visible only when that map is active. *@
                @if (IsHost)
                {
                    <div class="dndm-sheet-meta-row">
                        <label class="dndm-label dndm-sheet-meta-color">
                            <span>Color</span>
                            <input type="color"
                                   class="dndm-color"
                                   value="@(string.IsNullOrEmpty(sheet.Color) ? "#888888" : sheet.Color)"
                                   @onchange="@(e => OnColorChange(sheet, (string?)e.Value))" />
                        </label>
                        <label class="dndm-label dndm-sheet-meta-scope">
                            <span>Scope</span>
                            <select class="dndm-select"
                                    @onchange="@(e => OnScopeChange(sheet, (string?)e.Value))">
                                <option value="" selected="@(sheet.ScopedMapId is null)">All maps</option>
                                @if (activeMap is not null)
                                {
                                    <option value="@activeMap.Id" selected="@(sheet.ScopedMapId == activeMap.Id)">
                                        Only "@activeMap.Name"
                                    </option>
                                }
                                @* If the sheet is scoped to a map other than the active map,
                                   show that as a disabled option so the user can see the binding. *@
                                @if (sheet.ScopedMapId is { } sid && sid != activeMap?.Id)
                                {
                                    var scopedMap = State.Maps.FirstOrDefault(m => m.Id == sid);
                                    <option value="@sid" selected="true">
                                        Only "@(scopedMap?.Name ?? "(unknown map)")"
                                    </option>
                                }
                            </select>
                        </label>
                    </div>
                }

                <table class="dndm-sheet-attr-table">
                    <colgroup>
                        <col span="1" style="width: 100%;"/>
                        <col span="1" style="width: 80px;"/>
                        <col span="1" style="width: 65px;"/>
                        <col span="1" style="width: 75px;"/>
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="dndm-sheet-attr-col-name">Attribute</th>
                            <th class="dndm-sheet-attr-col-base">Level</th>
                            <th class="dndm-sheet-attr-col-effects" title="Sum of attribute deltas from active status effects.">Effects</th>
                            <th class="dndm-sheet-attr-col-adj" title="The modifier added to rolls — (Base + Status Effects) through this attribute's scoring mode.">Roll Mod.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in State.AttributeSchema.Rows)
                        {
                            var current = sheet.Values.TryGetValue(row.Name, out var v) ? v : row.Default;
                            // Prefer the local draft value (per-keystroke editing) over
                            // the committed state so typing feels responsive. When no
                            // draft exists for this attribute, fall back to the current
                            // sheet value rendered as its native string.
                            var draftRaw = _attrDrafts.TryGetValue(row.Name, out var dv) ? dv : null;
                            var contrib = AttributeContributionResolver.Resolve(sheet, row.Name, current);
                            var effectDelta = (contrib.EffectiveValue.IntValue ?? 0) - (current.IntValue ?? 0);
                            var effectsCls = effectDelta == 0 ? "" : effectDelta < 0 ? "is-neg" : "is-pos";
                            <tr @key="row.Name">
                                <td class="dndm-sheet-attr-col-name">@row.Name</td>
                                <td class="dndm-sheet-attr-col-base">
                                    @switch (row.Type)
                                    {
                                        case AttributeValueType.Score:
                                            <input type="number"
                                                   class="dndm-input dndm-input--num"
                                                   value="@(draftRaw ?? (current.IntValue ?? 10).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                   disabled="@(!canEdit)"
                                                   @oninput="@(e => OnAttributeInput(sheet, row, (string?)e.Value))"
                                                   @onblur="@(() => FlushPendingCommitAsync())" />
                                            break;
                                        case AttributeValueType.Modifier:
                                            <input type="number"
                                                   class="dndm-input dndm-input--num"
                                                   value="@(draftRaw ?? (current.IntValue ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                   disabled="@(!canEdit)"
                                                   @oninput="@(e => OnAttributeInput(sheet, row, (string?)e.Value))"
                                                   @onblur="@(() => FlushPendingCommitAsync())" />
                                            break;
                                        case AttributeValueType.Text:
                                            <input class="dndm-input"
                                                   value="@(draftRaw ?? (current.StringValue ?? string.Empty))"
                                                   disabled="@(!canEdit)"
                                                   @oninput="@(e => OnAttributeInput(sheet, row, (string?)e.Value))"
                                                   @onblur="@(() => FlushPendingCommitAsync())" />
                                            break;
                                    }
                                </td>
                                <td class="@($"dndm-sheet-attr-col-effects {effectsCls}")"
                                    title="@FormatBreakdown(contrib.ValueBreakdown)">
                                    @if (row.Type == AttributeValueType.Text)
                                    {
                                        <span class="dndm-sheet-attr-dash">—</span>
                                    }
                                    else if (effectDelta == 0)
                                    {
                                        <span class="dndm-sheet-attr-dash">—</span>
                                    }
                                    else
                                    {
                                        @FormatMod(effectDelta)
                                    }
                                </td>
                                <td class="dndm-sheet-attr-col-adj">
                                    @if (row.Type == AttributeValueType.Text)
                                    {
                                        <span class="dndm-sheet-attr-dash">—</span>
                                    }
                                    else
                                    {
                                        @FormatMod(contrib.EffectiveModifier)
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <StatusEffectsPanel State="State"
                                    Sheet="sheet"
                                    IsHost="IsHost"
                                    CanEdit="canEdit" />

                @if (canSeePrivate && State.Settings.HpTrackingEnabled)
                {
                    <div class="dndm-sheet-section">
                        <span class="dndm-label">HP / AC</span>
                        @if (sheet.Hp is null || sheet.MaxHp is null)
                        {
                            <button class="dndm-btn dndm-btn--small"
                                    type="button"
                                    disabled="@(!canEdit)"
                                    @onclick="@(() => InitializeHp(sheet))">+ Add HP tracking</button>
                        }
                        else
                        {
                            <div class="dndm-sheet-hp">
                                <span class="dndm-sheet-hp-sep">Cur.</span>
                                <input type="number"
                                       class="dndm-input dndm-input--num"
                                       value="@_hpDraft"
                                       disabled="@(!canEdit)"
                                       @oninput="@(e => OnHpInput((string?)e.Value))"
                                       @onblur="@(() => FlushPendingCommitAsync())" />
                                <span class="dndm-sheet-hp-sep">/ Max</span>
                                <input type="number"
                                       class="dndm-input dndm-input--num"
                                       value="@_maxHpDraft"
                                       disabled="@(!canEdit)"
                                       @oninput="@(e => OnMaxHpInput((string?)e.Value))"
                                       @onblur="@(() => FlushPendingCommitAsync())" />
                                @{ var effMax = EffectiveMaxHpResolver.ResolveEffectiveMaxHp(sheet); }
                                @if (effMax is int em && em != sheet.MaxHp)
                                {
                                    <span class="dndm-sheet-hp-effective @(em > sheet.MaxHp ? "is-pos" : "is-neg")"
                                          title="@FormatMaxHpBreakdown(sheet)">(eff: @em)</span>
                                }
                            </div>
                        }
                        <div class="dndm-sheet-ac">
                            <span class="dndm-sheet-hp-sep">AC</span>
                            <input type="number"
                                   class="dndm-input dndm-input--num"
                                   value="@_acDraft"
                                   placeholder="—"
                                   disabled="@(!canEdit)"
                                   @oninput="@(e => OnAcInput((string?)e.Value))"
                                   @onblur="@(() => FlushPendingCommitAsync())" />
                        </div>
                    </div>
                }

                @if (IsHost)
                {
                    var assignedTokens = TokensForSheet(sheet.Id);
                    var hasTokenOnActiveMap = activeMap is not null
                        && assignedTokens.Any(p => p.Map.Id == activeMap.Id);
                    <div class="dndm-sheet-section">
                        <span class="dndm-label">Assigned tokens</span>
                        @if (assignedTokens.Count == 0)
                        {
                            <div class="dndm-sheet-empty-hint">No tokens linked to this sheet.</div>
                        }
                        else
                        {
                            <ul class="dndm-sheet-tokenlist">
                                @foreach (var (token, map) in assignedTokens)
                                {
                                    <li @key="token.Id" class="dndm-sheet-tokenlist-row">
                                        <span class="dndm-sheet-tokenlist-swatch"
                                              style="@($"background:{token.ResolveColor(State.Sheets)};")"></span>
                                        <span class="dndm-sheet-tokenlist-name">
                                            @(string.IsNullOrEmpty(token.Name) ? "(unnamed)" : token.Name)
                                        </span>
                                        <span class="dndm-sheet-tokenlist-map">on @map.Name</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (activeMap is not null && !hasTokenOnActiveMap)
                        {
                            <button class="dndm-btn dndm-btn--small"
                                    type="button"
                                    title="Spawn a token on the active map linked to this sheet"
                                    @onclick="@(() => OnCreateTokenForSheet(sheet))">
                                + Create token on "@activeMap.Name"
                            </button>
                        }
                    </div>
                }

                @if (canSeePrivate)
                {
                    <div class="dndm-sheet-section">
                        <span class="dndm-label">Notes</span>
                        <textarea class="dndm-textarea dndm-textarea--notes"
                                  rows="6"
                                  value="@_notesDraft"
                                  disabled="@(!canEdit)"
                                  @oninput="@(e => OnNotesInput((string?)e.Value))"
                                  @onblur="@(() => FlushPendingCommitAsync())"></textarea>
                    </div>
                }
            </div>
        }
    }
</section>

@if (_sheetSettingsOpen)
{
    <SheetSettingsModal State="State" OnClose="@(() => _sheetSettingsOpen = false)" />
}

<ConfirmModal IsOpen="_pendingDeleteSheet is not null"
              Title="Delete character sheet?"
              Message="@($"This permanently removes \"{_pendingDeleteSheetName}\" and detaches it from any tokens.")"
              ConfirmText="Delete"
              OnConfirm="ConfirmDeleteSheet"
              OnCancel="CancelDeleteSheet" />

@if (_npcModalOpen)
{
    <div class="dndm-modal-overlay" @onclick="CloseNpcModal">
        <div class="dndm-modal" @onclick:stopPropagation="true">
            <header class="dndm-modal-header">New NPC sheet</header>
            <div class="dndm-modal-body">
                <label class="dndm-label">
                    Name
                    <input class="dndm-input"
                           autofocus
                           value="@_npcNameDraft"
                           @oninput="@(e => _npcNameDraft = (string?)e.Value ?? string.Empty)" />
                </label>
            </div>
            <footer class="dndm-modal-footer">
                <button class="dndm-btn" type="button" @onclick="CloseNpcModal">Cancel</button>
                <button class="dndm-btn dndm-btn--primary"
                        type="button"
                        disabled="@string.IsNullOrWhiteSpace(_npcNameDraft)"
                        @onclick="ConfirmCreateNpcSheet">Create</button>
            </footer>
        </div>
    </div>
}
