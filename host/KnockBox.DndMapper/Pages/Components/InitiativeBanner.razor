@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

@*  Combat panel — slotted into the player's right rail while combat is
    active. WaitingForRolls phase shows the checklist with a prominent
    "Roll Initiative!" button on the viewer's own row. Active phase shows
    the ordered turn list with the current combatant highlighted. *@

@if (State.ActiveCombat is not null)
{
    var combat = State.ActiveCombat;
    var isActive = combat.Phase == CombatPhase.Active;
    <section class="dndm-panel dndm-initiative @(isActive ? "dndm-initiative--active" : "dndm-initiative--waiting")">

        <header class="dndm-panel-header">
            <span class="dndm-initiative-title">
                <span class="dndm-initiative-glyph" aria-hidden="true">⚔</span>
                @(isActive ? "Combat" : "Initiative")
            </span>
            @if (isActive)
            {
                <span class="dndm-initiative-meta">
                    <span class="dndm-initiative-round-label">Round</span>
                    <span class="dndm-initiative-round">@combat.RoundNumber</span>
                </span>
            }
            else
            {
                <span class="dndm-initiative-meta">
                    @* Count both committed rolls and host-staged Pending values
                       so the progress reads "n/total set" the moment each NPC is
                       Set, even though the dice (and the revealed value) are
                       deferred until the whole batch fires. *@
                    <span class="dndm-initiative-progress">
                        @combat.TurnOrder.Count(e => e.InitiativeRoll is not null || e.PendingInitiative is not null) / @combat.TurnOrder.Length rolled
                    </span>
                </span>
            }
        </header>

        <div class="dndm-panel-body">
            <ol class="dndm-initiative-list">
                @foreach (var (entry, idx) in combat.TurnOrder.Select((e, i) => (e, i)))
                {
                    var isCurrent = isActive && idx == combat.CurrentTurnIndex;
                    var isOwn = entry.OwnerUserId == CurrentUserId;
                    var animating = IsInitiativeAnimating(entry);
                    var rolled = entry.InitiativeRoll is not null && !animating;
                    <li @key="entry.Id"
                        class="dndm-initiative-entry
                               @(isCurrent ? " dndm-initiative-entry--current" : null)
                               @(isOwn ? " dndm-initiative-entry--own" : null)
                               @(!rolled ? " dndm-initiative-entry--unrolled" : null)">
                        <span class="dndm-initiative-tick" aria-hidden="true">
                            @if (combat.Phase == CombatPhase.WaitingForRolls)
                            {
                                @(rolled ? "✓" : "—")
                            }
                            else
                            {
                                <span class="dndm-initiative-order">@(idx + 1)</span>
                            }
                        </span>
                        <span class="dndm-initiative-name">
                            @entry.Name
                            @if (entry.OwnerUserId is null)
                            {
                                <span class="dndm-initiative-badge">NPC</span>
                            }
                            @if (entry.IsForceRolled)
                            {
                                <span class="dndm-initiative-badge dndm-initiative-badge--forced"
                                      title="Forced by the GM because this player hadn't rolled">forced</span>
                            }
                        </span>
                        <span class="dndm-initiative-roll">
                            @* While 3D dice are still tumbling for this entry's token, show the
                               placeholder so the result isn't spoiled before the dice land. *@
                            @(rolled ? entry.InitiativeRoll!.Value.ToString() : "—")
                        </span>

                        @if (combat.Phase == CombatPhase.WaitingForRolls && isOwn && !rolled)
                        {
                            <button class="dndm-btn dndm-btn--primary dndm-btn--small dndm-initiative-roll-btn"
                                    type="button"
                                    @onclick="OnRollInitiative">
                                Roll Initiative!
                            </button>
                        }
                    </li>
                }
            </ol>
        </div>
    </section>
}
