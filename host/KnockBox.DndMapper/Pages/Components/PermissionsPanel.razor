@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Models
@using KnockBox.DndMapper.Services.State.Games
@inherits DisposableComponent

<section class="dndm-panel dndm-permp">
    <header class="dndm-panel-header">
        <span>Settings</span>
        @if (!Embedded)
        {
            <button class="dndm-btn dndm-btn--icon dndm-btn--small" type="button" title="Close"
                    @onclick="OnClose">×</button>
        }
    </header>
    <div class="dndm-panel-body">
        <div class="dndm-panel-section">
            <span class="dndm-label">Token movement</span>
            <div class="dndm-pillgroup">
                <button class="@PillCls(State.Settings.TokenMovement == TokenMovementPolicy.OwnerOrHost)"
                        type="button"
                        @onclick="@(() => SetTokenMovement(TokenMovementPolicy.OwnerOrHost))">Owner / Host</button>
                <button class="@PillCls(State.Settings.TokenMovement == TokenMovementPolicy.Anyone)"
                        type="button"
                        @onclick="@(() => SetTokenMovement(TokenMovementPolicy.Anyone))">Anyone</button>
                <button class="@PillCls(State.Settings.TokenMovement == TokenMovementPolicy.HostOnly)"
                        type="button"
                        @onclick="@(() => SetTokenMovement(TokenMovementPolicy.HostOnly))">Host only</button>
            </div>
        </div>

        <div class="dndm-panel-section">
            <span class="dndm-label">Sheet edits by others</span>
            <div class="dndm-pillgroup">
                <button class="@PillCls(State.Settings.SheetEditByOthers == SheetEditPolicy.HostOnly)"
                        type="button"
                        @onclick="@(() => SetSheetEdit(SheetEditPolicy.HostOnly))">Host only</button>
                <button class="@PillCls(State.Settings.SheetEditByOthers == SheetEditPolicy.OwnersAndHost)"
                        type="button"
                        @onclick="@(() => SetSheetEdit(SheetEditPolicy.OwnersAndHost))">Owners + Host</button>
                <button class="@PillCls(State.Settings.SheetEditByOthers == SheetEditPolicy.Anyone)"
                        type="button"
                        @onclick="@(() => SetSheetEdit(SheetEditPolicy.Anyone))">Anyone</button>
            </div>
        </div>

        <div class="dndm-panel-section">
            <label class="dndm-toggle">
                <input type="checkbox"
                       checked="@State.Settings.RollsVisibleToPlayers"
                       @onchange="@(e => SetRollsVisible(e.Value is bool b && b))" />
                <span class="dndm-toggle-track"></span>
                <span>Rolls visible to players</span>
            </label>
        </div>

        <div class="dndm-panel-section">
            <label class="dndm-toggle">
                <input type="checkbox"
                       checked="@State.Settings.PlayersCanCreateNPCs"
                       @onchange="@(e => SetPlayersCanCreateNpcs(e.Value is bool b && b))" />
                <span class="dndm-toggle-track"></span>
                <span>Players can create NPCs</span>
            </label>
        </div>

        <div class="dndm-panel-section">
            <label class="dndm-toggle">
                <input type="checkbox"
                       checked="@State.Settings.PlayersCanSeeOtherSheets"
                       @onchange="@(e => SetPlayersCanSeeOtherSheets(e.Value is bool b && b))" />
                <span class="dndm-toggle-track"></span>
                <span>Players can see other players' sheets</span>
            </label>
        </div>

        <div class="dndm-panel-section">
            <label class="dndm-toggle">
                <input type="checkbox"
                       checked="@State.Settings.LoadedDiceEnabled"
                       @onchange="@(e => SetLoadedDiceEnabled(e.Value is bool b && b))" />
                <span class="dndm-toggle-track"></span>
                <span>Loaded dice</span>
            </label>
            <span class="dndm-dice-hint">When on, rules under the Loaded Dice panel rewrite dice results.</span>
        </div>

        <div class="dndm-panel-section">
            <span class="dndm-label">Rule visibility</span>
            <div class="dndm-pillgroup">
                <button class="@PillCls(State.Settings.LoadedDiceRuleVisibility == LoadedDiceRuleVisibility.HostOnly)"
                        type="button"
                        disabled="@(!State.Settings.LoadedDiceEnabled)"
                        @onclick="@(() => SetLoadedDiceVisibility(LoadedDiceRuleVisibility.HostOnly))">Host only</button>
                <button class="@PillCls(State.Settings.LoadedDiceRuleVisibility == LoadedDiceRuleVisibility.AllPlayers)"
                        type="button"
                        disabled="@(!State.Settings.LoadedDiceEnabled)"
                        @onclick="@(() => SetLoadedDiceVisibility(LoadedDiceRuleVisibility.AllPlayers))">All players</button>
            </div>
        </div>

        <div class="dndm-panel-section">
            <span class="dndm-label">Player indicator on modified rolls</span>
            <div class="dndm-pillgroup">
                <button class="@PillCls(State.Settings.LoadedDicePlayerIndicator == LoadedDicePlayerIndicator.Hidden)"
                        type="button"
                        disabled="@(!State.Settings.LoadedDiceEnabled)"
                        @onclick="@(() => SetLoadedDicePlayerIndicator(LoadedDicePlayerIndicator.Hidden))">Hidden</button>
                <button class="@PillCls(State.Settings.LoadedDicePlayerIndicator == LoadedDicePlayerIndicator.RedDotInLog)"
                        type="button"
                        disabled="@(!State.Settings.LoadedDiceEnabled)"
                        @onclick="@(() => SetLoadedDicePlayerIndicator(LoadedDicePlayerIndicator.RedDotInLog))">Red dot in log</button>
            </div>
        </div>

        <div class="dndm-panel-section dndm-permp-reset">
            <button class="dndm-btn @(_resetArmed ? "dndm-btn--danger" : "dndm-btn--ghost")" type="button"
                    @onclick="ResetToDefaults" title="Restore all settings to their defaults">
                @(_resetArmed ? "⚠ Click again to confirm" : "↺ Reset to Defaults")
            </button>
        </div>
    </div>
</section>
