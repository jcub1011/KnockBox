@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Models
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

<section class="dndm-panel dndm-initiative">
    <header class="dndm-panel-header">
        <span>Combat</span>
        @if (State.ActiveCombat is not null)
        {
            <span class="dndm-initiative-host-state">
                @(State.ActiveCombat.Phase == CombatPhase.Active
                    ? $"Round {State.ActiveCombat.RoundNumber}"
                    : "Awaiting rolls")
            </span>
        }
    </header>

    @{
        var initSchema = State.GetActiveSchemaTemplate();
        var initiativeAttr = State.InitiativeAttributeName;
    }
    <div class="dndm-panel-body dndm-initiative-host-config">
        <label class="dndm-label">Initiative modifier</label>
        <select class="dndm-select"
                @onchange="@(e => OnInitiativeAttributeChange((string?)e.Value))">
            <option value="" selected="@string.IsNullOrEmpty(initiativeAttr)">— none (bare d20) —</option>
            @foreach (var row in State.AttributeSchema.Rows)
            {
                if (row.Type == AttributeValueType.Score || row.Type == AttributeValueType.Modifier)
                {
                    <option value="@row.Name" selected="@(initiativeAttr == row.Name)">@row.Name</option>
                }
            }
        </select>
        <div class="dndm-initiative-host-config-hint">
            @if (initSchema is null)
            {
                <span>Players and forced rolls add this attribute's modifier to their d20. Save the schema as a template if you want this choice to ride with it.</span>
            }
            else
            {
                <span>Saved with the <strong>@initSchema.Name</strong> schema. Players and forced rolls add this attribute's modifier to their d20.</span>
            }
        </div>
    </div>

    @if (State.ActiveCombat is null)
    {
        if (!_npcPickerOpen)
        {
            <div class="dndm-panel-body">
                <p class="dndm-initiative-host-blurb">
                    Roll a turn order and run combat. The banner appears on every
                    client; players see a <em>Roll&nbsp;Initiative!</em> button when
                    it's their turn to roll.
                </p>
                <button class="dndm-btn dndm-btn--primary"
                        type="button"
                        @onclick="OpenNpcPicker">
                    Start Combat
                </button>
            </div>
        }
        else
        {
            <div class="dndm-panel-body">
                <label class="dndm-label">Add NPCs to this combat</label>
                @{
                    var npcs = NpcCandidates();
                }
                @if (npcs.Count == 0)
                {
                    <div class="dndm-initiative-empty">No NPC tokens on the active map.</div>
                }
                else
                {
                    <ul class="dndm-initiative-picker">
                        @foreach (var token in npcs)
                        {
                            var picked = _picked.Contains(token.Id);
                            <li @key="token.Id" class="dndm-initiative-picker-item">
                                <label class="dndm-initiative-picker-row">
                                    <input type="checkbox"
                                           checked="@picked"
                                           @onchange="@(e => TogglePick(token.Id, (bool)(e.Value ?? false)))" />
                                    <span class="dndm-initiative-picker-swatch"
                                          style="@($"background:{token.Color};")"></span>
                                    <span class="dndm-initiative-picker-name">@token.Name</span>
                                </label>
                            </li>
                        }
                    </ul>
                }
                <div class="dndm-initiative-picker-actions">
                    <button class="dndm-btn dndm-btn--ghost dndm-btn--small"
                            type="button"
                            @onclick="ClosePicker">Cancel</button>
                    <button class="dndm-btn dndm-btn--primary dndm-btn--small"
                            type="button"
                            @onclick="StartCombat">
                        Begin
                    </button>
                </div>
                @if (_error is not null)
                {
                    <div class="dndm-modal-error">@_error</div>
                }
            </div>
        }
    }
    else
    {
        var combat = State.ActiveCombat;
        <div class="dndm-panel-body dndm-initiative-host-body">

            @if (combat.Phase == CombatPhase.WaitingForRolls)
            {
                @if (AnyUnrolledNpc())
                {
                    <div class="dndm-initiative-host-bulkroll">
                        <button class="dndm-btn dndm-btn--small dndm-btn--primary"
                                type="button"
                                title="Roll d20 + modifier for every NPC that hasn't rolled yet"
                                @onclick="RollAllNpcs">
                            🎲 Roll Unset NPCs
                        </button>
                    </div>
                }
                <div class="dndm-initiative-host-rows">
                    @foreach (var entry in combat.TurnOrder)
                    {
                        var isPlayer = entry.OwnerUserId is not null;
                        var rolled = entry.InitiativeRoll is not null;
                        <div @key="entry.Id" class="dndm-initiative-host-row @(rolled ? "dndm-initiative-host-row--rolled" : null)">
                            <span class="dndm-initiative-host-name">
                                @entry.Name
                                <span class="dndm-initiative-badge">@(isPlayer ? "PC" : "NPC")</span>
                            </span>
                            @if (rolled)
                            {
                                <span class="dndm-initiative-host-roll">@entry.InitiativeRoll</span>
                            }
                            else if (isPlayer)
                            {
                                <button class="dndm-btn dndm-btn--small dndm-btn--ghost"
                                        type="button"
                                        title="Roll for this player on their behalf"
                                        @onclick="@(() => ForcePlayerRoll(entry.Id))">
                                    Force roll
                                </button>
                            }
                            else
                            {
                                <div class="dndm-initiative-host-npc-actions">
                                    <input type="number"
                                           class="dndm-input dndm-input--num"
                                           placeholder="roll"
                                           value="@(_npcDrafts.GetValueOrDefault(entry.Id, ""))"
                                           @oninput="@(e => OnNpcDraftInput(entry.Id, (string?)e.Value))"
                                           @onkeydown="@(e => OnNpcDraftKey(e, entry.Id))" />
                                    <button class="dndm-btn dndm-btn--small dndm-btn--primary"
                                            type="button"
                                            @onclick="@(() => CommitNpcDraft(entry.Id))">Set</button>
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (_error is not null)
                {
                    <div class="dndm-modal-error">@_error</div>
                }
            }
            else
            {
                <div class="dndm-initiative-host-rows">
                    @foreach (var (entry, idx) in combat.TurnOrder.Select((e, i) => (e, i)))
                    {
                        var current = idx == combat.CurrentTurnIndex;
                        <div @key="entry.Id" class="dndm-initiative-host-row @(current ? "dndm-initiative-host-row--current" : null)">
                            <span class="dndm-initiative-host-order">@(idx + 1)</span>
                            <span class="dndm-initiative-host-name">@entry.Name</span>
                            <span class="dndm-initiative-host-roll">@entry.InitiativeRoll</span>
                            <button class="dndm-btn dndm-btn--small dndm-btn--ghost dndm-initiative-host-remove"
                                    type="button"
                                    title="Remove from combat"
                                    @onclick="@(() => RemoveCombatant(entry.Id))">✕</button>
                        </div>
                    }
                </div>

                <div class="dndm-initiative-host-actions">
                    <button class="dndm-btn dndm-btn--primary"
                            type="button"
                            @onclick="AdvanceTurn">
                        Next Turn →
                    </button>
                    <button class="dndm-btn dndm-btn--ghost dndm-btn--danger"
                            type="button"
                            @onclick="EndCombat">
                        End Combat
                    </button>
                </div>

                @if (_addOpen)
                {
                    <div class="dndm-initiative-host-add">
                        <label class="dndm-label">Add a combatant mid-fight</label>
                        @{
                            var addable = NpcCandidates()
                                .Where(t => !combat.TurnOrder.Any(e => e.TokenId == t.Id))
                                .ToList();
                        }
                        @if (addable.Count == 0)
                        {
                            <div class="dndm-initiative-empty">No NPC tokens left to add.</div>
                        }
                        else
                        {
                            <div class="dndm-initiative-host-add-row">
                                <select class="dndm-select"
                                        value="@_addTokenId"
                                        @onchange="@(e => _addTokenId = (string?)e.Value ?? string.Empty)">
                                    <option value="">— pick token —</option>
                                    @foreach (var t in addable)
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                </select>
                                <input type="number"
                                       class="dndm-input dndm-input--num"
                                       placeholder="roll"
                                       value="@_addRoll"
                                       @oninput="@(e => _addRoll = (string?)e.Value ?? string.Empty)" />
                                <button class="dndm-btn dndm-btn--small dndm-btn--primary"
                                        type="button"
                                        @onclick="AddCombatant">Insert</button>
                            </div>
                        }
                        <button class="dndm-btn dndm-btn--small dndm-btn--ghost"
                                type="button"
                                @onclick="@(() => _addOpen = false)">Close</button>
                    </div>
                }
                else
                {
                    <button class="dndm-btn dndm-btn--small dndm-btn--ghost"
                            type="button"
                            @onclick="@(() => _addOpen = true)">+ Add combatant</button>
                }

                @if (_error is not null)
                {
                    <div class="dndm-modal-error">@_error</div>
                }
            }
        </div>
    }
</section>
