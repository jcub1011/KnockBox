@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Services.State.Games
@inherits DisposableComponent

@if (_collapsed)
{
    <button class="dndm-rolllog-fab"
            type="button"
            title="Open roll panel"
            aria-label="Open roll panel"
            @onclick="Toggle">🎲</button>
}
else
{
    <div class="dndm-rolllog-floater" role="dialog" aria-label="Roll panel">
        <RollLogPanel State="State"
                      Config="Config"
                      CurrentUserId="@CurrentUserId"
                      IsHost="IsHost"
                      OnHeaderClick="Toggle" />
    </div>
}
