@using KnockBox.DndMapper.Services.Logic.Visibility
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@using KnockBox.Core.Components.Shared
@inherits DisposableComponent

<div class="dndm-canvas-frame"
     tabindex="0"
     @ref="_frameRef"
     @onkeydown="OnKeyDown"
     @onkeyup="OnKeyUp"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true">
    <div class="dndm-canvas-toolbar">
        <label class="dndm-grid-toggle">
            <input type="checkbox" checked="@LocalShowGridLines" @onchange="OnToggleGrid" />
            Grid
        </label>
        <button class="dndm-zoom-btn" type="button" @onclick="ZoomOut" title="Zoom out">−</button>
        <span class="dndm-zoom-readout">@($"{_zoom * 100:0}%")</span>
        <button class="dndm-zoom-btn" type="button" @onclick="ZoomIn" title="Zoom in">+</button>
        <button class="dndm-zoom-btn" type="button" @onclick="ResetView" title="Reset view">⟲</button>
        @if (IsHost)
        {
            <button class="dndm-zoom-btn dndm-markup-toggle @(_markupActive ? "dndm-markup-toggle--active" : null)"
                    type="button"
                    title="@(_markupActive ? "Stop drawing (markup stays on the map)" : "Draw markup over the map")"
                    @onclick="ToggleMarkup">✎</button>

            <button class="dndm-zoom-btn dndm-focus-toggle @(_focusActive ? "dndm-focus-toggle--active" : null)"
                    type="button"
                    title="@(_focusActive ? "Stop drawing focus box (drag on the map to set it)" : "Focus box — drag on the map to zoom the display to a region")"
                    @onclick="ToggleFocusMode">▭</button>
            @if (State.FocusRect is not null)
            {
                <button class="dndm-zoom-btn dndm-focus-clear"
                        type="button"
                        title="Clear focus box (return display to full map)"
                        @onclick="OnClearFocusClicked">✕</button>
            }

            <span class="dndm-toolbar-sep" aria-hidden="true"></span>

            <button class="dndm-zoom-btn dndm-fog-btn @(FogContext.Mode == FogPaintMode.Paint ? "dndm-fog-btn--active" : null)"
                    type="button"
                    title="Paint fog — drag on the map to hide cells"
                    @onclick="OnTogglePaintMode">▒</button>
            <button class="dndm-zoom-btn dndm-fog-btn @(FogContext.Mode == FogPaintMode.Erase ? "dndm-fog-btn--active" : null)"
                    type="button"
                    title="Erase fog — drag on the map to reveal cells"
                    @onclick="OnToggleEraseMode">◌</button>
            <button class="dndm-zoom-btn dndm-fog-brush"
                    type="button"
                    title="Brush size (click to cycle 1 → 2 → 3)"
                    @onclick="OnCycleBrush">@FogContext.BrushRadius</button>
            <button class="dndm-zoom-btn"
                    type="button"
                    title="Fill the entire map with fog"
                    @onclick="OnFillFogClicked">▣</button>
            <button class="dndm-zoom-btn"
                    type="button"
                    title="Clear all fog"
                    @onclick="OnClearFogClicked">◻</button>
        }
    </div>

    <div class="dndm-canvas-stage">
    @* viewBox is pinned to the map's base dimensions. All pan/zoom is
       realized as a CSS transform applied by dndMapperViewport.js so the
       SVG layer (with potentially very large embedded images) is
       rasterized once and GPU-composited per frame, never re-rasterized.
       overflow="visible" lets content with coordinates outside the
       viewBox (e.g. images placed past the map edge) render past the
       SVG element box; the parent .dndm-canvas-stage clips at the
       visible window with overflow:hidden. *@
    <svg id="@_svgId"
         class="dndm-map-canvas"
         viewBox="@($"0 0 {Map.Grid.WidthCells} {Map.Grid.HeightCells}")"
         preserveAspectRatio="xMidYMid meet"
         overflow="visible"
         @onmousedown="OnSvgMouseDown"
         @onmousemove="OnSvgMouseMove"
         @onmouseup="OnSvgMouseUp"
         @onmouseleave="OnSvgMouseUp"
         xmlns="http://www.w3.org/2000/svg">

        <rect x="0" y="0"
              width="@Map.Grid.WidthCells" height="@Map.Grid.HeightCells"
              fill="#0e1117" />

        @if (Map.Images.Count > 0)
        {
            @foreach (var img in GetVisibleImagesCached())
            {
                var draft = (IsHost && _drag is { ImageId: var dId } && dId == img.Id) ? _drag : null;
                var x = draft?.X ?? img.X;
                var y = draft?.Y ?? img.Y;
                var w = draft?.W ?? img.Width;
                var h = draft?.H ?? img.Height;
                var rot = draft?.Rot ?? img.Rotation;
                var cx = x + w / 2;
                var cy = y + h / 2;
                @if (img.ShareToken is Guid shareToken)
                {
                    <image @key="img.Id"
                           href="@($"/blob-share/{shareToken:D}")"
                           x="@F(x)" y="@F(y)"
                           width="@F(w)" height="@F(h)"
                           transform="@($"rotate({F(rot)} {F(cx)} {F(cy)})")"
                           opacity="@F(img.Opacity)"
                           preserveAspectRatio="none"
                           pointer-events="none" />
                }
                else
                {
                    // Host disconnected: the blob-share capability is gone. Render a
                    // muted placeholder so the player sees the layer outline; the
                    // host's reconnect republish path will broadcast a fresh token
                    // via UpdateImageShareTokenAsync and the <image> swaps back in.
                    <rect @key="img.Id"
                          x="@F(x)" y="@F(y)"
                          width="@F(w)" height="@F(h)"
                          transform="@($"rotate({F(rot)} {F(cx)} {F(cy)})")"
                          fill="#1c2128" stroke="#3d444c" stroke-width="0.04" stroke-dasharray="0.2,0.1"
                          opacity="@F(Math.Min(img.Opacity, 0.6))"
                          pointer-events="none" />
                }
            }

            @if (IsHost)
            {
                <g class="dndm-image-pickers">
                    @foreach (var img in Map.Images.Where(i => !i.Hidden).OrderBy(i => i.LayerOrder))
                    {
                        // Locked images and Space-pan mode disable the picker so the click
                        // falls through to the SVG and starts a pan.
                        var pickerEvents = (img.Locked || _spaceHeld) ? "none" : "all";
                        var cx = img.X + img.Width / 2;
                        var cy = img.Y + img.Height / 2;
                        <rect @key="@($"pick-{img.Id}")"
                              x="@F(img.X)" y="@F(img.Y)"
                              width="@F(img.Width)" height="@F(img.Height)"
                              transform="@($"rotate({F(img.Rotation)} {F(cx)} {F(cy)})")"
                              fill="transparent"
                              stroke="@(SelectedImageId == img.Id ? "#e8b849" : "transparent")"
                              stroke-width="0.04"
                              pointer-events="@pickerEvents"
                              @onmousedown="@(e => OnImageMouseDown(e, img))"
                              @onmousedown:stopPropagation="true" />
                    }
                </g>
            }
        }

        @if (LocalShowGridLines)
        {
            <g class="dndm-grid-layer" pointer-events="none">
                @for (int x = 0; x <= Map.Grid.WidthCells; x++)
                {
                    <line x1="@x" y1="0" x2="@x" y2="@Map.Grid.HeightCells"
                          stroke="@Map.Grid.LineColor" stroke-width="0.02" />
                }
                @for (int y = 0; y <= Map.Grid.HeightCells; y++)
                {
                    <line x1="0" y1="@y" x2="@Map.Grid.WidthCells" y2="@y"
                          stroke="@Map.Grid.LineColor" stroke-width="0.02" />
                }
            </g>
        }

        @* Saved markup renders inline so pan + zoom apply uniformly across all
           viewers (host's interactive overlay below uses a fixed viewBox). *@
        @if (!string.IsNullOrWhiteSpace(Map.MarkupSvg))
        {
            <g class="dndm-markup-readonly" pointer-events="none">
                @((MarkupString)Map.MarkupSvg)
            </g>
        }

        @* Fog overlay. One SVG path per render covers every contiguous fogged
           cluster (with holes resolved via fill-rule="evenodd") so adjacent
           cells render gap-free and the whole region can be styled as one
           element. Rendered between markup and tokens so tokens visually sit
           on top of fog for the host. *@
        @{
            var fogPath = GetFogPathCached();
        }
        @if (!string.IsNullOrEmpty(fogPath))
        {
            var fogOpacity = IsHost ? "0.45" : "1";
            <g class="@(IsHost ? "dndm-fog dndm-fog--host" : "dndm-fog dndm-fog--player")" pointer-events="none">
                <path d="@fogPath" fill="#000" fill-opacity="@fogOpacity" fill-rule="evenodd" />
            </g>
        }

        @* Focus box — host-only red outline. Drives the display view's
           viewBox; the display view doesn't render the outline itself. *@
        @if (IsHost && State.FocusRect is { } fr && fr.MapId == Map.Id)
        {
            @* Dark halo + red stroke. The 0.18-cell black underlay stays
               visible against bright/red backgrounds where the red alone
               would disappear. *@
            <rect x="@F(fr.X)" y="@F(fr.Y)"
                  width="@F(fr.Width)" height="@F(fr.Height)"
                  fill="none" stroke="#000" stroke-width="0.18" stroke-opacity="0.6"
                  pointer-events="none" />
            <rect class="dndm-focus-rect"
                  x="@F(fr.X)" y="@F(fr.Y)"
                  width="@F(fr.Width)" height="@F(fr.Height)"
                  fill="none" stroke="#e11d48" stroke-width="0.12"
                  pointer-events="none" />
        }
        @if (IsHost && _focusActive && _focusDragStart is { } fs && _focusDragCurrent is { } fc)
        {
            var (fpx, fpy, fpw, fph) = NormalizeFocusDrag(fs, fc);
            <rect x="@F(fpx)" y="@F(fpy)"
                  width="@F(fpw)" height="@F(fph)"
                  fill="none" stroke="#000" stroke-width="0.18" stroke-opacity="0.6"
                  pointer-events="none" />
            <rect class="dndm-focus-rect-preview"
                  x="@F(fpx)" y="@F(fpy)"
                  width="@F(fpw)" height="@F(fph)"
                  fill="none" stroke="#e11d48" stroke-width="0.12" stroke-dasharray="0.4,0.25"
                  pointer-events="none" />
        }

        <TokenLayer State="State"
                    Map="Map"
                    IsHost="IsHost"
                    CurrentUserId="@CurrentUserId"
                    SvgId="@_svgId" />

        @if (IsHost && SelectedImage is { Locked: false, Hidden: false } sel)
        {
            var s = (_drag is { ImageId: var did } && did == sel.Id) ? _drag : null;
            var sx = s?.X ?? sel.X;
            var sy = s?.Y ?? sel.Y;
            var sw = s?.W ?? sel.Width;
            var sh = s?.H ?? sel.Height;
            var sr = s?.Rot ?? sel.Rotation;
            var hSize = 0.25; // cells
            <g class="dndm-image-handles" pointer-events="all">
                <g transform="@($"rotate({F(sr)} {F(sx + sw / 2)} {F(sy + sh / 2)})")">
                    <rect x="@F(sx - hSize / 2)" y="@F(sy - hSize / 2)"
                          width="@F(hSize)" height="@F(hSize)" class="dndm-image-handle"
                          @onmousedown="@(e => OnHandleMouseDown(e, sel, HandleKind.NW))"
                          @onmousedown:stopPropagation="true" />
                    <rect x="@F(sx + sw - hSize / 2)" y="@F(sy - hSize / 2)"
                          width="@F(hSize)" height="@F(hSize)" class="dndm-image-handle"
                          @onmousedown="@(e => OnHandleMouseDown(e, sel, HandleKind.NE))"
                          @onmousedown:stopPropagation="true" />
                    <rect x="@F(sx - hSize / 2)" y="@F(sy + sh - hSize / 2)"
                          width="@F(hSize)" height="@F(hSize)" class="dndm-image-handle"
                          @onmousedown="@(e => OnHandleMouseDown(e, sel, HandleKind.SW))"
                          @onmousedown:stopPropagation="true" />
                    <rect x="@F(sx + sw - hSize / 2)" y="@F(sy + sh - hSize / 2)"
                          width="@F(hSize)" height="@F(hSize)" class="dndm-image-handle"
                          @onmousedown="@(e => OnHandleMouseDown(e, sel, HandleKind.SE))"
                          @onmousedown:stopPropagation="true" />
                    <line x1="@F(sx + sw / 2)" y1="@F(sy)"
                          x2="@F(sx + sw / 2)" y2="@F(sy - 0.6)"
                          class="dndm-image-rotline" />
                    <circle cx="@F(sx + sw / 2)" cy="@F(sy - 0.6)" r="@F(hSize / 1.5)"
                            class="dndm-image-handle dndm-image-handle--rot"
                            @onmousedown="@(e => OnHandleMouseDown(e, sel, HandleKind.Rotate))"
                            @onmousedown:stopPropagation="true" />
                </g>
            </g>
        }
    </svg>

    @if (IsHost && _markupActive)
    {
        @* Sits inside .dndm-canvas-stage so its inset:0 covers exactly
           the visible map area. Both this surface and the underlying
           MapCanvas SVG use the same preserveAspectRatio rule, so a
           stroke at viewBox coords (5, 5) lands on the same cell. *@
        <div class="dndm-markup-overlay-mount">
            <MarkupOverlay State="State" Map="Map" IsActive="true" />
        </div>
    }
    </div>

    @if (IsHost && _contextMenuOpen)
    {
        <div class="dndm-context-veil"
             @onclick="CloseContextMenu"
             @oncontextmenu="CloseContextMenu"
             @oncontextmenu:preventDefault="true"></div>
        <div class="dndm-context-menu"
             style="@($"left: {F(_contextMenuClientX)}px; top: {F(_contextMenuClientY)}px;")"
             @onclick:stopPropagation="true">
            <div class="dndm-context-menu-head">
                Cell @(_contextMenuMapX.ToString("0.#")), @(_contextMenuMapY.ToString("0.#"))
            </div>
            <button class="dndm-context-menu-item" type="button" @onclick="RequestCenterEveryone">
                <span class="dndm-context-menu-glyph" aria-hidden="true">⊙</span>
                <span>Centre everyone here</span>
            </button>
        </div>
    }

    @if (IsHost)
    {
        <ConfirmModal IsOpen="_confirmFillFog"
                      Title="Fog the entire map?"
                      Message="Every cell will be hidden from players. You can erase areas afterward."
                      ConfirmText="Fill with fog"
                      CancelText="Cancel"
                      OnConfirm="OnConfirmFillFog"
                      OnCancel="OnCancelFillFog" />
        <ConfirmModal IsOpen="_confirmClearFog"
                      Title="Reveal the entire map?"
                      Message="All fogged cells will be cleared. This can't be undone."
                      ConfirmText="Clear all fog"
                      CancelText="Cancel"
                      OnConfirm="OnConfirmClearFog"
                      OnCancel="OnCancelClearFog" />
    }
</div>
