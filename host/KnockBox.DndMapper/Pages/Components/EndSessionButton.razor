@using KnockBox.DndMapper.Services.State.Games

@if (IsHost())
{
    <button class="dndm-btn dndm-btn--danger" type="button" @onclick="@(() => _open = true)">
        Reset Session
    </button>
    <ConfirmModal IsOpen="_open"
                  Title="Reset Session?"
                  Message="Resets all maps, tokens, sheets, rolls, and settings to a clean state for the current session. Saved templates are kept. Cannot be undone."
                  ConfirmText="Reset Session"
                  CancelText="Cancel"
                  OnConfirm="DoReset"
                  OnCancel="@(() => _open = false)" />
}
