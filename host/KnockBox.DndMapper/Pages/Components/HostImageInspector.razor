@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

@if (_image is not null)
{
    <section class="dndm-panel dndm-imgi">
        <header class="dndm-panel-header">
            <span>Image</span>
            <button class="dndm-btn dndm-btn--icon dndm-btn--small"
                    type="button"
                    title="Close inspector"
                    @onclick="OnClose">×</button>
        </header>
        <div class="dndm-panel-body">
            <div class="dndm-imgi-grid">
                <label class="dndm-label">X<input type="number" step="0.1" class="dndm-input dndm-input--num"
                                                  value="@F(_image.X)"
                                                  @onchange="@(e => Commit(x: ParseD(e.Value, _image.X)))" /></label>
                <label class="dndm-label">Y<input type="number" step="0.1" class="dndm-input dndm-input--num"
                                                  value="@F(_image.Y)"
                                                  @onchange="@(e => Commit(y: ParseD(e.Value, _image.Y)))" /></label>
                <label class="dndm-label">W<input type="number" step="0.1" min="0.1" class="dndm-input dndm-input--num"
                                                  value="@F(_image.Width)"
                                                  @onchange="@(e => Commit(w: ParseD(e.Value, _image.Width)))" /></label>
                <label class="dndm-label">H<input type="number" step="0.1" min="0.1" class="dndm-input dndm-input--num"
                                                  value="@F(_image.Height)"
                                                  @onchange="@(e => Commit(h: ParseD(e.Value, _image.Height)))" /></label>
                <label class="dndm-label">Rotation
                    <input type="number" step="1" class="dndm-input dndm-input--num"
                           value="@F(_image.Rotation)"
                           @onchange="@(e => Commit(rotation: ParseD(e.Value, _image.Rotation)))" />
                </label>
                <label class="dndm-label">Opacity
                    <input type="range" min="0" max="1" step="0.05"
                           value="@F(_image.Opacity)"
                           @onchange="@(e => Commit(opacity: ParseD(e.Value, _image.Opacity)))" />
                    <span class="dndm-imgi-opacity-readout">@($"{_image.Opacity * 100:0}%")</span>
                </label>
            </div>

            <div class="dndm-imgi-lock">
                <label class="dndm-toggle">
                    <input type="checkbox"
                           checked="@_image.Locked"
                           @onchange="@(e => OnToggleLock(e.Value is bool b && b))" />
                    <span class="dndm-toggle-track"></span>
                    <span>Locked</span>
                </label>
            </div>

            <div class="dndm-imgi-layer">
                <span class="dndm-label">Layer</span>
                <button class="dndm-btn dndm-btn--small" type="button" title="Send to back" @onclick="LayerToBack">⤓</button>
                <button class="dndm-btn dndm-btn--small" type="button" title="Lower" @onclick="LayerDown">↓</button>
                <span class="dndm-imgi-layer-readout">@_image.LayerOrder</span>
                <button class="dndm-btn dndm-btn--small" type="button" title="Raise" @onclick="LayerUp">↑</button>
                <button class="dndm-btn dndm-btn--small" type="button" title="Bring to front" @onclick="LayerToFront">⤒</button>
            </div>

            <div class="dndm-imgi-actions">
                <button class="dndm-btn dndm-btn--danger" type="button" @onclick="OnDeleteRequest">Delete image</button>
            </div>
        </div>
    </section>

    <ConfirmModal IsOpen="_pendingDelete"
                  Title="Delete image?"
                  Message="This will remove the image from this map and delete the file from disk."
                  ConfirmText="Delete"
                  OnConfirm="ConfirmDelete"
                  OnCancel="@(() => _pendingDelete = false)" />
}
