@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Models
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

<div class="dndm-modal-overlay" @onclick="OnClose">
    <div class="dndm-modal-card dndm-sheet-settings-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <header class="dndm-modal-header">
            <h3 class="dndm-modal-title">Sheet settings</h3>
            <button class="dndm-btn dndm-btn--icon dndm-btn--small" type="button" title="Close"
                    @onclick="OnClose">×</button>
        </header>
        <div class="dndm-modal-body">
            <div class="dndm-panel-section">
                <span class="dndm-label">Templates</span>
                <ul class="dndm-template-list">
                    @foreach (var kv in OrderedTemplates())
                    {
                        var t = kv.Value;
                        var isExpanded = _expandedId == t.Id;
                        <li @key="t.Id" class="dndm-template-row">
                            <div class="dndm-template-row-head">
                                <button class="dndm-template-name-btn" type="button"
                                        @onclick="@(() => ToggleExpanded(t.Id))"
                                        title="@(isExpanded ? "Collapse" : "Show rows")">
                                    <span class="dndm-template-chevron">@(isExpanded ? "▾" : "▸")</span>
                                    <span class="dndm-template-name">@t.Name</span>
                                </button>
                                <span class="dndm-template-count">@t.Rows.Count rows</span>
                                @if (t.IsBuiltIn)
                                {
                                    <span class="dndm-template-badge">Built-in</span>
                                }
                                @if (IsActiveTemplate(t))
                                {
                                    <span class="dndm-template-badge dndm-template-badge--active">Selected</span>
                                }
                                @if (!t.IsBuiltIn)
                                {
                                    <button class="dndm-btn dndm-btn--small" type="button"
                                            @onclick="@(() => ApplyTemplate(t.Id))">Apply</button>
                                    <button class="dndm-btn dndm-btn--small dndm-btn--ghost dndm-btn--danger"
                                            type="button"
                                            @onclick="@(() => DeleteTemplate(t.Id))">Delete</button>
                                }
                            </div>
                            @if (isExpanded)
                            {
                                <div class="dndm-template-preview">
                                    @if (t.IsBuiltIn)
                                    {
                                        <table class="dndm-template-preview-table">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Scoring mode</th>
                                                    <th>Starting value</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in t.Rows)
                                                {
                                                    <tr>
                                                        <td>@row.Name</td>
                                                        <td>@row.Type</td>
                                                        <td>@FormatDefault(row.Default)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        var draftList = GetOrInitDraft(t);
                                        <table class="dndm-template-preview-table">
                                            <thead>
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Scoring mode</th>
                                                    <th>Starting value</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < draftList.Count; i++)
                                                {
                                                    var idx = i;
                                                    var d = draftList[idx];
                                                    <tr>
                                                        <td>
                                                            <input class="dndm-input"
                                                                   type="text"
                                                                   value="@d.Name"
                                                                   @onchange="@(e => UpdateDraftName(t.Id, idx, e.Value?.ToString() ?? string.Empty))" />
                                                        </td>
                                                        <td>
                                                            <select class="dndm-select"
                                                                    @onchange="@(e => UpdateDraftType(t.Id, idx, e.Value?.ToString()))">
                                                                <option value="@AttributeValueType.Score" selected="@(d.Type == AttributeValueType.Score)">Score</option>
                                                                <option value="@AttributeValueType.Modifier" selected="@(d.Type == AttributeValueType.Modifier)">Modifier</option>
                                                                <option value="@AttributeValueType.Text" selected="@(d.Type == AttributeValueType.Text)">Text</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <input class="dndm-input"
                                                                   type="text"
                                                                   value="@d.Default"
                                                                   @onchange="@(e => UpdateDraftDefault(t.Id, idx, e.Value?.ToString() ?? string.Empty))" />
                                                        </td>
                                                        <td>
                                                            <button class="dndm-btn dndm-btn--small dndm-btn--ghost"
                                                                    type="button"
                                                                    title="Remove row"
                                                                    @onclick="@(() => RemoveDraftRow(t.Id, idx))">×</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <div class="dndm-template-preview-actions">
                                            <button class="dndm-btn dndm-btn--small" type="button"
                                                    @onclick="@(() => AddDraftRow(t.Id))">+ Add row</button>
                                            @if (_draftErrors.TryGetValue(t.Id, out var errMsg) && errMsg is not null)
                                            {
                                                <span class="dndm-custom-error">@errMsg</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
                <div class="dndm-template-save">
                    <input class="dndm-input"
                           type="text"
                           placeholder="Template name"
                           value="@_newTemplateName"
                           @oninput="@(e => _newTemplateName = (string?)e.Value ?? string.Empty)" />
                    <button class="dndm-btn dndm-btn--small dndm-btn--primary"
                            type="button"
                            title="@SaveAsButtonTitle"
                            disabled="@(!CanSaveAsNew)"
                            @onclick="SaveOpenAsTemplate">Save open template as new</button>
                </div>
                @if (_templateError is string err)
                {
                    <div class="dndm-custom-error">@err</div>
                }
            </div>

            <div class="dndm-panel-section">
                <label class="dndm-toggle">
                    <input type="checkbox"
                           checked="@State.Settings.HpTrackingEnabled"
                           @onchange="@(e => SetHpTracking(e.Value is bool b && b))" />
                    <span class="dndm-toggle-track"></span>
                    <span>HP tracking enabled</span>
                </label>
            </div>
        </div>
        <footer class="dndm-modal-footer">
            <button class="dndm-btn" type="button" @onclick="OnClose">Close</button>
        </footer>
    </div>
</div>
