@using KnockBox.DndMapper.Services.Logic.Visibility
@inherits DisposableComponent

<section class="dndm-panel">
    <header class="dndm-panel-header">
        <span>Fog of War</span>
    </header>
    <div class="dndm-panel-body dndm-fog-body">
        @if (ActiveMap is null)
        {
            <div class="dndm-panel-empty">No active map.</div>
        }
        else
        {
            <div class="dndm-fog-modes" role="group" aria-label="Fog paint mode">
                <button class="@ModeClass(FogPaintMode.Off)"
                        type="button"
                        @onclick="@(() => SetMode(FogPaintMode.Off))">
                    Off
                </button>
                <button class="@ModeClass(FogPaintMode.Paint)"
                        type="button"
                        title="Drag on the canvas to hide cells."
                        @onclick="@(() => SetMode(FogPaintMode.Paint))">
                    Paint
                </button>
                <button class="@ModeClass(FogPaintMode.Erase)"
                        type="button"
                        title="Drag on the canvas to reveal cells."
                        @onclick="@(() => SetMode(FogPaintMode.Erase))">
                    Erase
                </button>
            </div>

            <div class="dndm-fog-brush" role="group" aria-label="Brush size">
                <span class="dndm-label">Brush</span>
                @foreach (var r in BrushSizes)
                {
                    var size = r;
                    <button class="@BrushClass(size)"
                            type="button"
                            title="@($"{size}×{size} cells")"
                            @onclick="@(() => SetBrush(size))">
                        @size
                    </button>
                }
            </div>

            <div class="dndm-fog-bulk">
                <button class="dndm-btn dndm-btn--small"
                        type="button"
                        @onclick="OnFillClicked">
                    Fill with fog
                </button>
                <button class="dndm-btn dndm-btn--small dndm-btn--ghost"
                        type="button"
                        @onclick="OnClearClicked">
                    Clear all fog
                </button>
            </div>
        }
    </div>
</section>

<ConfirmModal IsOpen="_confirmFill"
              Title="Fog the entire map?"
              Message="Every cell will be hidden from players. You can erase areas afterward."
              ConfirmText="Fill with fog"
              CancelText="Cancel"
              OnConfirm="OnConfirmFill"
              OnCancel="OnCancelFill" />

<ConfirmModal IsOpen="_confirmClear"
              Title="Reveal the entire map?"
              Message="All fogged cells will be cleared. This can't be undone."
              ConfirmText="Clear all fog"
              CancelText="Cancel"
              OnConfirm="OnConfirmClear"
              OnCancel="OnCancelClear" />
