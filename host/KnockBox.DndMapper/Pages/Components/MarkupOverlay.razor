@using KnockBox.Core.Services.Drawing
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

@*  Markup overlay (v1.x, §5.6).

    The drawing surface runs in *pixel space* — viewBox sized in CSS pixels
    (cells × CellPixels) so a 1-pixel stroke on screen is 1 pixel in the saved
    markup. On commit (handled by MapCanvas via the engine's StrokeCompleted)
    the result is wrapped in `scale(1/CellPixels)` so the persisted markup is
    in cell coordinates and renders directly inside MapCanvas's cell-unit
    viewBox.

    Map.MarkupSvg (existing markup) is already in cell coords, so we wrap it in
    a `scale(CellPixels)` <g> inside our own background SVG to compose it with
    the pixel-space drawing surface.

    This component renders ONLY the layered SVG stack. The engine and the
    toolbar are owned by MapCanvas and live OUTSIDE the .dndm-canvas-transform
    so the toolbar stays at viewport scale, not affected by pan/zoom. The
    engine connects to our drawing surface SVG by element id (TargetSvgId on
    the engine = SvgId parameter here). *@

@{
    var pxW = Map.Grid.WidthCells * Map.Grid.CellPixels;
    var pxH = Map.Grid.HeightCells * Map.Grid.CellPixels;
    var scaleStr = Map.Grid.CellPixels.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var sanitizedMarkup = string.IsNullOrWhiteSpace(Map.MarkupSvg)
        ? null
        : SvgContentSanitizer.Sanitize(Map.MarkupSvg);
}

<div class="dndm-markup-stack">
    @if (sanitizedMarkup is not null)
    {
        <svg class="dndm-markup-layer dndm-markup-bg" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
             width="100%" height="100%"
             viewBox="0 0 @pxW @pxH"
             preserveAspectRatio="xMidYMid meet">
            <g transform="scale(@scaleStr)">@((MarkupString)sanitizedMarkup)</g>
        </svg>
    }
    <svg id="@SvgId" class="dndm-markup-layer dndm-markup-surface"
         style="@(IsActive ? "" : "pointer-events: none;")"
         width="100%" height="100%"
         viewBox="0 0 @pxW @pxH"
         preserveAspectRatio="xMidYMid meet"></svg>
</div>
