@using System.Text
@using KnockBox.Core.Components.Shared
@using KnockBox.DndMapper.Models
@using KnockBox.DndMapper.Services.Logic.Visibility
@using KnockBox.DndMapper.Services.State.Games
@using KnockBox.DndMapper.Services.State.Games.Data
@inherits DisposableComponent

<section class="dndm-panel dndm-rolllog">
    <header class="dndm-panel-header">
        <span>Roll</span>
    </header>
    <div class="dndm-panel-body dndm-rolllog-body">
        <div class="dndm-rolllog-rollbar">
            <button class="dndm-btn dndm-btn--primary dndm-rolllog-rollbtn"
                    type="button"
                    title="@QuickRollTitle"
                    disabled="@(!CanQuickRoll)"
                    @onclick="QuickRoll">🎲 @QuickRollLabel</button>
        </div>

        <details class="dndm-rolllog-config" open>
            <summary class="dndm-rolllog-config-summary" title="Templates, custom dice, flat modifier, attribute binding, and label.">Configuration</summary>
            <div class="dndm-rolllog-config-body">
                <section class="dndm-dice-quick">
                    <span class="dndm-label">Templates</span>
                    <div class="dndm-dice-quick-row">
                        @foreach (var t in VisibleRollTemplates)
                        {
                            <button @key="t.Id"
                                    class="@($"dndm-btn dndm-btn--small {ScopeClass(t.Scope)}")"
                                    type="button"
                                    title="@TemplateTooltip(t)"
                                    @onclick="@(() => ApplyTemplate(t))">@t.Name</button>
                        }
                        <button class="dndm-btn dndm-btn--small dndm-btn--ghost"
                                type="button"
                                @onclick="OpenTemplateLibrary">Manage…</button>
                    </div>
                </section>

                <section class="dndm-dice-custom">
                    <span class="dndm-label">Custom</span>
                    @foreach (var (term, idx) in Config.Terms.Select((t, i) => (t, i)))
                    {
                        <div @key="idx" class="dndm-dice-term">
                            <input type="number" min="0" max="20"
                                   class="dndm-input dndm-input--num"
                                   value="@term.Count"
                                   @onchange="@(e => UpdateTermCount(idx, ParseInt(e.Value, term.Count)))" />
                            <span class="dndm-dice-term-d">d</span>
                            <select class="dndm-select dndm-dice-term-sides"
                                    @onchange="@(e => UpdateTermSides(idx, ParseInt(e.Value, term.Sides)))"
                                    title="@(term.Sides == 100 ? "d100 rolls as percentile dice: a tens die (00-90) plus a units die (0-9)." : null)">
                                @foreach (var s in DieSizes)
                                {
                                    <option value="@s" selected="@(s == term.Sides)">@(s == 100 ? "100 (d%)" : s.ToString())</option>
                                }
                            </select>
                            @if (Config.Terms.Count > 1)
                            {
                                <button class="dndm-btn dndm-btn--small dndm-btn--icon"
                                        type="button"
                                        title="Remove"
                                        @onclick="@(() => RemoveTerm(idx))">×</button>
                            }
                        </div>
                    }
                    <button class="dndm-btn dndm-btn--small dndm-btn--ghost" type="button" @onclick="AddTerm">+ Add die</button>
                    <div class="dndm-dice-totalcount">Total dice: <strong>@TotalDiceCount</strong> / 20</div>
                </section>

                @if (IsHost || HasAssignedSheet)
                {
                    <section>
                        <span class="dndm-label">Attribute mod</span>
                        <select class="dndm-select" @onchange="@(e => OnAttributeChange((string?)e.Value))">
                            <option value="">— none —</option>
                            @if (PickerSheet is not null)
                            {
                                @foreach (var row in State.AttributeSchema.Rows)
                                {
                                    if (row.Type == AttributeValueType.Score || row.Type == AttributeValueType.Modifier)
                                    {
                                        <option value="@row.Name" selected="@(Config.AttributeName == row.Name)">@row.Name</option>
                                    }
                                }
                            }
                        </select>
                        @if (IsHost)
                        {
                            <span class="dndm-label" style="margin-top:0.4rem">From sheet</span>
                            <select class="dndm-select" @onchange="@(e => OnSheetChange((string?)e.Value))">
                                <option value="" selected="@(Config.PickerSheetId is null)">— No sheet (GM) —</option>
                                @foreach (var s in _pickableSheets)
                                {
                                    <option value="@s.Id" selected="@(Config.PickerSheetId == s.Id)">@(string.IsNullOrEmpty(s.CharacterName) ? "(unnamed)" : s.CharacterName)</option>
                                }
                            </select>
                        }
                    </section>
                }

                <section>
                    <span class="dndm-label">Flat modifier</span>
                    <input type="number"
                           class="dndm-input dndm-input--num"
                           value="@Config.FlatModifier"
                           @onchange="@(e => OnFlatModChange(e.Value))" />
                </section>

                <section>
                    <span class="dndm-label">Mode</span>
                    <div class="dndm-pillgroup">
                        <button class="@PillCls(Config.Mode == RollMode.Normal)" type="button"
                                @onclick="@(() => SetMode(RollMode.Normal))">Normal</button>
                        <button class="@PillCls(Config.Mode == RollMode.Advantage)" type="button"
                                disabled="@(!CanAdvDis)"
                                @onclick="@(() => SetMode(RollMode.Advantage))">Adv</button>
                        <button class="@PillCls(Config.Mode == RollMode.Disadvantage)" type="button"
                                disabled="@(!CanAdvDis)"
                                @onclick="@(() => SetMode(RollMode.Disadvantage))">Dis</button>
                    </div>
                    @if (!CanAdvDis)
                    {
                        <span class="dndm-dice-hint">Adv/Dis only when rolling exactly one die.</span>
                    }
                </section>

                <section>
                    <span class="dndm-label">Label</span>
                    <input class="dndm-input"
                           value="@Config.Label"
                           @onchange="@(e => OnLabelChange((string?)e.Value))"
                           placeholder="Attack roll, save vs fear…" />
                </section>
            </div>
        </details>

        <div class="dndm-rolllog-entries">
            <span class="dndm-label">Rolls</span>
            @if (Visible.Count == 0)
            {
                <div class="dndm-panel-empty">No rolls yet.</div>
            }
            else
            {
                @foreach (var r in Visible)
                {
                    @RenderEntry(r)
                }
            }
            <button class="dndm-btn dndm-btn--small dndm-btn--ghost dndm-rolllog-seeall"
                    type="button"
                    @onclick="OpenHistory">See All Rolls</button>
        </div>
    </div>
</section>

@if (_libraryOpen)
{
    <RollTemplateLibraryModal State="State"
                              Sheet="ActiveSheetForTemplates"
                              Caller="@(UserService.CurrentUser)"
                              IsHost="IsHost"
                              OnClose="CloseTemplateLibrary" />
}

@if (_historyOpen)
{
    <div class="dndm-modal-overlay" @onclick="CloseHistory">
        <div class="dndm-modal-card dndm-rolllog-history" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header class="dndm-rolllog-history-header">
                <h3 class="dndm-modal-title">Roll History</h3>
                <button class="dndm-btn dndm-btn--icon dndm-btn--small" type="button" @onclick="CloseHistory">×</button>
            </header>
            <div class="dndm-rolllog-history-body">
                @if (_historySnapshot.Count == 0)
                {
                    <div class="dndm-panel-empty">No rolls yet.</div>
                }
                else
                {
                    @foreach (var r in _historySnapshot)
                    {
                        @RenderEntry(r)
                    }
                }
            </div>
            <footer class="dndm-rolllog-history-footer">
                <span class="dndm-rolllog-history-hint">Showing @_historySnapshot.Count snapshotted at @_historyCapturedAt.ToString("HH:mm:ss") — reopen to refresh.</span>
                <button class="dndm-btn dndm-btn--ghost" type="button" @onclick="CloseHistory">Close</button>
            </footer>
        </div>
    </div>
}

@code {
    private RenderFragment RenderEntry(RollResult r) => __builder =>
    {
        <article @key="r.Id" class="dndm-rolllog-entry">
            <header class="dndm-rolllog-meta">
                <span class="dndm-rolllog-roller">@RollerName(r.RollerUserId)</span>
                <span class="dndm-rolllog-formula" title="Dice formula">@r.Formula</span>
                <span class="dndm-rolllog-label">@r.Label</span>
                @if (r.Mode != RollMode.Normal)
                {
                    <span class="dndm-rolllog-mode">@(r.Mode == RollMode.Advantage ? "ADV" : "DIS")</span>
                }
                @if (ShouldShowLoadedIndicator(r))
                {
                    <span class="dndm-rolllog-loaded" title="@LoadedTooltip(r)" aria-label="Modified by loaded-dice rule">●</span>
                }
                <time class="dndm-rolllog-time"
                      datetime="@r.TimestampUtc.ToString("o")"
                      title="@r.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@FormatTimestamp(r.TimestampUtc)</time>
                @if (r.RollerUserId == CurrentUserId && r.TokenId is null)
                {
                    var enabled = CanReRoll(r);
                    <button class="dndm-btn dndm-btn--small dndm-btn--icon dndm-rolllog-reroll"
                            type="button"
                            disabled="@(!enabled)"
                            aria-label="Re-roll"
                            title="@(enabled ? ReRollTitle(r) : "Re-roll isn't available for rolls saved before this feature shipped.")"
                            @onclick="@(e => ReRoll(r, e))">↻</button>
                }
            </header>
            <div class="dndm-rolllog-dice">
                <span class="dndm-rolllog-total"><strong>@r.Total</strong></span>
                <span class="dndm-rolllog-dice-detail">
                    @foreach (var d in r.Rolls)
                    {
                        <span class="@($"dndm-die{(d.Discarded ? " dndm-die--discarded" : "")}")"
                              title="@DieTooltip(d)">@d.Result</span>
                    }
                    @if (r.FlatModifier != 0 || r.AttributeModifier is not null)
                    {
                        var mods = (r.FlatModifier) + (r.AttributeModifier ?? 0);
                        <span class="dndm-rolllog-mod">@(mods >= 0 ? "+" : "")@mods</span>
                    }
                </span>
            </div>
        </article>
    };
}
