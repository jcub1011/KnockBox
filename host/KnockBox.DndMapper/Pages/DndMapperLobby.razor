@using KnockBox.DndMapper.Services.State.Games

<div class="dndm-content">
    @if (State.IsJoinable)
    {
        <div class="card">
            <h4>Players</h4>
            <div class="player-list">
                @foreach (var entry in State.Players)
                {
                    <button class="btn" title="Click to kick player."
                            @onclick="() => State.KickPlayer(entry.User)">
                        @entry.DisplayName @(entry.User.Id == State.Host.Id ? "(Host)" : "")
                    </button>
                }
            </div>
            @if (UserService.CurrentUser?.Id == State.Host.Id)
            {
                <button class="btn btn-primary mt-3" @onclick="StartGame">Start Session</button>
            }
        </div>
    }
    else
    {
        <div class="card">
            <h3>DnD Mapper</h3>
            <p>Game scaffold &mdash; gameplay coming soon.</p>
        </div>
    }
</div>
