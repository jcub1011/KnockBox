@page "/room/dnd-mapper/{ObfuscatedRoomCode}"
@using KnockBox.DndMapper.Models
@using KnockBox.DndMapper.Services.State.Games
@inherits LobbyPageBase<DndMapperGameState>

<PageTitle>DnD Mapper</PageTitle>

<HeadContent>
    <link href="_content/KnockBox.DndMapper/KnockBox.DndMapper.styles.css" rel="stylesheet" />
</HeadContent>

@if (GameState is null || UserService.CurrentUser is null)
{
    <div class="dndm-loading">Loading…</div>
}
else
{
    @switch (GameState.Phase)
    {
        case DndMapperPhase.Lobby:
            <DndMapperLobby State="GameState" RoomCode="@ObfuscatedRoomCode" />
            break;

        case DndMapperPhase.Playing:
            <DndMapperPlayingPhase State="GameState"
                                   RoomCode="@ObfuscatedRoomCode"
                                   IsHost="IsHost()"
                                   CurrentUserId="@UserService.CurrentUser.Id" />
            break;
    }
}
