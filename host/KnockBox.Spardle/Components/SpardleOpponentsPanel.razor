@using KnockBox.Spardle
@implements IDisposable

<div class="spd-opp-panel">
    <div class="spd-opp-heading">
        <span class="spd-opp-heading-glyph">⚔</span>
        LEADERS
    </div>

    @{
        var ranked = GetRanked();
        var me = FindCurrentUser(ranked);
        var topCount = Math.Min(ranked.Count, TopCount);
        var showSelfOverflow = me is not null && me.Rank > TopCount;
    }

    @if (ranked.Count == 0)
    {
        <div class="spd-opp-empty">No players yet.</div>
    }
    else
    {
        <div class="spd-opp-list">
            @for (int i = 0; i < topCount; i++)
            {
                @RenderRow(ranked[i])
            }

            @if (showSelfOverflow)
            {
                <div class="spd-opp-divider" aria-hidden="true">⋯</div>
                @RenderRow(me!)
            }
        </div>
    }
</div>

@code {
    private const int TopCount = 5;

    [Parameter, EditorRequired] public SpardleState State { get; set; } = default!;
    [Parameter, EditorRequired] public string CurrentUserId { get; set; } = default!;

    private SpardleState? _subscribedState;
    private IDisposable? _stateSubscription;
    private IReadOnlyList<SpardleOpponentsRanking.RankedEntry>? _rankedCache;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribedState, State)) return;

        _stateSubscription?.Dispose();
        _stateSubscription = null;

        if (State is null)
        {
            _subscribedState = null;
            _rankedCache = null;
            return;
        }

        _subscribedState = State;
        _rankedCache = null;
        _stateSubscription = State.StateChangedEventManager.Subscribe(OnStateChangedAsync);
    }

    private async ValueTask OnStateChangedAsync()
    {
        _rankedCache = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _stateSubscription?.Dispose();
    }

    private IReadOnlyList<SpardleOpponentsRanking.RankedEntry> GetRanked()
        => _rankedCache ??= SpardleOpponentsRanking.ComputeRanked(State);

    private SpardleOpponentsRanking.RankedEntry? FindCurrentUser(IReadOnlyList<SpardleOpponentsRanking.RankedEntry> ranked)
    {
        for (int i = 0; i < ranked.Count; i++)
        {
            if (ranked[i].User.Id == CurrentUserId) return ranked[i];
        }
        return null;
    }

    private RenderFragment RenderRow(SpardleOpponentsRanking.RankedEntry entry) => __builder =>
    {
        var ps = entry.PlayerState;
        var isMe = entry.User.Id == CurrentUserId;
        var stateClass = ps.Dnf
            ? "spd-opp-row-dnf"
            : ps.HasFinishedRound
                ? "spd-opp-row-solved"
                : "spd-opp-row-live";
        var badge = SpardleOpponentsRanking.FormatBadge(State, ps);
        var rankTierClass = entry.Rank switch
        {
            1 => "spd-opp-rank-gold",
            2 => "spd-opp-rank-silver",
            3 => "spd-opp-rank-bronze",
            _ => ""
        };

        <div class="spd-opp-row @stateClass @(isMe ? "spd-opp-row-me" : "")">
            <span class="spd-opp-rank @rankTierClass">@entry.Rank</span>
            <span class="spd-opp-name">@entry.DisplayName</span>
            <span class="spd-opp-badge">@badge</span>
            <span class="spd-opp-score spd-mono">@ps.TotalScore</span>
        </div>
    };
}
