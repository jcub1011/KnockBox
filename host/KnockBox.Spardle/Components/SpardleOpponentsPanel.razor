@using KnockBox.Spardle.Models
@using KnockBox.Spardle
@using KnockBox.Core.Services.State.Users

<div class="spd-opp-panel">
    <div class="spd-opp-heading">
        <span class="spd-opp-heading-glyph">⚔</span>
        OPPONENTS
    </div>

    @{
        int maxGuesses = State.TargetWord.Length > 0
            ? SpardleEngine.CalculateMaxGuesses(State.TargetWord.Length, State.DifficultyMultiplier)
            : 6;
        var accents = new[] { "spd-opp-a", "spd-opp-b", "spd-opp-c", "spd-opp-d" };
        int accentIdx = 0;
        var roster = State.Players.Prepend(State.Host).Where(u => u.Id != CurrentUserId).ToList();
    }

    @if (roster.Count == 0)
    {
        <div class="spd-opp-empty">No opponents yet.</div>
    }

    @foreach (var user in roster)
    {
        var ps = State.GetOrCreatePlayerState(user.Id);
        var accent = accents[accentIdx++ % accents.Length];
        string statusTag;
        string statusClass;
        if (ps.Dnf) { statusTag = "DNF"; statusClass = "spd-opp-dnf"; }
        else if (ps.HasFinishedRound) { statusTag = "SOLVED"; statusClass = "spd-opp-solved"; }
        else { statusTag = "GUESSING…"; statusClass = "spd-opp-active"; }

        <div class="spd-opp-card @accent">
            <div class="spd-opp-top">
                <span class="spd-opp-avatar">@Initials(user.Name)</span>
                <span class="spd-opp-name">@user.Name</span>
                <span class="spd-opp-count spd-mono">@ps.Guesses.Count/@maxGuesses</span>
            </div>
            <div class="spd-opp-pips">
                @for (int i = 0; i < maxGuesses; i++)
                {
                    string pipClass = "spd-opp-pip-empty";
                    if (i < ps.Guesses.Count)
                    {
                        var g = ps.Guesses[i];
                        if (g.IsCorrect) pipClass = "spd-opp-pip-correct";
                        else if (g.Statuses.Any(st => st == LetterStatus.Correct)) pipClass = "spd-opp-pip-hit";
                        else if (g.Statuses.Any(st => st == LetterStatus.Present)) pipClass = "spd-opp-pip-present";
                        else pipClass = "spd-opp-pip-miss";
                    }
                    <span class="spd-opp-pip @pipClass"></span>
                }
            </div>
            <div class="spd-opp-status @statusClass">@statusTag</div>
        </div>
    }

    <div class="spd-opp-score">
        <span class="spd-opp-score-label">YOUR SCORE</span>
        <span class="spd-opp-score-value spd-display">@MyScore</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SpardleState State { get; set; } = default!;
    [Parameter, EditorRequired] public string CurrentUserId { get; set; } = default!;

    private int MyScore => State.PlayerStates.TryGetValue(CurrentUserId, out var ps) ? ps.TotalScore : 0;

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }
}
