<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=JetBrains+Mono:wght@700&family=Manrope:wght@600;800&display=swap" rel="stylesheet" />
</HeadContent>

<div class="game-tile-surface spardle-tile">
    <div class="spardle-tile-glow" aria-hidden="true"></div>

    <div class="spardle-tile-grid" aria-hidden="true">
        <span class="spardle-tile-letter spardle-tile-letter-correct" style="--col:0;">S</span>
        <span class="spardle-tile-letter spardle-tile-letter-absent"  style="--col:1;">P</span>
        <span class="spardle-tile-letter spardle-tile-letter-present" style="--col:2;">A</span>
        <span class="spardle-tile-letter spardle-tile-letter-correct" style="--col:3;">R</span>
        <span class="spardle-tile-letter spardle-tile-letter-absent"  style="--col:4;">D</span>
        <span class="spardle-tile-letter spardle-tile-letter-present" style="--col:5;">L</span>
        <span class="spardle-tile-letter spardle-tile-letter-correct" style="--col:6;">E</span>
    </div>

    <div class="spardle-tile-name">
        <span class="spardle-tile-name-spar">SPAR</span><span class="spardle-tile-name-dash">–</span><span class="spardle-tile-name-dle">DLE</span>
    </div>
    <div class="spardle-tile-tag">Head-to-head word combat.</div>
</div>
