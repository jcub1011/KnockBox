<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <!--
      Reference the word-service contracts assembly so Spardle can inject
      IWordListService at compile time. The runtime resolves the interface
      via the host's DI container; the IWordListService implementation lives
      in the sibling KnockBox.WordService library plugin, which the host
      loads before any game plugin.
    -->
    <ProjectReference Include="..\KnockBox.WordService.Contracts\KnockBox.WordService.Contracts.csproj" />
    <!--
      The shared contract DTOs (moved gameplay types + the wire view/commands/
      settings the WASM client binds). Referenced at compile time AND staged as a
      PRIVATE ALC dependency below so the plugin's load context can resolve it at
      runtime — without the PluginPrivateAssembly item the plugin silently fails to
      load and the tile vanishes from the home page.
    -->
    <ProjectReference Include="..\KnockBox.Spardle.Contracts\KnockBox.Spardle.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PluginPrivateAssembly Include="$(TargetDir)KnockBox.Spardle.Contracts.dll" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="KnockBox.Spardle.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnockBox.SpardleTests" />
  </ItemGroup>

  <Import Project="..\Directory.Plugin.targets" />

</Project>
