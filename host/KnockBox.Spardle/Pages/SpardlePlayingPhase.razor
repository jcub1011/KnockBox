@using KnockBox.Core.Services.State.Users
@using KnockBox.Spardle
@using KnockBox.Spardle.Components
@using KnockBox.Spardle.Models
@implements IDisposable
@inject IUserService UserService

<div class="spd-play" @key="@State.CurrentRound">
    <div class="spd-play-curtain" aria-hidden="true">
        <span class="spd-display spd-play-curtain-text">SPAR!</span>
    </div>

    <header class="spd-play-top">
        <div class="spd-play-round">
            <span class="spd-play-round-label">ROUND</span>
            <span class="spd-play-round-value spd-display">@State.CurrentRound</span>
            <span class="spd-play-round-total">/ @State.RoundQueue.Count</span>
        </div>

        <SpardleRoundTimer State="State" />

        <div class="spd-play-top-actions">
            @if (CanGiveUp)
            {
                <button type="button"
                        class="spd-give-up-btn @(_giveUpArmed ? "spd-give-up-armed" : "")"
                        @onclick="OnGiveUpClicked"
                        title="@(_giveUpArmed ? "Tap again to confirm" : "End your round early")">
                    @(_giveUpArmed ? "YOU SURE?" : "GIVE UP")
                </button>
            }

            <button type="button"
                    class="spd-play-hc-toggle @(HighContrast ? "spd-play-hc-on" : "")"
                    @onclick="OnToggleContrast"
                    title="Toggle high-contrast colours">
                <span class="spd-play-hc-dot"></span>
                <span>HC</span>
            </button>
        </div>
    </header>

    <main class="spd-play-main">
        <section class="spd-play-board">
            <SpardleGrid State="State"
                         CurrentUserId="@(UserService.CurrentUser?.Id ?? Guid.Empty)"
                         CurrentGuess="@CurrentGuess"
                         InvalidGuess="InvalidGuess"
                         HighContrast="HighContrast" />

            <SpardleKeyboard OnKeyPressed="OnKey"
                             PlayerState="PlayerState"
                             HighContrast="HighContrast" />
        </section>

        <aside class="spd-play-leaderboard-slot">
            <SpardleOpponentsPanel State="State" CurrentUserId="@(UserService.CurrentUser?.Id ?? Guid.Empty)" />
        </aside>
    </main>

    <SpardleToast Message="@ToastMessage" Tone="ToastTone" />
</div>

@code {
    [Parameter, EditorRequired] public SpardleState State { get; set; } = default!;
    [Parameter] public string CurrentGuess { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnKey { get; set; }
    [Parameter] public string? ToastMessage { get; set; }
    [Parameter] public SpardleToast.ToastTone ToastTone { get; set; } = SpardleToast.ToastTone.Danger;
    [Parameter] public bool InvalidGuess { get; set; }
    [Parameter] public bool HighContrast { get; set; }
    [Parameter] public EventCallback OnToggleContrast { get; set; }
    [Parameter] public EventCallback OnGiveUp { get; set; }

    private PlayerState? PlayerState =>
        UserService.CurrentUser is { Id: var id } && State.TryGetPlayerState(id, out var p) ? p : null;

    private bool CanGiveUp => State.IsRoundActive && PlayerState is { HasFinishedRound: false };

    private bool _giveUpArmed;
    private CancellationTokenSource? _giveUpResetCts;
    private bool _disposed;

    private async Task OnGiveUpClicked()
    {
        if (!_giveUpArmed)
        {
            _giveUpResetCts?.Cancel();
            _giveUpResetCts = new CancellationTokenSource();
            var token = _giveUpResetCts.Token;
            _giveUpArmed = true;
            try
            {
                await Task.Delay(5000, token);
                if (_disposed || token.IsCancellationRequested) return;
                _giveUpArmed = false;
                StateHasChanged();
            }
            catch (OperationCanceledException) { /* superseded */ }
            return;
        }

        _giveUpResetCts?.Cancel();
        _giveUpArmed = false;
        if (OnGiveUp.HasDelegate) await OnGiveUp.InvokeAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _giveUpResetCts?.Cancel();
        _giveUpResetCts?.Dispose();
    }
}
