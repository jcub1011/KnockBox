@using System.Collections.Immutable
@using KnockBox.Core.Services.State.Users
@using KnockBox.Spardle.Models
@using KnockBox.Spardle
@using KnockBox.WordService.Contracts
@using KnockBox.Core.Primitives.Returns
@using KnockBox.Core.Services.Storage.ClientStorage
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject IUserService UserService
@inject SpardleEngine GameEngine
@inject IWordListService WordList
@inject IJSRuntime JSRuntime
@inject ILocalStorageService LocalStorage
@inject ILogger<SpardleLobbyPhase> Logger
@implements IAsyncDisposable

<div class="spd-lobby">
    <div class="spd-lobby-stage">
        <div class="spd-lobby-brand">
            <span class="spd-lobby-brand-spar">SPAR</span><span class="spd-lobby-brand-dash">–</span><span class="spd-lobby-brand-dle">DLE</span>
        </div>
        <div class="spd-lobby-tagline">HEAD-TO-HEAD WORD COMBAT</div>

        @{
            var roster = State.RosterIncludingHost.ToList();
            int idx = 0;
        }
        <div class="spd-lobby-challengers">
            <div class="spd-lobby-challengers-label">CHALLENGERS (@roster.Count)</div>
            <div class="spd-lobby-challengers-list">
                @foreach (var entry in roster)
                {
                    bool isHost = entry.User.Id == State.Host.Id;
                    bool isMe = entry.User.Id == UserService.CurrentUser?.Id;
                    string accent = $"spd-opp-{(idx++ % 4) switch { 0 => "a", 1 => "b", 2 => "c", _ => "d" }}";
                    <div class="spd-lobby-chip @accent @(isMe ? "spd-lobby-chip-me" : "")">
                        <span class="spd-lobby-chip-avatar">@Initials(entry.DisplayName)</span>
                        <span class="spd-lobby-chip-name">@entry.DisplayName</span>
                        @if (isHost)
                        {
                            <span class="spd-lobby-chip-badge">HOST</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (IsHost)
        {
            <button class="spd-btn spd-btn-primary spd-btn-lg spd-lobby-start" @onclick="() => StartGame(false)"
                    disabled="@(!CanStart)" title="Start the match — you run the shared display and don't play">
                ⚔ ENTER THE ARENA
            </button>
            <button class="spd-btn spd-btn-ghost spd-btn-lg spd-lobby-start" @onclick="() => StartGame(true)"
                    disabled="@(!CanStart)" title="Start the match and fight as a challenger">
                🗡 ENTER AS CHALLENGER
            </button>
            @if (!CanStart)
            {
                <p class="spd-lobby-hint">Configure at least one word in the pool.</p>
            }
            @if (!string.IsNullOrEmpty(_startError))
            {
                <p class="spd-lobby-hint spd-lobby-hint-error">@_startError</p>
            }
            <button class="spd-lobby-settings-gear" @onclick="ToggleSettings" title="Match Rules">
                ⚙
            </button>
        }
        else
        {
            <p class="spd-lobby-waiting">Waiting for <span class="spd-mono">@State.Host.Name</span> to open the arena…</p>
        }
    </div>

    @if (IsHost)
    {
        @if (SettingsOpen)
        {
            <div class="spd-lobby-backdrop" @onclick="ToggleSettings"></div>
        }
        <aside class="spd-lobby-drawer @(SettingsOpen ? "spd-lobby-drawer-open" : "")">
            <div class="spd-lobby-drawer-head">
                <h3 class="spd-display spd-lobby-drawer-title">Match Rules</h3>
                <button class="spd-lobby-drawer-close" @onclick="ToggleSettings" title="Close">✕</button>
            </div>

            <div class="spd-lobby-drawer-body">
                <section>
                    <h4 class="spd-lobby-section-title">Word Pool</h4>
                    <div class="spd-lobby-field-grid">
                        <label class="spd-lobby-field">
                            <span>Source</span>
                            <select @bind:get="State.Settings.WordPoolMode" @bind:set="SetWordPoolMode">
                                <option value="@SpardleWordSource.NytStandard">NYT Standard</option>
                                <option value="@SpardleWordSource.FullDictionary">Full Dictionary</option>
                                <option value="@SpardleWordSource.HostDefined">Host Defined</option>
                                <option value="@SpardleWordSource.CsvUpload">CSV Upload</option>
                            </select>
                        </label>
                        @if (State.Settings.WordPoolMode == SpardleWordSource.CsvUpload)
                        {
                            <label class="spd-lobby-field spd-lobby-field-full">
                                <span>CSV File (max 1MB)</span>
                                <div class="spd-csv-picker">
                                    <input @ref="_csvFileInput"
                                           type="file"
                                           accept=".csv,text/csv,text/plain"
                                           class="spd-csv-picker-input" />
                                    <span class="spd-csv-picker-button">Choose File</span>
                                    <span class="spd-csv-picker-name">@(string.IsNullOrEmpty(_csvFileName) ? "No file chosen" : _csvFileName)</span>
                                </div>
                                @if (_csvWordCount > 0 && string.IsNullOrEmpty(_csvUploadError))
                                {
                                    <p class="spd-lobby-hint spd-csv-count">@_csvWordCount word@(_csvWordCount == 1 ? "" : "s") uploaded</p>
                                }
                                @if (!string.IsNullOrEmpty(_csvUploadError))
                                {
                                    <p class="spd-lobby-hint spd-lobby-hint-error">@_csvUploadError</p>
                                }
                            </label>
                        }
                        <label class="spd-lobby-field">
                            <span>Order</span>
                            <select @bind:get="State.Settings.WordOrderMode" @bind:set="SetWordOrderMode">
                                <option value="@WordOrderMode.RandomNoRepeats">Random (No Repeats)</option>
                                <option value="@WordOrderMode.RandomWithRepeats">Random (With Repeats)</option>
                                <option value="@WordOrderMode.ListOrder">List Order</option>
                                <option value="@WordOrderMode.ReverseListOrder">Reverse List Order</option>
                            </select>
                        </label>
                        @if (State.Settings.WordPoolMode == SpardleWordSource.FullDictionary)
                        {
                            <label class="spd-lobby-field spd-lobby-field-row">
                                <span>Constant Word Length</span>
                                <input type="checkbox" @bind:get="State.Settings.ConstantWordLength" @bind:set="SetConstantWordLength" />
                            </label>

                            @if (State.Settings.ConstantWordLength)
                            {
                                <label class="spd-lobby-field">
                                    <span>Word Length</span>
                                    <select @bind:get="State.Settings.TargetWordLength" @bind:set="SetTargetWordLength">
                                        @foreach (var len in WordList.GetAvailableLengths(WordPoolMode.FullDictionary))
                                        {
                                            <option value="@len">@len</option>
                                        }
                                    </select>
                                </label>
                            }
                            else
                            {
                                <label class="spd-lobby-field">
                                    <span>Min Length</span>
                                    <select @bind:get="State.Settings.MinWordLength" @bind:set="SetMinWordLength">
                                        @foreach (var len in WordList.GetAvailableLengths(WordPoolMode.FullDictionary))
                                        {
                                            <option value="@len">@len</option>
                                        }
                                    </select>
                                </label>
                                <label class="spd-lobby-field">
                                    <span>Max Length</span>
                                    <select @bind:get="State.Settings.MaxWordLength" @bind:set="SetMaxWordLength">
                                        @foreach (var len in WordList.GetAvailableLengths(WordPoolMode.FullDictionary))
                                        {
                                            <option value="@len">@len</option>
                                        }
                                    </select>
                                </label>
                            }
                        }
                        @if (State.Settings.WordPoolMode == SpardleWordSource.HostDefined)
                        {
                            <label class="spd-lobby-field spd-lobby-field-full">
                                <span>Custom Words (one per line)</span>
                                <textarea class="spd-lobby-textarea spd-mono"
                                          rows="5"
                                          value="@_customPoolText"
                                          @oninput="OnCustomPoolChanged"></textarea>
                            </label>
                        }
                    </div>
                </section>

                <section>
                    <h4 class="spd-lobby-section-title">Rounds &amp; Timing</h4>
                    <div class="spd-lobby-field-grid">
                        <label class="spd-lobby-field">
                            <span>Total Rounds</span>
                            <input type="number" min="1" max="50" @bind:get="State.Settings.TotalRounds" @bind:set="SetTotalRounds" />
                        </label>
                        <label class="spd-lobby-field">
                            <span>Round Timer (seconds)</span>
                            <input type="number" min="30" max="600" step="5"
                                   value="@((int)State.Settings.RoundTimer.TotalSeconds)"
                                   @oninput="OnRoundTimerChanged"
                                   disabled="@_unlimitedTimer" />
                        </label>
                        <label class="spd-lobby-field spd-lobby-field-row">
                            <span>Unlimited Timer</span>
                            <input type="checkbox" @bind="_unlimitedTimer" @bind:after="OnUnlimitedToggled" />
                        </label>
                        <label class="spd-lobby-field">
                            <span>Transition Between Rounds</span>
                            <input type="number" min="2" max="15" step="1"
                                   value="@((int)State.Settings.TransitionDuration.TotalSeconds)"
                                   @oninput="OnTransitionChanged" />
                        </label>
                    </div>
                </section>

                <section>
                    <h4 class="spd-lobby-section-title">Win Condition</h4>
                    <div class="spd-lobby-field-grid">
                        <label class="spd-lobby-field">
                            <span>Mode</span>
                            <select @bind:get="State.Settings.WinCondition" @bind:set="SetWinCondition">
                                <option value="@WinConditionMode.Sprinter">Sprinter (first to solve)</option>
                                <option value="@WinConditionMode.Tactician">Tactician (fewest guesses)</option>
                            </select>
                        </label>
                        <label class="spd-lobby-field">
                            <span>Difficulty Multiplier (k)</span>
                            <select @bind:get="State.Settings.DifficultyMultiplier" @bind:set="SetDifficultyMultiplier">
                                @* Option values must match BindConverter's double formatting
                                   (2.0 → "2", not "2.0") or the re-render finds no matching
                                   option and clears the selection. *@
                                <option value="1">Gentle (k = 1)</option>
                                <option value="2">Standard (k = 2)</option>
                                <option value="3">Brutal (k = 3)</option>
                            </select>
                        </label>
                        <label class="spd-lobby-field spd-lobby-field-row">
                            <span>Hard Mode</span>
                            <input type="checkbox" @bind:get="State.Settings.HardModeEnabled" @bind:set="SetHardModeEnabled" />
                        </label>
                        <label class="spd-lobby-field spd-lobby-field-row">
                            <span>Wait For All Players</span>
                            <input type="checkbox" @bind:get="State.Settings.WaitForAll" @bind:set="SetWaitForAll" />
                        </label>
                        <label class="spd-lobby-field spd-lobby-field-row">
                            <span>Reveal Answer</span>
                            <input type="checkbox" @bind:get="State.Settings.RevealAnswer" @bind:set="SetRevealAnswer" />
                        </label>
                        <label class="spd-lobby-field spd-lobby-field-row">
                            <span>Dictionary Fallback</span>
                            <input type="checkbox" @bind:get="State.Settings.AllowDictionaryFallback" @bind:set="SetAllowDictionaryFallback" />
                        </label>
                        <label class="spd-lobby-field spd-lobby-field-row">
                            <span>Allow Compound Words</span>
                            <input type="checkbox" @bind:get="State.Settings.AllowCompoundWords" @bind:set="SetAllowCompoundWords" />
                        </label>
                    </div>
                </section>

                <div class="spd-lobby-drawer-footer">
                    <button type="button" class="spd-btn @(_resetArmed ? "spd-btn-danger" : "spd-btn-ghost")"
                            @onclick="ResetToDefaults">
                        @(_resetArmed ? "⚠ Click again to confirm" : "↺ Reset to Defaults")
                    </button>
                </div>
            </div>
        </aside>
    }
</div>

@code {
    [Parameter, EditorRequired] public SpardleState State { get; set; } = default!;
    [Parameter] public string RoomCode { get; set; } = string.Empty;

    private bool SettingsOpen { get; set; }
    private bool _unlimitedTimer;
    private string _customPoolText = string.Empty;
    private string? _startError;
    private CancellationTokenSource? _startErrorCts;

    private ElementReference _csvFileInput;
    private IJSObjectReference? _csvUploadModule;
    private DotNetObjectReference<SpardleLobbyPhase>? _csvSelfRef;
    private string? _csvUploadError;
    private bool _csvModuleAttached;
    private string? _csvFileName;
    private int _csvWordCount;

    private readonly CancellationTokenSource _cts = new();
    private Task? _saveTask;

    // True once the host has changed any setting locally. Blocks the initial localStorage
    // load from clobbering an in-flight edit if the load returns after the user interacted.
    private bool _userHasEdited;

    private bool IsHost => UserService.CurrentUser?.Id == State.Host.Id;
    private bool CanStart => State.CustomWordPool.Count > 0
        || State.Settings.WordPoolMode == SpardleWordSource.NytStandard
        || State.Settings.WordPoolMode == SpardleWordSource.FullDictionary;

    protected override void OnInitialized()
    {
        _customPoolText = string.Join('\n', State.CustomWordPool);
        _unlimitedTimer = State.Settings.RoundTimer <= TimeSpan.Zero;
    }

    private void ToggleSettings() => SettingsOpen = !SettingsOpen;

    // Delegates the atomic mutation to the state (which enforces Execute + change
    // notification) and then persists. _userHasEdited blocks any in-flight localStorage
    // load from clobbering this edit.
    private void UpdateSettings(Func<SpardleSettings, SpardleSettings> mutate)
    {
        _userHasEdited = true;
        if (State.UpdateSettings(mutate).TryGetFailure(out var error))
        {
            Logger.LogError("Failed to update Spardle settings: {Error}", error.PublicMessage);
            return;
        }
        PersistSettings();
    }

    // Two-step confirm so an accidental click can't wipe the host's whole config.
    // First click arms; a second click within the window resets. Auto-disarms after ~3s.
    private bool _resetArmed;
    private int _resetGeneration;

    private void ResetToDefaults()
    {
        if (!_resetArmed)
        {
            _resetArmed = true;
            _ = DisarmResetAfterDelay(++_resetGeneration);
            return;
        }
        _resetArmed = false;
        _resetGeneration++;                          // invalidate any pending disarm
        UpdateSettings(_ => new SpardleSettings());
        // Keep the "unlimited timer" toggle in sync with the default RoundTimer.
        _unlimitedTimer = State.Settings.RoundTimer <= TimeSpan.Zero;
    }

    private async Task DisarmResetAfterDelay(int generation)
    {
        try { await Task.Delay(TimeSpan.FromSeconds(3), _cts.Token); }
        catch (OperationCanceledException) { return; }   // component disposed
        if (generation != _resetGeneration) return;      // superseded by a newer arm/reset
        _resetArmed = false;
        await InvokeAsync(StateHasChanged);
    }

    private void SetWordPoolMode(SpardleWordSource value)
    {
        // NYT and Full Dictionary have no visible custom-words editor, so any leftover
        // CustomWordPool entries would silently override the built-in source. Clear them
        // on transition so the mode the user selects is the one the engine actually uses.
        bool clearCustom = value is SpardleWordSource.NytStandard or SpardleWordSource.FullDictionary;
        UpdateSettings(s => s with { WordPoolMode = value });
        if (clearCustom)
        {
            State.Execute(() => State.CustomWordPool = ImmutableList<string>.Empty);
            _customPoolText = string.Empty;
            _csvFileName = null;
            _csvWordCount = 0;
            _csvUploadError = null;
        }
    }
    private void SetWordOrderMode(WordOrderMode value) => UpdateSettings(s => s with { WordOrderMode = value });
    private void SetConstantWordLength(bool value) => UpdateSettings(s => s with { ConstantWordLength = value });
    private void SetTargetWordLength(int value) => UpdateSettings(s => s with { TargetWordLength = value });
    private void SetWinCondition(WinConditionMode value) => UpdateSettings(s => s with { WinCondition = value });
    private void SetDifficultyMultiplier(double value) => UpdateSettings(s => s with { DifficultyMultiplier = value });
    private void SetHardModeEnabled(bool value) => UpdateSettings(s => s with { HardModeEnabled = value });
    private void SetWaitForAll(bool value) => UpdateSettings(s => s with { WaitForAll = value });
    private void SetRevealAnswer(bool value) => UpdateSettings(s => s with { RevealAnswer = value });
    private void SetAllowDictionaryFallback(bool value) => UpdateSettings(s => s with { AllowDictionaryFallback = value });
    private void SetAllowCompoundWords(bool value) => UpdateSettings(s => s with { AllowCompoundWords = value });
    private void SetTotalRounds(int value) => UpdateSettings(s => s with { TotalRounds = value });

    // Min/max clamping keeps min ≤ max by pushing the other bound along with the edit.
    // Both ends are set in the same `with` so the pair updates atomically.
    private void SetMinWordLength(int value) => UpdateSettings(s =>
        s with { MinWordLength = value, MaxWordLength = s.MaxWordLength < value ? value : s.MaxWordLength });
    private void SetMaxWordLength(int value) => UpdateSettings(s =>
        s with { MaxWordLength = value, MinWordLength = s.MinWordLength > value ? value : s.MinWordLength });

    private void OnCustomPoolChanged(ChangeEventArgs e)
    {
        _customPoolText = e.Value?.ToString() ?? string.Empty;
        var words = _customPoolText
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w.Trim().ToLowerInvariant())
            .Where(w => w.Length is > 0 and <= 64)
            .ToList();
        State.Execute(() => State.CustomWordPool = words.ToImmutableList());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // localStorage needs JS interop, so the host's saved rules load here (not in
        // OnInitialized, which also runs during prerender). Host-only: only the host edits
        // and persists these, so only the host's browser has anything to restore.
        if (firstRender && IsHost)
        {
            await LoadSettingsAsync();
        }

        bool shouldBeAttached = State.Settings.WordPoolMode == SpardleWordSource.CsvUpload;

        if (shouldBeAttached && !_csvModuleAttached)
        {
            _csvUploadModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/KnockBox.Spardle/js/spardle-csv-upload.js");
            _csvSelfRef ??= DotNetObjectReference.Create(this);
            await _csvUploadModule.InvokeVoidAsync("register", _csvFileInput, _csvSelfRef);
            _csvModuleAttached = true;
        }
        else if (!shouldBeAttached && _csvModuleAttached)
        {
            _csvModuleAttached = false;
        }
    }

    [JSInvokable]
    public void OnCsvUploaded(string fileName, string joinedText)
    {
        _customPoolText = joinedText ?? string.Empty;
        var words = _customPoolText
            .Split(new[] { '\n', '\r', ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(w => w.Trim().ToLowerInvariant())
            .Where(w => w.Length is > 0 and <= 64)
            .ToList();
        State.Execute(() => State.CustomWordPool = words.ToImmutableList());
        _csvFileName = fileName;
        _csvWordCount = words.Count;
        _csvUploadError = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCsvUploadError(string message)
    {
        _csvUploadError = message;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        // Flush the last pending save before tearing down so a change made right before
        // navigating away isn't lost. A dead circuit makes SetAsync return a failure result,
        // which SaveSettingsAsync logs and swallows, so this returns promptly rather than
        // hanging.
        if (_saveTask is not null)
        {
            try { await _saveTask; } catch { /* best-effort flush */ }
        }

        _cts.Cancel();
        _cts.Dispose();
        // Cancel the pending start-error auto-dismiss so its delayed StateHasChanged()
        // can't fire on a disposed component.
        _startErrorCts?.Cancel();
        _startErrorCts?.Dispose();
        try
        {
            if (_csvUploadModule is not null)
            {
                await _csvUploadModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* circuit already torn down */ }
        _csvSelfRef?.Dispose();
    }

    private void OnRoundTimerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int seconds))
        {
            var timer = TimeSpan.FromSeconds(Math.Clamp(seconds, 30, 600));
            UpdateSettings(s => s with { RoundTimer = timer });
        }
    }

    private void OnUnlimitedToggled()
    {
        var timer = _unlimitedTimer ? TimeSpan.Zero : TimeSpan.FromMinutes(3);
        UpdateSettings(s => s with { RoundTimer = timer });
    }

    private void OnTransitionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int seconds))
        {
            var span = TimeSpan.FromSeconds(Math.Clamp(seconds, 2, 15));
            UpdateSettings(s => s with { TransitionDuration = span });
        }
    }

    // Restore the host's previously saved match rules. Missing key → GetAsync returns
    // success-with-null, leaving the engine defaults in place. A failed or canceled read also
    // falls through to the defaults. CustomWordPool is intentionally not persisted, so
    // CSV/Host-defined pools start empty and must be re-entered.
    private async Task LoadSettingsAsync()
    {
        var savedResult = await LocalStorage.GetAsync<SpardleSettings>("spardle", "settings", _cts.Token);
        // If the host already edited a setting while the load was in flight,
        // the user's edit wins — the saved snapshot would clobber it.
        if (savedResult.TryGetSuccess(out var saved) && saved is not null && !_userHasEdited)
        {
            // Host participation is now an explicit start-button choice, not a saved
            // setting. Clear any legacy persisted value so it can't auto-seat the host.
            saved = saved with { HostPlaysAlong = false };
            if (State.UpdateSettings(_ => saved).TryGetFailure(out var error))
            {
                Logger.LogError("Failed to apply saved Spardle settings: {Error}", error.PublicMessage);
                return;
            }
            _unlimitedTimer = State.Settings.RoundTimer <= TimeSpan.Zero;
            StateHasChanged();
        }
    }

    // Snapshot the current settings and chain this save off the previous one. Chaining
    // serializes the localStorage writes so rapid edits can't complete out of order and
    // leave a stale snapshot as the last writer; the snapshot makes the final edit the
    // final write.
    private void PersistSettings()
    {
        var snapshot = State.Settings;
        _saveTask = SaveSettingsAsync(snapshot, _saveTask, _cts.Token);
    }

    private async Task SaveSettingsAsync(SpardleSettings settings, Task? prior, CancellationToken ct)
    {
        if (prior is not null)
        {
            try { await prior; } catch { /* prior failure already logged */ }
        }
        var saveResult = await LocalStorage.SetAsync("spardle", "settings", settings, ct);
        if (saveResult.TryGetFailure(out var saveError))
            Logger.LogError("Error saving Spardle settings: {Error}", saveError.InternalMessage);
    }

    private async Task StartGame(bool hostAsPlayer)
    {
        if (UserService.CurrentUser is null) return;
        // Decide host participation at start time; applied straight to state so it isn't
        // persisted to the host's saved settings.
        if (State.UpdateSettings(s => s with { HostPlaysAlong = hostAsPlayer }).TryGetFailure(out var settingsError))
        {
            await ShowStartError(settingsError.PublicMessage);
            return;
        }
        var result = await GameEngine.StartAsync(UserService.CurrentUser, State);
        if (result.TryGetFailure(out var failure))
        {
            await ShowStartError(failure.PublicMessage);
        }
    }

    private async Task ShowStartError(string message)
    {
        _startErrorCts?.Cancel();
        _startErrorCts = new CancellationTokenSource();
        var token = _startErrorCts.Token;
        _startError = message;
        StateHasChanged();
        try
        {
            await Task.Delay(3000, token);
            if (!token.IsCancellationRequested)
            {
                _startError = null;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { /* superseded */ }
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }
}
