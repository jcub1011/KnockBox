@page "/room/spardle/{ObfuscatedRoomCode}"
@using KnockBox.Core.Components.Shared
@using KnockBox.Spardle.Components
@using KnockBox.Spardle.Models
@inherits DisposableComponent

<PageTitle>Spar-dle</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=JetBrains+Mono:wght@500;700&family=Manrope:wght@400;600;800&display=swap" rel="stylesheet" />
    <link href="_content/KnockBox.Spardle/css/spardle-theme.css" rel="stylesheet" />
    <link href="_content/KnockBox.Spardle/KnockBox.Spardle.styles.css" rel="stylesheet" />
</HeadContent>

@if (GameState is null || UserService.CurrentUser is null)
{
    <div class="spd-loading">
        <span class="spd-loading-mark spd-display">SPARDLE</span>
        <span class="spd-loading-sub">Entering the arena…</span>
    </div>
}
else
{
    <div class="spd-page @(HighContrast ? "spd-hc" : "")">
        @switch (GameState.Phase)
        {
            case GamePhase.Lobby:
                <SpardleLobbyPhase State="GameState" RoomCode="@RoomCode" />
                break;
            case GamePhase.RoundIntro:
                <SpardleRoundIntro State="GameState" />
                break;
            case GamePhase.Playing:
                @if (IsHostObserver)
                {
                    <SpardleHostObserverPlayingView State="GameState"
                                                    HighContrast="HighContrast"
                                                    OnToggleContrast="ToggleContrast" />
                }
                else
                {
                    <SpardlePlayingPhase State="GameState"
                                         CurrentGuess="@_currentGuess"
                                         OnKey="HandleKeyPress"
                                         ToastMessage="@_toastMessage"
                                         ToastTone="_toastTone"
                                         InvalidGuess="_invalidGuess"
                                         HighContrast="HighContrast"
                                         OnToggleContrast="ToggleContrast" />
                }
                break;
            case GamePhase.RoundResults:
                <SpardleRoundResults State="GameState" />
                break;
            case GamePhase.GameOver:
                <SpardleGameOverPhase State="GameState" />
                break;
        }
    </div>
}
