@using KnockBox.Spardle
@using KnockBox.Spardle.Components
@using KnockBox.Spardle.Models
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="spd-obs" @key="@State.CurrentRound">
    <header class="spd-obs-top">
        <div class="spd-obs-round">
            <span class="spd-obs-round-label">ROUND</span>
            <span class="spd-obs-round-value spd-display">@State.CurrentRound</span>
            <span class="spd-obs-round-total">/ @State.RoundQueue.Count</span>
        </div>

        <SpardleRoundTimer State="State" />

        <button type="button"
                class="spd-obs-hc-toggle @(HighContrast ? "spd-obs-hc-on" : "")"
                @onclick="OnToggleContrast"
                title="Toggle high-contrast colours">
            <span class="spd-obs-hc-dot"></span>
            <span>HC</span>
        </button>
    </header>

    @{
        int wordLen = State.TargetWord.Length;
        int maxGuesses = wordLen > 0
            ? SpardleEngine.CalculateMaxGuesses(wordLen, State.DifficultyMultiplier)
            : 6;
        var accents = new[] { "spd-obs-a", "spd-obs-b", "spd-obs-c", "spd-obs-d" };
        int accentIdx = 0;

        var visiblePlayerIds = new HashSet<string>(State.Players.Select(p => p.User.Id));
        var rankedEntries = SpardleOpponentsRanking.ComputeRanked(State)
            .Where(r => visiblePlayerIds.Contains(r.User.Id))
            .ToList();
    }

    <main class="spd-obs-gallery @(HighContrast ? "spd-hc" : "")" style="--spd-cols:@wordLen;">
        @foreach (var entry in rankedEntries)
        {
            var ps = entry.PlayerState;
            var accent = accents[accentIdx++ % accents.Length];

            string statusTag;
            string statusClass;
            if (ps.Dnf) { statusTag = "DNF"; statusClass = "spd-obs-dnf"; }
            else if (ps.HasFinishedRound) { statusTag = FormatSolvedTag(ps, State.RoundStartTime); statusClass = "spd-obs-solved"; }
            else { statusTag = "GUESSING…"; statusClass = "spd-obs-active"; }

            var isSolved = ps.HasFinishedRound && !ps.Dnf;
            var solvedRowIdx = isSolved && ps.Guesses.Count > 0 ? ps.Guesses.Count - 1 : -1;
            var outcomeCls = isSolved ? "spd-obs-card-solved" : ps.Dnf ? "spd-obs-card-dnf" : "";

            <section class="spd-obs-card @accent @outcomeCls"
                     @key="entry.User.Id"
                     data-spd-id="@entry.User.Id">
                <div class="spd-obs-card-top">
                    <span class="spd-obs-avatar">@Initials(entry.DisplayName)</span>
                    <span class="spd-obs-name">@entry.DisplayName</span>
                    <span class="spd-obs-count spd-mono">@ps.Guesses.Count/@maxGuesses</span>
                </div>

                <div class="spd-obs-mini" style="--spd-cols:@wordLen; --spd-rows:@maxGuesses;">
                    @for (int gIdx = 0; gIdx < ps.Guesses.Count; gIdx++)
                    {
                        var guess = ps.Guesses[gIdx];
                        var winnerCls = gIdx == solvedRowIdx ? "spd-obs-row-winner" : "";
                        <div class="spd-obs-row @winnerCls">
                            @for (int i = 0; i < guess.Statuses.Length; i++)
                            {
                                var statusClassName = guess.Statuses[i] switch
                                {
                                    LetterStatus.Correct => "spd-obs-tile-correct",
                                    LetterStatus.Present => "spd-obs-tile-present",
                                    _ => "spd-obs-tile-absent"
                                };
                                <div class="spd-obs-tile @statusClassName"></div>
                            }
                        </div>
                    }
                    @for (int row = ps.Guesses.Count; row < maxGuesses; row++)
                    {
                        <div class="spd-obs-row">
                            @for (int i = 0; i < wordLen; i++)
                            {
                                <div class="spd-obs-tile spd-obs-tile-empty"></div>
                            }
                        </div>
                    }
                </div>

                <div class="spd-obs-status @statusClass">@statusTag</div>
            </section>
        }
    </main>
</div>

@code {
    [Parameter, EditorRequired] public SpardleState State { get; set; } = default!;
    [Parameter] public bool HighContrast { get; set; }
    [Parameter] public EventCallback OnToggleContrast { get; set; }

    private const int FlipDurationMs = 450;
    private const string FlipRootSelector = ".spd-obs-gallery";

    private IJSObjectReference? _flipModule;
    private bool _flipInFlight;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_flipModule is null)
        {
            try
            {
                _flipModule = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/KnockBox.Spardle/js/spardle-host-flip.js");
            }
            catch (JSDisconnectedException) { return; }
            catch (TaskCanceledException) { return; }
        }

        // Skip if a previous reorder is still flushing — overlapping reads on the same
        // root would just race on getBoundingClientRect with no benefit.
        if (_flipInFlight) return;
        _flipInFlight = true;
        try
        {
            await _flipModule.InvokeVoidAsync(
                "reorder",
                FlipRootSelector,
                ".spd-obs-card",
                "data-spd-id",
                FlipDurationMs,
                State.CurrentRound);
        }
        catch (JSDisconnectedException) { /* circuit torn down */ }
        catch (TaskCanceledException) { /* superseded */ }
        finally
        {
            _flipInFlight = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_flipModule is not null)
        {
            try { await _flipModule.InvokeVoidAsync("clear", FlipRootSelector); }
            catch (JSDisconnectedException) { /* circuit torn down */ }
            catch (TaskCanceledException) { /* superseded */ }

            try { await _flipModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit torn down */ }
            catch (TaskCanceledException) { /* superseded */ }
        }
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return char.ToUpperInvariant(parts[0][0]).ToString();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }

    private static string FormatSolvedTag(PlayerState ps, DateTime? roundStart)
    {
        if (roundStart is null || ps.FinishedAt is null) return "SOLVED";
        var elapsed = ps.FinishedAt.Value - roundStart.Value;
        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;
        return $"SOLVED {(int)elapsed.TotalMinutes}:{elapsed.Seconds:D2}";
    }
}
