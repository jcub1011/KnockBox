<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Keep Version, AssemblyVersion, and FileVersion in sync with the sibling
      KnockBox.WordService.Contracts csproj — the loader groups libraries by
      (entryAssembly, Major, Minor) and the contracts' AssemblyName.Version is
      the dedup key for contract promotion.
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Shared word-existence and dictionary lookup library plugin for word games.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Data\*.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sdk\KnockBox.Core\KnockBox.Core.csproj" />
    <ProjectReference Include="..\KnockBox.WordService.Contracts\KnockBox.WordService.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnockBox.WordServiceTests" />
  </ItemGroup>

  <!--
    Declare the contracts DLL so Directory.Library.targets stages it alongside
    the library plugin under libraries/KnockBox.WordService/. PluginLoader's
    contract-promotion pass reads it from that path at host startup and loads
    it into the default ALC, making the interface types visible to every
    consumer plugin's ALC with a single CLR type identity.
  -->
  <ItemGroup>
    <PluginExportedContract Include="$(TargetDir)KnockBox.WordService.Contracts.dll" />
  </ItemGroup>

  <Import Project="..\Directory.Library.targets" />

</Project>
