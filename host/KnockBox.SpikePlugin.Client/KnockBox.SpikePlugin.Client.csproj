<!--
  KnockBox.SpikePlugin.Client — the out-of-build-graph UI assembly for the
  Phase 0 trimming spike (kill-criterion #1).

  CRITICAL: this project is intentionally NOT referenced by KnockBox.Client.
  That is what makes the closed-world trimming test honest — the trimmed WASM
  client has never seen this assembly's types. It is staged as raw bytes into the
  HiddenAgenda plugin's client/ folder and streamed to the browser at runtime via
  AssemblyLoadContext.Default.LoadFromStream.

  It deliberately does NOT import Directory.Plugin.targets (it is not a server
  game plugin: no plugin.json, no sandbox analyzer, no games/{self}/ staging).
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Suppress the RCL static-web-assets pipeline noise; we only need the DLL. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shares CLR type identity with the client + server via the one Core.Client
         assembly (mirrors the server's contract-promotion discipline). -->
    <ProjectReference Include="..\..\sdk\KnockBox.Core.Client\KnockBox.Core.Client.csproj" />
  </ItemGroup>

  <!--
    Stage just the DLL into the HiddenAgenda plugin's client/ folder under the
    host bin, so the host's /_plugins/hidden-agenda/client/* endpoint can serve
    it. The destination subfolder is created if absent; this is independent of
    HiddenAgenda's own games/ staging.
  -->
  <Target Name="StageClientPluginAssembly" AfterTargets="Build">
    <PropertyGroup>
      <ClientDestDir>$(MSBuildThisFileDirectory)..\KnockBox\bin\$(Configuration)\$(TargetFramework)\games\KnockBox.HiddenAgenda\client\</ClientDestDir>
    </PropertyGroup>
    <Message Text="Staging spike client UI [$(TargetName).dll] into [$(ClientDestDir)]" Importance="high" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$(ClientDestDir)" />
  </Target>

</Project>
