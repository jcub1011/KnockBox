@* The phase countdown bar. Reads the projected absolute deadline (PhaseEndsAtUtc) + the phase's
   total span (PhaseDurationSeconds) and renders the shared CountdownClock, which counts down
   locally from the deadline — the server stays authoritative on expiry (it advances the FSM on its
   own timer and re-projects). An untimed phase (no deadline) shows the unlimited badge. *@

@if (View.PhaseEndsAtUtc is { } expires && View.PhaseDurationSeconds > 0)
{
    <CountdownClock EndTimeUtc="expires" Duration="TimeSpan.FromSeconds(View.PhaseDurationSeconds)" Context="countdown">
        @{
            int totalSec = (int)Math.Ceiling(countdown.RemainingSeconds);
            int mins = totalSec / 60;
            int secs = totalSec % 60;
            float pct = Math.Clamp(countdown.Fraction, 0f, 1f);
            bool urgent = countdown.RemainingSeconds < 10;
        }
        <div class="tr-timer @(urgent ? "tr-timer-urgent" : "")">
            <div class="tr-timer-bar">
                <div class="tr-timer-fill" style="width: @(pct * 100)%;"></div>
            </div>
            <div class="tr-timer-digits">
                <span class="tr-timer-icon">⏱</span>
                <span class="tr-timer-value">@mins:@secs.ToString("D2")</span>
            </div>
        </div>
    </CountdownClock>
}
else
{
    <div class="tr-timer tr-timer-unlimited">
        <span class="tr-timer-icon">∞</span>
        <span class="tr-timer-label">UNLIMITED</span>
    </div>
}

@code {
    [Parameter, EditorRequired] public TraceryView View { get; set; } = default!;
}
