@*
    Host shared-display dashboard. Ported from the server SpectatorView. Standings use the
    server-assigned OperatorPlayerView.LiveRank (closest-to-zero, ScoreTimestamp tiebreak),
    so the board matches the authoritative ranking. The activity log shows each line's
    server timestamp as a relative "Ns ago" stamp.
*@

@{
    var sortedPlayers = View.Players
        .OrderBy(p => p.LiveRank)
        .ToList();

    var currentPlayer = View.Players.FirstOrDefault(p => p.UserId == View.CurrentPlayerId);
    var currentPlayerName = currentPlayer?.DisplayName ?? "...";

    var deckTotal = View.DeckCount + View.DiscardPile.Count;
    var deckPercent = deckTotal > 0 ? (int)(100.0 * View.DeckCount / deckTotal) : 0;
    var deckLow = deckPercent < 25;

    var recentLogs = View.ActionLog.Reverse().Take(8).ToList();
}

<div class="op-spectator">
    @* ── Top Bar ── *@
    <div class="op-spectator-top-bar">
        <div class="op-spectator-top-left">
            <div class="op-spectator-phase-badge">
                @GetPhaseIcon() @GetPhaseName()
            </div>
            <div class="op-spectator-turn-counter">
                TURN @View.TurnCount
            </div>
        </div>

        <div class="op-spectator-deck @(deckLow ? "deck-low" : "")">
            <div class="op-spectator-deck-stack">
                <div class="op-spectator-card-back cb-3"></div>
                <div class="op-spectator-card-back cb-2"></div>
                <div class="op-spectator-card-back cb-1"></div>
            </div>
            <div class="op-spectator-deck-info">
                <span class="op-spectator-deck-count">@View.DeckCount</span>
                <div class="op-spectator-deck-bar">
                    <div class="op-spectator-deck-bar-fill" style="width: @(deckPercent)%"></div>
                </div>
            </div>
        </div>
    </div>

    @* ── Two-Column Body ── *@
    <div class="op-spectator-body">
        @* ── Left Column: Spotlight ── *@
        <div class="op-spectator-left">
            <div class="op-spectator-spotlight @(currentPlayer?.IsAudited == true ? "holo-effect" : "")">
                <div class="op-spotlight-header">
                    <span class="op-spotlight-name">@currentPlayerName</span>
                    <span class="op-spotlight-label">'S TURN</span>
                </div>

                @if (currentPlayer != null)
                {
                    <div class="op-spotlight-stats">
                        <div class="op-spotlight-stat">
                            <span class="op-spotlight-stat-value">@currentPlayer.CurrentPoints.ToString("F1")</span>
                            <span class="op-spotlight-stat-label">SCORE</span>
                        </div>
                        <div class="op-spotlight-stat">
                            <span class="op-spotlight-stat-value op-spotlight-operator">@currentPlayer.ActiveOperator.ToSymbol()</span>
                            <span class="op-spotlight-stat-label">OPERATOR</span>
                        </div>
                        <div class="op-spotlight-stat">
                            <span class="op-spotlight-stat-value">@currentPlayer.HandCount</span>
                            <span class="op-spotlight-stat-label">CARDS</span>
                        </div>
                    </div>

                    @if (currentPlayer.HandCount > 0)
                    {
                        <div class="op-spotlight-hand">
                            @for (int i = 0; i < currentPlayer.HandCount; i++)
                            {
                                <div class="op-spotlight-card-back" style="--ci: @i"></div>
                            }
                        </div>
                    }

                    @if (currentPlayer.IsAudited)
                    {
                        <span class="op-spotlight-audit-badge">AUDITED</span>
                    }
                }
            </div>

            @* ── Last Action ── *@
            @if (!string.IsNullOrEmpty(View.LastBlockedActionMessage))
            {
                <div class="op-spectator-last-action blocked">
                    <span class="op-last-action-badge blocked-badge">BLOCKED</span>
                    <span class="op-last-action-text">@View.LastBlockedActionMessage</span>
                </div>
            }
            else if (View.ActionLog.Count > 0)
            {
                <div class="op-spectator-last-action">
                    <span class="op-last-action-text">@View.ActionLog[^1].Message</span>
                </div>
            }
        </div>

        @* ── Right Column: Leaderboard + Log ── *@
        <div class="op-spectator-right">
            @* ── Leaderboard ── *@
            <div class="op-spectator-leaderboard">
                <h2 class="op-spectator-title">LIVE STANDINGS</h2>
                <div class="op-spectator-entries">
                    @for (int i = 0; i < sortedPlayers.Count; i++)
                    {
                        var entry = sortedPlayers[i];
                        var isCurrentTurn = entry.UserId == View.CurrentPlayerId;
                        var isReactionTarget = View.Phase == OperatorGamePhase.Reaction && entry.IsReactionTarget;

                        <div class="op-spectator-entry @(isCurrentTurn ? "active-turn" : "") @(isReactionTarget ? "targeted" : "")">
                            <span class="op-spectator-rank">#@entry.LiveRank</span>
                            <div class="op-spectator-player-info">
                                <span class="op-spectator-player-name">
                                    @if (isReactionTarget) { <span class="op-target-icon"></span> }
                                    @entry.DisplayName
                                </span>
                                <div class="op-spectator-player-details">
                                    <span class="op-spectator-operator">@entry.ActiveOperator.ToSymbol()</span>
                                    <span class="op-spectator-score">@entry.CurrentPoints.ToString("F1")</span>
                                    <span class="op-spectator-hand-count">@entry.HandCount cards</span>
                                    @if (entry.IsAudited)
                                    {
                                        <span class="op-spectator-badge">AUDITED</span>
                                    }
                                </div>
                            </div>
                            @if (isCurrentTurn)
                            {
                                <span class="op-spectator-turn-badge">TURN</span>
                            }
                            @if (isReactionTarget)
                            {
                                <span class="op-spectator-target-badge">TARGETED</span>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ── Activity Log ── *@
            @if (recentLogs.Count > 0)
            {
                <div class="op-spectator-activity-log">
                    <h2 class="op-spectator-title">ACTIVITY LOG</h2>
                    <div class="op-spectator-log-entries">
                        @foreach (var log in recentLogs)
                        {
                            var logClass = log.TargetId != null ? "log-attack" : "log-default";

                            <div class="op-spectator-log-entry @logClass">
                                <span class="op-log-dot"></span>
                                <span class="op-log-message">@log.Message</span>
                                <span class="op-log-time">@OperatorTime.Relative(log.Timestamp)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public OperatorView View { get; set; } = default!;

    private string GetPhaseIcon() => View.Phase switch
    {
        OperatorGamePhase.Play => "🎯",
        OperatorGamePhase.Reaction => "⚡",
        OperatorGamePhase.Draw => "🃏",
        _ => "🧮"
    };

    private string GetPhaseName() => View.Phase switch
    {
        OperatorGamePhase.Play => "PLAY PHASE",
        OperatorGamePhase.Reaction => "REACTION PHASE",
        OperatorGamePhase.Draw => "DRAW PHASE",
        _ => View.Phase.ToString().ToUpper()
    };
}
