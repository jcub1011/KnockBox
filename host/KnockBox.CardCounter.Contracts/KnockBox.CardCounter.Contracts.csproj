<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared contract DTOs for the KnockBox.CardCounter tri-split game: the pure data
    types both runtimes need (cards, enums, settings, notification POCOs), the commands
    the browser UI sends, and the per-player view the server projects back. This
    assembly loads in BOTH runtimes — compiled against by the server plugin AND
    streamed to the browser alongside the client UI — so both sides bind the same
    CLR types.

    CRITICAL: this project has ZERO KnockBox.* references and imports no plugin
    targets (mirrors KnockBox.DiceSimulator.Contracts / KnockBox.WordService.Contracts).
    It is pure DTOs/enums only. Source-generated JSON keeps the DTOs trim-safe in the
    WASM client.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Shared contract DTOs for the KnockBox.CardCounter tri-split game.</Description>
  </PropertyGroup>

</Project>
