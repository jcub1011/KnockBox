@*
    Voting phase — each living player designates a target for termination. Host spectator sees
    a live designation tracker; players pick a target and confirm.
*@

@{
    bool isHostSpectator = View.RecipientId == View.HostId && !View.HostIsParticipant;
    int aliveCount = View.Players.Count(p => !p.IsEliminated);
    int votedCount = View.Players.Count(p => !p.IsEliminated && p.HasVoted);
    var me = View.Players.FirstOrDefault(p => p.PlayerId == View.RecipientId);
}

@if (isHostSpectator)
{
    @* ══════ HOST SPECTATOR VIEW ══════ *@
    <div class="ctc-vote-area">
        <div class="ctc-vote-panel ctc-host-panel">
            <h2 class="ctc-phase-title glitch" data-text="[ FINAL DESIGNATION ]">[ FINAL DESIGNATION ]</h2>

            @{
                var barWidth = 20;
                var filled = aliveCount > 0 ? (int)Math.Ceiling((double)votedCount / aliveCount * barWidth) : 0;
                var bar = new string('█', filled) + new string('░', barWidth - filled);
            }
            <div class="ctc-host-vote-progress">
                <span class="ctc-host-vote-bar">[@bar]</span>
                <span class="ctc-host-vote-count">@votedCount / @aliveCount VOTES LOGGED</span>
            </div>

            <div class="ctc-host-vote-tracker">
                <h3 class="ctc-section-title">[ LIVE DESIGNATION TRACKER ]</h3>
                <div class="ctc-vote-tracker-grid">
                    @foreach (var target in View.Players.Where(p => !p.IsEliminated).OrderBy(p => p.DisplayName))
                    {
                        var votes = View.Players.Count(p => !p.IsEliminated && p.HasVoted && p.VoteTargetId == target.PlayerId);
                        var maxVotes = aliveCount - 1;
                        var tFilled = maxVotes > 0 ? votes : 0;
                        var tEmpty = maxVotes > 0 ? maxVotes - votes : 0;
                        <div class="ctc-vote-tracker-row @(votes > 0 ? "ctc-vote-tracker-targeted" : "")">
                            <span class="ctc-vote-tracker-name">@target.DisplayName</span>
                            <span class="ctc-vote-tracker-bar">@(new string('█', tFilled))@(new string('░', tEmpty))</span>
                            <span class="ctc-vote-tracker-count">@votes</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ══════ PLAYER VIEW ══════ *@
    <div class="ctc-vote-area">
        @{
            bool hasVoted = me is { HasVoted: true };
        }

        <div class="ctc-vote-panel">
            <h2 class="ctc-phase-title glitch" data-text="[ FINAL DESIGNATION ]">[ FINAL DESIGNATION ]</h2>

            <div class="ctc-vote-progress-bar">@votedCount / @aliveCount votes logged</div>

            @if (hasVoted)
            {
                <div class="ctc-vote-waiting">
                    <span class="ctc-lock-icon">[ LOCKED ]</span>
                    <p class="ctc-waiting-text">Designation confirmed. Awaiting others...</p>
                </div>
            }
            else if (me is { IsEliminated: false })
            {
                <div class="ctc-vote-grid">
                    @foreach (var target in View.Players.Where(p => !p.IsEliminated && p.PlayerId != View.RecipientId))
                    {
                        bool isSelected = _selectedTargetId == target.PlayerId;
                        <button class="ctc-vote-target @(isSelected ? "ctc-vote-target-selected" : "")"
                                @onclick="() => SelectTarget(target.PlayerId)">
                            <span class="ctc-vote-target-name">@target.DisplayName</span>
                        </button>
                    }
                </div>

                @if (_selectedTargetId is { } sel)
                {
                    var targetName = View.Players.FirstOrDefault(p => p.PlayerId == sel)?.DisplayName ?? "...";
                    <div class="ctc-vote-confirm">
                        <p>Designate <strong>@targetName</strong> for termination?</p>
                        <button class="ctc-btn ctc-btn-danger" @onclick="ConfirmVote">[ CONFIRM TERMINATION ]</button>
                        <button class="ctc-btn ctc-btn-secondary" @onclick="CancelSelection">[ ABORT ]</button>
                    </div>
                }
            }
            else
            {
                <p class="ctc-waiting-text">You have been terminated and cannot log a designation.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public CodewordView View { get; set; } = default!;
    [Parameter] public Func<string, string?, Task<string?>> Submit { get; set; } = default!;
    [Parameter] public EventCallback<string> OnError { get; set; }

    private Guid? _selectedTargetId;

    private void SelectTarget(Guid targetId) => _selectedTargetId = targetId;

    private void CancelSelection() => _selectedTargetId = null;

    private async Task ConfirmVote()
    {
        if (_selectedTargetId is not { } target) return;
        var err = await Submit(CodewordCommands.CastVote,
            JsonSerializer.Serialize(new VotePayload(target), CodewordContractsJsonContext.Default.VotePayload));
        if (err is not null)
        {
            await OnError.InvokeAsync("You cannot vote for that player.");
            _selectedTargetId = null;
        }
    }
}
