@using KnockBox.Core.Services.State.Users
@using KnockBox.CardCounter.Services.State.Games

<div class="cc-lobby">
    @if (UserService.CurrentUser?.Id == GameState.Host.Id)
    {
        <button class="cc-settings-gear-btn" @onclick="ToggleSettings" title="House Rules">
            🎰
        </button>
    }

    <div class="cc-lobby-table-container">
        <div class="cc-lobby-table">
            <h2 class="cc-lobby-title">♠ WAITING FOR PLAYERS ♥</h2>
            <div class="cc-lobby-players">
                @{
                    bool isUserHost = GameState.Host.Id == UserService.CurrentUser?.Id;
                }

                @foreach (var entry in GameState.RosterIncludingHost)
                {
                    bool isHost = entry.User.Id == GameState.Host.Id;
                    bool isMe = entry.User.Id == UserService.CurrentUser?.Id;
                    @if (isHost)
                    {
                        <div class="cc-lobby-player @(isMe ? "cc-lobby-player-me" : "")">
                            <span class="cc-player-avatar">👑</span>
                            <span class="cc-player-lobbyname">@entry.DisplayName</span>
                            <span class="cc-host-badge">HOST</span>
                        </div>
                    }
                    else if (isUserHost)
                    {
                        <button class="cc-lobby-player @(isMe ? "cc-lobby-player-me" : "")"
                                @onclick="() => KickPlayer(entry.User.Id)" title="Click to kick player">
                            <span class="cc-player-avatar">🃏</span>
                            <span class="cc-player-lobbyname">@entry.DisplayName</span>
                        </button>
                    }
                    else
                    {
                        <div class="cc-lobby-player @(isMe ? "cc-lobby-player-me" : "")">
                            <span class="cc-player-avatar">🃏</span>
                            <span class="cc-player-lobbyname">@entry.DisplayName</span>
                        </div>
                    }
                }
            </div>
            @if (UserService.CurrentUser?.Id == GameState.Host.Id)
            {
                bool canStart = GameState.Players.Length > 0;
                <button class="cc-btn cc-btn-primary cc-btn-lg" @onclick="StartGame" disabled="@(!canStart)"
                        title="@(!canStart ? "Need at least 1 more player to start" : "Deal cards and start the game")">
                    🃏 DEAL CARDS
                </button>
                @if (!canStart)
                {
                    <p class="cc-lobby-min-players">⚠️ Need at least 1 more player to start</p>
                }
            }
            else
            {
                <p class="cc-waiting-text">Waiting for host to start...</p>
            }
        </div>
    </div>

    @if (UserService.CurrentUser?.Id == GameState.Host.Id)
    {
        @if (SettingsOpen)
        {
            <div class="cc-settings-backdrop" @onclick="ToggleSettings"></div>
        }
        <div class="cc-settings-drawer @(SettingsOpen ? "cc-settings-drawer-open" : "")">
            <div class="cc-settings-drawer-header">
                <h3 class="cc-config-title">🎰 House Rules</h3>
                <button class="cc-settings-close-btn" @onclick="ToggleSettings" title="Close settings">✕</button>
            </div>
            <div class="cc-settings-drawer-body">

                <h4 class="cc-config-section-title">🃏 Deck &amp; Cards</h4>
                <div class="cc-config-grid">
                    <label class="cc-config-label">
                        Deck Size:
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.DeckSize" @bind:set="SetDeckSize" />
                    </label>
                    <label class="cc-config-label">
                        Number to Operator Ratio:
                        <input type="number" step="0.1" class="cc-config-input" @bind:get="GameState.Settings.NumberToOperatorRatio" @bind:set="SetNumberToOperatorRatio" />
                    </label>
                    <label class="cc-config-label">
                        Add/Sub to Mul/Div Ratio:
                        <input type="number" step="0.1" class="cc-config-input" @bind:get="GameState.Settings.AddSubToMulDivRatio" @bind:set="SetAddSubToMulDivRatio" />
                    </label>
                    <label class="cc-config-label">
                        Min Shoe Size:
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.MinShoeSize" @bind:set="SetMinShoeSize" />
                    </label>
                    <label class="cc-config-label">
                        Max Shoe Size:
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.MaxShoeSize" @bind:set="SetMaxShoeSize" />
                    </label>
                </div>

                <h4 class="cc-config-section-title">🎮 Gameplay</h4>
                <div class="cc-config-grid">
                    <label class="cc-config-label">
                        Actions Dealt Per Round:
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.ActionsDealtPerRound" @bind:set="SetActionsDealtPerRound" />
                    </label>
                    <label class="cc-config-label">
                        Action Hand Limit:
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.ActionHandLimit" @bind:set="SetActionHandLimit" />
                    </label>
                    <label class="cc-config-label">
                        Passes Per Player:
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.TotalPassesPerPlayer" @bind:set="SetTotalPassesPerPlayer" />
                    </label>
                    <label class="cc-config-label cc-config-label-row" title="Highest absolute score wins rather than closest to 0">
                        <span>Flip Win Condition:</span>
                        <input type="checkbox" class="cc-config-checkbox" @bind:get="GameState.Settings.FlipWinCondition" @bind:set="SetFlipWinCondition" />
                    </label>
                    <label class="cc-config-label cc-config-label-row" title="Show the operator used by the Not My Money card">
                        <span>Show NMM Operator:</span>
                        <input type="checkbox" class="cc-config-checkbox" @bind:get="GameState.Settings.ShowMakeMyMoneyOperator" @bind:set="SetShowMakeMyMoneyOperator" />
                    </label>
                    <label class="cc-config-label cc-config-label-row" title="Number cards apply directly to balance using a player's active operator instead of building a pot">
                        <span>Active Operator Mode:</span>
                        <input type="checkbox" class="cc-config-checkbox" @bind:get="GameState.Settings.ActiveOperatorMode" @bind:set="SetActiveOperatorMode" />
                    </label>
                </div>

                <h4 class="cc-config-section-title">⏱️ Timers</h4>
                <div class="cc-config-grid">
                    <label class="cc-config-label cc-config-label-row">
                        <span>Enable Action Timer:</span>
                        <input type="checkbox" class="cc-config-checkbox" @bind:get="GameState.Settings.EnableActionTimer" @bind:set="SetEnableActionTimer" />
                    </label>
                    <label class="cc-config-label">
                        Player Turn Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.PlayerTurnTimeoutMs" @bind:set="SetPlayerTurnTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Buy-in Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.BuyInTimeoutMs" @bind:set="SetBuyInTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Round End Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.RoundEndTimeoutMs" @bind:set="SetRoundEndTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Reaction Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.WaitingForReactionTimeoutMs" @bind:set="SetWaitingForReactionTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Feeling Lucky Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.FeelingLuckyChainTimeoutMs" @bind:set="SetFeelingLuckyChainTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Make My Luck Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.MakeMyLuckTimeoutMs" @bind:set="SetMakeMyLuckTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Not My Money Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.NotMyMoneyTimeoutMs" @bind:set="SetNotMyMoneyTimeoutMs" />
                    </label>
                    <label class="cc-config-label">
                        Skim Timeout (ms):
                        <input type="number" class="cc-config-input" @bind:get="GameState.Settings.SkimTimeoutMs" @bind:set="SetSkimTimeoutMs" />
                    </label>
                </div>

                <h4 class="cc-config-section-title">🎴 Action Card Rarities</h4>
                <div class="cc-config-grid">
                    <label class="cc-config-label">
                        Feeling Lucky Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.FeelingLuckyWeight" @bind:set="SetFeelingLuckyWeight" />
                    </label>
                    <label class="cc-config-label">
                        Make My Luck Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.MakeMyLuckWeight" @bind:set="SetMakeMyLuckWeight" />
                    </label>
                    <label class="cc-config-label">
                        Skim Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.SkimWeight" @bind:set="SetSkimWeight" />
                    </label>
                    <label class="cc-config-label">
                        Burn Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.BurnWeight" @bind:set="SetBurnWeight" />
                    </label>
                    <label class="cc-config-label">
                        Turn The Table Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.TurnTheTableWeight" @bind:set="SetTurnTheTableWeight" />
                    </label>
                    <label class="cc-config-label">
                        Comp'd Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.CompdWeight" @bind:set="SetCompdWeight" />
                    </label>
                    <label class="cc-config-label">
                        Not My Money Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.NotMyMoneyWeight" @bind:set="SetNotMyMoneyWeight" />
                    </label>
                    <label class="cc-config-label">
                        Launder Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.LaunderWeight" @bind:set="SetLaunderWeight" />
                    </label>
                    <label class="cc-config-label">
                        Tilt Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.TiltWeight" @bind:set="SetTiltWeight" />
                    </label>
                    <label class="cc-config-label">
                        Hedge Your Bet Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.HedgeYourBetWeight" @bind:set="SetHedgeYourBetWeight" />
                    </label>
                    <label class="cc-config-label">
                        Let It Ride Weight:
                        <input type="number" min="0" class="cc-config-input" @bind:get="GameState.Settings.LetItRideWeight" @bind:set="SetLetItRideWeight" />
                    </label>
                </div>

            </div>
        </div>
    }
</div>

